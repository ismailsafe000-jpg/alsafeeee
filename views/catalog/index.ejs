<!DOCTYPE html>
<html lang="ar-u-nu-latn" dir="rtl" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= settings.storeName %> — كتالوجات المعرض</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --gold: #d4af37; --dark: #0f172a;
      --bg: #f0f4f8; --card: #fff;
      --text: #1e293b; --muted: #64748b;
      --border: #e2e8f0;
    }
    [data-theme="dark"] {
      --bg: #0d1117; --card: #161b22;
      --text: #e6edf3; --muted: #8b949e; --border: #30363d;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Cairo', sans-serif; background: var(--bg); color: var(--text); transition: background 0.3s, color 0.3s; }

    .topbar {
      background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%);
      padding: 14px 20px;
      display: flex; align-items: center; justify-content: space-between;
      box-shadow: 0 3px 20px rgba(0,0,0,0.3);
      flex-wrap: wrap; gap: 10px;
    }
    .brand { color: var(--gold); font-weight: 800; font-size: 18px; display: flex; align-items: center; gap: 8px; text-decoration: none; }
    .topbar-actions { display: flex; gap: 8px; align-items: center; }
    .btn-icon {
      background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
      color: #cbd5e1; padding: 8px 12px; border-radius: 8px; cursor: pointer;
      font-size: 15px; text-decoration: none; display: flex; align-items: center; gap: 5px;
      font-family: 'Cairo', sans-serif; font-size: 13px; transition: 0.2s;
    }
    .btn-icon:hover { background: rgba(212,175,55,0.15); color: var(--gold); }

    .hero {
      background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 60%, #0f172a 100%);
      padding: 60px 20px 50px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(circle at 50% 50%, rgba(212,175,55,0.08) 0%, transparent 70%);
    }
    .hero-logo { height: 70px; border-radius: 12px; margin-bottom: 16px; }
    .hero h1 { color: var(--gold); font-size: clamp(24px, 5vw, 40px); font-weight: 800; margin: 0 0 8px; }
    .hero p { color: #94a3b8; font-size: 15px; margin: 0; }
    .hero-divider {
      width: 80px; height: 3px; margin: 16px auto 0;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }

    .page-wrap { max-width: 1100px; margin: 0 auto; padding: 40px 16px 60px; }
    .section-lbl {
      font-size: 20px; font-weight: 800; color: var(--text);
      margin-bottom: 24px; display: flex; align-items: center; gap: 10px;
    }
    .section-lbl::after {
      content: ''; flex: 1; height: 2px;
      background: linear-gradient(90deg, var(--gold), transparent);
    }

    .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }

    .cat-card {
      background: var(--card);
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: 0 4px 24px rgba(0,0,0,0.07);
      transition: transform 0.25s, box-shadow 0.25s;
      cursor: pointer;
      text-decoration: none;
      display: block;
      color: inherit;
    }
    .cat-card:hover { transform: translateY(-6px); box-shadow: 0 12px 40px rgba(0,0,0,0.15); color: inherit; }

    .cat-thumb-wrap {
      position: relative;
      height: 200px;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      overflow: hidden;
    }
    .cat-thumb { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
    .cat-card:hover .cat-thumb { transform: scale(1.06); }
    .cat-thumb-placeholder {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
    }
    .cat-count-badge {
      position: absolute; bottom: 10px; right: 10px;
      background: rgba(0,0,0,0.65); color: white;
      font-size: 12px; padding: 4px 12px; border-radius: 20px;
      backdrop-filter: blur(4px); display: flex; align-items: center; gap: 5px;
    }
    .cat-arrow {
      position: absolute; bottom: 10px; left: 10px;
      background: var(--gold); color: #0f172a;
      width: 32px; height: 32px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; transition: transform 0.2s;
    }
    .cat-card:hover .cat-arrow { transform: scale(1.15); }

    .cat-body { padding: 18px 16px 16px; }
    .cat-title { font-size: 17px; font-weight: 800; margin: 0 0 6px; color: var(--text); }
    .cat-desc { font-size: 13px; color: var(--muted); margin: 0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }

    .empty-state {
      text-align: center; padding: 80px 20px;
      background: var(--card); border-radius: 18px;
      border: 1px solid var(--border);
    }
    .empty-state i { color: rgba(212,175,55,0.3); margin-bottom: 16px; }

    footer {
      text-align: center; padding: 24px;
      color: var(--muted); font-size: 13px;
      border-top: 1px solid var(--border);
    }
    footer a { color: var(--gold); text-decoration: none; }

    @media (max-width: 576px) {
      .cat-grid { grid-template-columns: 1fr; }
      .hero { padding: 40px 16px 30px; }
    }
  </style>
  <script>
    (function() {
      const t = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
    function toggleTheme() {
      const c = document.documentElement.getAttribute('data-theme') || 'light';
      const n = c === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', n);
      localStorage.setItem('theme', n);
      const ic = document.getElementById('themeIc');
      if (ic) ic.className = n === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
    }
  </script>
</head>
<body>

  <nav class="topbar">
    <a href="/" class="brand">
      <i class="fa-solid fa-couch"></i>
      <%= settings.storeName %>
    </a>
    <div class="topbar-actions">
      <button class="btn-icon" onclick="toggleTheme()">
        <i class="fa-solid fa-moon" id="themeIc"></i>
      </button>
      <a href="/" class="btn-icon">
        <i class="fa-solid fa-house"></i> الرئيسية
      </a>
    </div>
  </nav>

  <div class="hero">
    <% if (settings.storeLogo) { %>
      <img src="<%= settings.storeLogo %>" class="hero-logo" alt="شعار المتجر">
    <% } %>
    <h1><i class="fa-solid fa-book-open me-2"></i>كتالوجات المعرض</h1>
    <p>تصفّح مجموعاتنا المميزة من الأثاث الفاخر</p>
    <div class="hero-divider"></div>
  </div>

  <div class="page-wrap">

    <% if (catalogs.length === 0) { %>
      <div class="empty-state">
        <i class="fa-solid fa-book-open fa-4x d-block mb-3"></i>
        <h5>لا توجد كتالوجات متاحة حالياً</h5>
        <p class="text-muted">سيتم إضافة الكتالوجات قريباً — تابعونا</p>
      </div>
    <% } else { %>
      <div class="section-lbl">
        <i class="fa-solid fa-layer-group" style="color: var(--gold);"></i>
        جميع الكتالوجات
      </div>
      <div class="cat-grid">
        <% catalogs.forEach(cat => { %>
          <a href="/catalog/<%= cat._id %>" class="cat-card">
            <div class="cat-thumb-wrap">
              <% if (cat.cover) { %>
                <img src="<%= cat.cover %>" class="cat-thumb" alt="<%= cat.name %>">
              <% } else if (cat.images.length > 0) { %>
                <img src="<%= cat.images[0].url %>" class="cat-thumb" alt="<%= cat.name %>">
              <% } else { %>
                <div class="cat-thumb-placeholder">
                  <i class="fa-solid fa-book-open fa-3x" style="color: rgba(212,175,55,0.3);"></i>
                </div>
              <% } %>
              <div class="cat-count-badge">
                <i class="fa-solid fa-images"></i> <%= cat.images.length %> صورة
              </div>
              <div class="cat-arrow">
                <i class="fa-solid fa-arrow-left"></i>
              </div>
            </div>
            <div class="cat-body">
              <h3 class="cat-title"><%= cat.name %></h3>
              <% if (cat.description) { %>
                <p class="cat-desc"><%= cat.description %></p>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <footer>
    <p>
      <i class="fa-solid fa-couch me-1" style="color: var(--gold);"></i>
      <%= settings.storeName %>
      <% if (settings.storePhone) { %> &nbsp;|&nbsp; <i class="fa-solid fa-phone"></i> <%= settings.storePhone %><% } %>
    </p>
    <% if (settings.storeWhatsapp) { %>
      <a href="https://wa.me/<%= settings.storeWhatsapp.replace(/\D/g,'') %>" target="_blank" style="color:#25d366;">
        <i class="fab fa-whatsapp"></i> تواصل معنا على واتساب
      </a>
    <% } %>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
/* 25002500 062a062d0648064a0644 0627064406230631064206270645 06270644063906310628064a0629 064406440627062a064a0646064a0629 25002500 */
(function(){
  function fix(n){if(n.nodeType===3){n.nodeValue=n.nodeValue.replace(/[0660-0669]/g,function(d){return d.charCodeAt(0)-0x0660;});}else{n.childNodes.forEach(fix);}}
  document.addEventListener('DOMContentLoaded',function(){fix(document.body);});
})();
</script>
</body>
</html>
