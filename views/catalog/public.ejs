<!DOCTYPE html>
<html lang="ar-u-nu-latn" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= settings.storeName %> - الكتالوج</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <style>
    body { font-family: 'Segoe UI', Tahoma, sans-serif; background: #f8f9fa; }
    .product-card { border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,.1); overflow: hidden; transition: transform 0.2s; }
    .product-card:hover { transform: translateY(-4px); }
    .price { color: #28a745; font-weight: bold; font-size: 1.2rem; }
    .whatsapp-btn {
      background: #25d366; color: #fff; border: none;
      padding: 10px 20px; border-radius: 8px; text-decoration: none;
      display: inline-block; margin-top: 10px; font-weight: 600;
      transition: background 0.2s;
    }
    .whatsapp-btn:hover { background: #128c7e; color: #fff; }
    .store-header { background: linear-gradient(135deg, #0f172a, #1e293b); color: white; padding: 30px 0; margin-bottom: 30px; }
    .store-header h2 { color: #d4af37; font-weight: 800; }
  </style>
</head>
<body>
  <div class="store-header text-center">
    <% if (settings.storeLogo) { %>
      <img src="<%= settings.storeLogo %>" height="70" class="mb-3" style="border-radius:10px;">
    <% } %>
    <h2><%= settings.storeName %></h2>
    <% if (settings.storeAddress) { %>
      <p class="text-muted mb-0"><i class="fa-solid fa-location-dot me-1"></i><%= settings.storeAddress %></p>
    <% } %>
  </div>

  <div class="container pb-5">
    <div class="row">
      <% products.forEach(p => { %>
        <div class="col-md-4 col-sm-6 mb-4">
          <div class="card product-card h-100">
            <img src="<%= p.image %>" class="card-img-top" style="height:250px;object-fit:cover;">
            <div class="card-body d-flex flex-column">
              <h5 class="card-title fw-bold"><%= p.title %></h5>
              <p class="text-muted flex-grow-1"><%= p.description %></p>
              <% if (settings.catalogPricesMode) { %>
                <p class="price"><%= p.price %> ₪</p>
              <% } else { %>
                <p class="text-danger fw-bold fs-5">للاستفسار عن السعر</p>
              <% } %>
              <a href="https://wa.me/<%= settings.storeWhatsapp ? settings.storeWhatsapp.replace(/\D/g,'') : '' %>?text=<%= encodeURIComponent('السلام عليكم، أود الاستفسار عن المنتج: ' + p.title) %>"
                 target="_blank" class="whatsapp-btn text-center">
                <i class="fab fa-whatsapp me-1"></i> استفسار عبر واتساب
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
<script>
/* 25002500 062a062d0648064a0644 0627064406230631064206270645 06270644063906310628064a0629 064406440627062a064a0646064a0629 25002500 */
(function(){
  function fix(n){if(n.nodeType===3){n.nodeValue=n.nodeValue.replace(/[0660-0669]/g,function(d){return d.charCodeAt(0)-0x0660;});}else{n.childNodes.forEach(fix);}}
  document.addEventListener('DOMContentLoaded',function(){fix(document.body);});
})();
</script>
</body>
</html>
