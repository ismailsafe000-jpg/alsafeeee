<!DOCTYPE html>
<html lang="ar-u-nu-latn" dir="rtl" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>كشف حساب تاجر | <%= settings.storeName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{--gold:#d4af37;--bg:#f0f4f8;--card:#fff;--text:#1e293b;--muted:#64748b;--border:#e2e8f0;}
    [data-theme="dark"]{--bg:#0d1117;--card:#161b22;--text:#e6edf3;--muted:#8b949e;--border:#30363d;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{font-family:'Cairo',sans-serif;background:var(--bg);color:var(--text);transition:background .3s,color .3s;}
    .topbar{background:linear-gradient(135deg,#0f172a,#1e3a5f);padding:12px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;box-shadow:0 3px 20px rgba(0,0,0,.3);}
    .brand{color:var(--gold);font-weight:800;font-size:17px;display:flex;align-items:center;gap:8px;text-decoration:none;}
    .topbar-actions{display:flex;gap:8px;align-items:center;}
    .btn-icon{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:#cbd5e1;padding:7px 12px;border-radius:8px;cursor:pointer;font-family:'Cairo',sans-serif;font-size:13px;text-decoration:none;display:flex;align-items:center;gap:5px;transition:.2s;}
    .btn-icon:hover{background:rgba(212,175,55,.15);color:var(--gold);}
    .page-wrap{max-width:1000px;margin:0 auto;padding:30px 16px 60px;}
    .stmt-card{background:var(--card);border-radius:16px;box-shadow:0 8px 40px rgba(0,0,0,.09);overflow:hidden;margin-bottom:24px;}
    .stmt-head{background:linear-gradient(135deg,#0f172a,#1e3a5f);padding:28px 32px;text-align:center;position:relative;}
    .stmt-head::after{content:'';position:absolute;bottom:0;left:0;right:0;height:4px;background:linear-gradient(90deg,transparent,#d4af37,transparent);}
    .stmt-head .store-logo{height:55px;border-radius:8px;margin-bottom:10px;}
    .stmt-head .store-nm{color:#d4af37;font-size:20px;font-weight:800;margin:0 0 3px;}
    .stmt-head .store-inf{color:#94a3b8;font-size:12px;margin:0;}
    .stmt-head .doc-badge{display:inline-block;margin-top:12px;background:rgba(212,175,55,.15);border:1px solid rgba(212,175,55,.4);border-radius:8px;padding:8px 20px;}
    .stmt-head .doc-badge h4{color:white;font-weight:700;margin:0;font-size:15px;}
    .stmt-head .doc-badge p{color:#94a3b8;font-size:11px;margin:2px 0 0;}
    .party-strip{background:var(--card);border-bottom:1px solid var(--border);padding:14px 28px;display:flex;flex-wrap:wrap;gap:20px;align-items:center;}
    .pi{display:flex;align-items:center;gap:7px;}
    .pi i{color:#d4af37;}
    .pi span{font-size:13px;font-weight:600;color:var(--text);}
    .stmt-wrap{padding:20px 28px;overflow-x:auto;}
    .stmt-table{width:100%;border-collapse:collapse;font-size:13.5px;min-width:500px;}
    .stmt-table thead tr{background:#1e293b;}
    .stmt-table thead th{color:white;padding:11px 14px;text-align:center;font-size:13px;font-weight:700;}
    .stmt-table tbody td{padding:10px 14px;text-align:center;border-bottom:1px solid var(--border);color:var(--text);}
    .stmt-table tbody tr:nth-child(even){background:rgba(0,0,0,.02);}
    .dval{color:#dc2626;font-weight:700;}.cval{color:#16a34a;font-weight:700;}
    .bpos{color:#dc2626;font-weight:800;}.bneg{color:#2563eb;font-weight:800;}.bzero{color:#16a34a;font-weight:800;}
    .method-badge{display:inline-block;padding:1px 7px;border-radius:10px;font-size:10px;font-weight:700;}
    .method-cash{background:rgba(22,163,74,.1);color:#15803d;}
    .method-bank{background:rgba(37,99,235,.1);color:#1d4ed8;}
    .method-check{background:rgba(212,175,55,.15);color:#92400e;}
    .inv-badge-row{font-size:10px;color:#d4af37;font-weight:700;display:block;margin-bottom:2px;}
    .has-invoice{cursor:pointer;}.has-invoice:hover{background:rgba(212,175,55,.05) !important;}
    .items-detail{font-size:10px;color:#64748b;margin-top:3px;white-space:pre-wrap;background:#f8fafc;padding:3px 7px;border-radius:5px;border:1px solid #e2e8f0;text-align:right;max-width:380px;display:inline-block;}
    .inv-detail-row td{padding:0 !important;border-top:none !important;}
    .inv-detail-box{border-top:2px solid rgba(212,175,55,.35);background:rgba(212,175,55,.03);}
    .inv-detail-header{padding:7px 14px;background:rgba(212,175,55,.1);font-size:12px;font-weight:700;color:#92400e;border-bottom:1px solid rgba(212,175,55,.2);}
    .inv-items-table{width:100%;border-collapse:collapse;font-size:11.5px;}
    .inv-items-table thead tr{background:rgba(30,41,59,.06);}
    .inv-items-table thead th{padding:6px 12px;text-align:center;font-weight:700;color:#475569;font-size:11px;border-bottom:1px solid rgba(212,175,55,.15);}
    .inv-items-table tbody td{padding:5px 12px;text-align:center;border-bottom:1px solid rgba(0,0,0,.04);}
    .inv-footer-wrap{display:flex;flex-wrap:wrap;gap:10px;padding:8px 14px;border-top:1px solid rgba(212,175,55,.2);background:rgba(212,175,55,.04);}
    .inv-footer-item{display:flex;flex-direction:column;gap:1px;}
    .inv-footer-item .lbl{font-size:10px;color:#64748b;font-weight:600;}
    .inv-footer-item .val{font-size:13px;font-weight:800;}
    .sum-section{background:linear-gradient(135deg,#0f172a,#1e293b);border-radius:14px;padding:22px 28px;color:white;margin:0 28px 28px;}
    .sum-title{font-size:14px;font-weight:800;color:#d4af37;border-bottom:1px solid rgba(212,175,55,.3);padding-bottom:11px;margin-bottom:16px;}
    .sum-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
    .sum-box{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:15px;text-align:center;}
    .sum-box .lbl{font-size:12px;color:#94a3b8;margin-bottom:7px;}
    .sum-box .val{font-size:20px;font-weight:800;}
    .vc{color:#4ade80;}.vbp{color:#f87171;}.vbn{color:#60a5fa;}.vbz{color:#4ade80;}
    footer{text-align:center;padding:20px;color:var(--muted);font-size:13px;border-top:1px solid var(--border);}
    @media(max-width:576px){
      .stmt-head{padding:20px 16px;}.party-strip{padding:12px 16px;}
      .stmt-wrap{padding:14px 12px;}.sum-section{margin:0 12px 16px;padding:16px;}
      .sum-grid{grid-template-columns:1fr;}
    }
    @media print{
      body{background:white !important;}
      .no-print,.topbar{display:none !important;}
      .stmt-head{background:white !important;border-bottom:2px solid #000;padding:10px 16px;}
      .stmt-head .store-nm{color:#000 !important;}
      .stmt-head::after{display:none;}
      .stmt-head .doc-badge{background:none !important;border:1px solid #000 !important;}
      .stmt-head .doc-badge h4,.stmt-head .doc-badge p{color:#000 !important;}
      .party-strip{background:white !important;padding:6px 14px;}
      .pi span{color:#000 !important;}
      .stmt-wrap{padding:0 10px;}
      .stmt-table{font-size:8pt;}
      .stmt-table thead tr{background:#eee !important;-webkit-print-color-adjust:exact;}
      .stmt-table thead th{color:#000 !important;border:1px solid #999;padding:4px 7px;}
      .stmt-table tbody td{border:1px solid #ddd;color:#000 !important;padding:3px 7px;}
      .dval,.cval,.bpos,.bneg,.bzero{color:#000 !important;font-weight:700;}
      .method-badge{background:#eee !important;color:#000 !important;-webkit-print-color-adjust:exact;}
      .inv-badge-row{color:#333 !important;}
      .items-detail{background:#f5f5f5 !important;border-color:#ccc !important;color:#333 !important;font-size:8pt;}
      
      /* ✅ إخفاء صف تفاصيل الفاتورة في الطباعة */
      .inv-detail-row{display:none !important;}
      
      .inv-detail-box{border:1px solid #ccc;}
      .inv-detail-header{background:#f5f5f5 !important;color:#000 !important;padding:3px 10px;font-size:8pt;}
      .inv-items-table{font-size:8pt;}
      .inv-items-table thead th,.inv-items-table tbody td{padding:2px 7px;border:1px solid #ddd;color:#000 !important;}
      .inv-footer-wrap{padding:4px 10px;gap:8px;}
      .inv-footer-item .lbl{color:#333 !important;}
      .inv-footer-item .val{font-size:9pt !important;color:#000 !important;}
      .sum-section{background:white !important;border:1px solid #999;color:#000 !important;margin:8px 10px;padding:10px;}
      .sum-title{color:#000 !important;border-bottom:1px solid #999 !important;font-size:10pt;}
      .sum-box{background:#f5f5f5 !important;border:1px solid #ccc !important;-webkit-print-color-adjust:exact;}
      .sum-box .lbl{color:#333 !important;}
      .sum-box .val{color:#000 !important;font-size:12pt !important;}
      @page{size:<%= settings.statementPrintSize||'A4' %>;margin:<%= (settings.printMarginTop||10) %>mm <%= (settings.printMarginSide||10) %>mm;}
    }
  </style>
  <script type="text/javascript">(function(){const t=localStorage.getItem('theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
</head>
<body>

<nav class="topbar no-print">
  <a href="/" class="brand"><i class="fa-solid fa-couch"></i> <%= settings.storeName %></a>
  <div class="topbar-actions">
    <button class="btn-icon" onclick="window.print()"><i class="fa-solid fa-print"></i> طباعة</button>
    <a href="/dealer/" class="btn-icon"><i class="fa-solid fa-house"></i> الرئيسية</a>
    <a href="/logout" class="btn-icon" onclick="return confirm('هل تريد تسجيل الخروج؟')">
      <i class="fa-solid fa-right-from-bracket"></i> خروج
    </a>
  </div>
</nav>

<div class="page-wrap">
  <div class="stmt-card">
    <div class="stmt-head">
      <% if (settings.storeLogo && settings.storeLogo !== '/images/default-logo.png') { %>
        <img src="<%= settings.storeLogo %>" class="store-logo" alt="شعار المتجر">
      <% } %>
      <p class="store-nm"><%= settings.storeName %></p>
      <p class="store-inf">
        <% if (settings.storeAddress) { %><i class="fa-solid fa-location-dot"></i> <%= settings.storeAddress %>&nbsp;&nbsp;<% } %>
        <% if (settings.storePhone) { %><i class="fa-solid fa-phone"></i> <%= settings.storePhone %><% } %>
      </p>
      <div class="doc-badge">
        <h4><i class="fa-solid fa-handshake"></i> كشف حساب تاجر</h4>
        <p>تاريخ الإصدار: <%= new Date().toLocaleDateString('ar-EG',{year:'numeric',month:'long',day:'numeric'}) %></p>
      </div>
    </div>

    <div class="party-strip">
      <div class="pi"><i class="fa-solid fa-user-tie fa-lg"></i><span class="fw-bold" style="font-size:15px;"><%= dealer.fullName %></span></div>
      <% if (dealer.phone) { %><div class="pi"><i class="fa-solid fa-phone"></i><span><%= dealer.phone %></span></div><% } %>
      <% if (dealer.company) { %><div class="pi"><i class="fa-solid fa-building"></i><span><%= dealer.company %></span></div><% } %>
      <div class="pi" style="margin-right:auto;"><i class="fa-solid fa-list-ol"></i><span><%= transactions.length %> حركة</span></div>
    </div>

    <div class="stmt-wrap">
      <table class="stmt-table">
        <thead>
          <tr>
            <th style="width:4%">#</th>
            <th style="width:10%">التاريخ</th>
            <th style="width:32%">البيان</th>
            <th style="width:9%">طريقة الدفع</th>
            <th style="width:8%">المرجع</th>
            <th style="width:11%">مدين <%= settings.currency||'₪' %></th>
            <th style="width:11%">دائن <%= settings.currency||'₪' %></th>
            <th style="width:11%">الرصيد <%= settings.currency||'₪' %></th>
          </tr>
        </thead>
        <tbody>
          <% if (transactions.length === 0) { %>
            <tr><td colspan="8" class="text-center py-5" style="color:#94a3b8;">
              <i class="fa-solid fa-inbox fa-2x d-block mb-2"></i>لا توجد حركات في حسابك بعد
            </td></tr>
          <% } else { %>
            <% transactions.forEach((t,idx) => { %>
              <tr class="<%= t.invoice?'has-invoice':'' %>"
                  <% if(t.invoice){ %>onclick="toggleInvDetail('dinv-<%= idx %>')"<% } %>>
                <td style="color:#94a3b8;font-size:11px;"><%= idx+1 %></td>
                <td style="font-size:11px;white-space:nowrap;"><%= t.date.toLocaleDateString('ar-EG',{year:'numeric',month:'2-digit',day:'2-digit'}) %></td>
                <td style="text-align:right;">
                  <% if(t.invoice){ %>
                    <span class="inv-badge-row"><i class="fa-solid fa-file-invoice-dollar"></i> فاتورة: <%= t.invoice.invoiceNumber %> <span class="no-print" style="color:#94a3b8;font-size:9px;">(اضغط للتفاصيل)</span></span>
                  <% } %>
                  <div style="font-weight:600;font-size:12px;"><%= t.desc.split(' — ')[0] %></div>
                  <% if(t.itemsDetails && t.itemsDetails.length>0){ %>
                    <div class="items-detail"><%= t.itemsDetails %></div>
                  <% } %>
                  <% if(t.cheque){ %><span style="font-size:10px;color:#64748b;display:block;margin-top:2px;"><i class="fa-solid fa-money-check"></i> <%= t.cheque %></span><% } %>
                </td>
                <td>
                  <% if(t.credit>0 && t.method){ %>
                    <span class="method-badge <%= t.method==='cash'?'method-cash':t.method==='bank_transfer'?'method-bank':'method-check' %>">
                      <%= t.method==='cash'?'نقداً':t.method==='bank_transfer'?'تحويل':t.method==='check'?'شيك':t.method %>
                    </span>
                  <% }else{ %><span style="color:#94a3b8;font-size:10px;">—</span><% } %>
                </td>
                <td style="font-size:11px;color:#64748b;"><%= t.refNo %></td>
                <td class="<%= t.debit>0?'dval':'' %>"><%= t.debit>0?t.debit.toLocaleString('ar-EG'):'-' %></td>
                <td class="<%= t.credit>0?'cval':'' %>"><%= t.credit>0?t.credit.toLocaleString('ar-EG'):'-' %></td>
                <td class="<%= t.balance>0?'bpos':(t.balance<0?'bneg':'bzero') %>"><%= t.balance.toLocaleString('ar-EG') %></td>
              </tr>

              <% if(t.invoice && t.invoice.items && t.invoice.items.length>0){ %>
              <tr id="dinv-<%= idx %>" class="inv-detail-row" style="display:none;">
                <td colspan="8" style="border-top:none;">
                  <div class="inv-detail-box">
                    <div class="inv-detail-header">
                      <i class="fa-solid fa-list-check"></i>
                      تفاصيل الفاتورة: <strong><%= t.invoice.invoiceNumber %></strong>
                      &nbsp;|&nbsp; التاريخ: <%= new Date(t.invoice.invoiceDate).toLocaleDateString('ar-EG',{year:'numeric',month:'long',day:'numeric'}) %>
                    </div>
                    <table class="inv-items-table">
                      <thead><tr>
                        <th>الصنف / البيان</th><th>الكمية</th>
                        <th>سعر الوحدة <%= settings.currency||'₪' %></th>
                        <th>الإجمالي <%= settings.currency||'₪' %></th>
                      </tr></thead>
                      <tbody>
                        <% t.invoice.items.forEach(item=>{ %>
                          <tr>
                            <td style="text-align:right;font-weight:600;"><%= item.description %></td>
                            <td><% if(item.quantityType==='sqmeter'){%><%= item.length %>×<%= item.width %>م²<%}else if(item.quantityType==='meter'){%><%= item.quantity %>م<%}else{%><%= item.quantity %><%}%></td>
                            <td><%= item.unitPrice.toLocaleString('ar-EG') %></td>
                            <td style="color:#dc2626;font-weight:700;"><%= item.total.toLocaleString('ar-EG') %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                    <div class="inv-footer-wrap">
                      <% if(t.invoice.discount>0){ %><span class="inv-footer-item"><span class="lbl">خصم</span><span class="val" style="color:#15803d;">−<%= t.invoice.discount.toLocaleString('ar-EG') %></span></span><% } %>
                      <span class="inv-footer-item"><span class="lbl">الإجمالي</span><span class="val" style="color:#dc2626;"><%= t.invoice.totalAmount.toLocaleString('ar-EG') %> <%= settings.currency||'₪' %></span></span>
                      <span class="inv-footer-item"><span class="lbl">المدفوع</span><span class="val" style="color:#15803d;"><%= t.invoice.paidAmount.toLocaleString('ar-EG') %></span></span>
                      <span class="inv-footer-item"><span class="lbl">المتبقي</span><span class="val" style="color:<%= t.invoice.remainingBalance>0?'#dc2626':'#15803d' %>;"><%= t.invoice.remainingBalance.toLocaleString('ar-EG') %></span></span>
                      <span class="inv-footer-item"><span class="lbl">الحالة</span>
                        <span style="background:<%= t.invoice.status==='paid'?'#dcfce7':t.invoice.status==='partial'?'#fef3c7':'#fee2e2' %>;color:<%= t.invoice.status==='paid'?'#166534':t.invoice.status==='partial'?'#92400e':'#991b1b' %>;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;">
                          <%= t.invoice.status==='paid'?'مسددة ✓':t.invoice.status==='partial'?'جزئي':'غير مسددة' %>
                        </span>
                      </span>
                    </div>
                    <% if(t.invoicePayments && t.invoicePayments.length > 0){ %>
                    <div style="padding:8px 14px;border-top:2px solid rgba(212,175,55,.25);background:rgba(212,175,55,.04);">
                      <div style="font-size:11px;font-weight:700;color:#d4af37;margin-bottom:6px;"><i class="fa-solid fa-money-bill-wave me-1"></i>سجل الدفعات على هذه الفاتورة</div>
                      <table style="width:100%;border-collapse:collapse;font-size:11px;">
                        <thead>
                          <tr style="color:#94a3b8;font-size:10px;">
                            <th style="text-align:right;padding:2px 6px;">التاريخ</th>
                            <th style="text-align:right;padding:2px 6px;">طريقة الدفع</th>
                            <th style="text-align:right;padding:2px 6px;">رقم الشيك / المرجع</th>
                            <th style="text-align:right;padding:2px 6px;">البنك</th>
                            <th style="text-align:left;padding:2px 6px;color:#15803d;">المبلغ <%= settings.currency||'₪' %></th>
                          </tr>
                        </thead>
                        <tbody>
                          <% t.invoicePayments.forEach(p=>{ %>
                          <tr style="border-top:1px solid rgba(212,175,55,.1);">
                            <td style="padding:3px 6px;white-space:nowrap;color:#64748b;"><%= new Date(p.date).toLocaleDateString('ar-EG',{year:'numeric',month:'2-digit',day:'2-digit'}) %></td>
                            <td style="padding:3px 6px;">
                              <span style="padding:1px 7px;border-radius:8px;font-size:10px;font-weight:700;background:<%= p.paymentMethod==='cash'?'#dcfce7':p.paymentMethod==='bank_transfer'?'#dbeafe':'#fef3c7' %>;color:<%= p.paymentMethod==='cash'?'#166534':p.paymentMethod==='bank_transfer'?'#1e40af':'#92400e' %>;">
                                <%= p.paymentMethod==='cash'?'نقداً':p.paymentMethod==='bank_transfer'?'تحويل بنكي':p.paymentMethod==='check'?'شيك':p.paymentMethod||'—' %>
                              </span>
                            </td>
                            <td style="padding:3px 6px;color:#64748b;"><%= p.chequeNumber||p.refNo||'—' %></td>
                            <td style="padding:3px 6px;color:#64748b;"><%= p.bankName||'—' %></td>
                            <td style="padding:3px 6px;font-weight:700;color:#15803d;text-align:left;"><%= p.amount.toLocaleString('ar-EG') %></td>
                          </tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                    <% } %>
                    <div style="padding:6px 14px;font-size:11px;border-top:1px solid rgba(212,175,55,.1);">
                      <a href="/dealer/invoices/<%= t.invoice._id %>" class="no-print" style="color:#3b82f6;font-weight:700;">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> عرض الفاتورة كاملة وطباعتها
                      </a>
                    </div>
                  </div>
                </td>
              </tr>
              <% } %>

            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="sum-section">
      <div class="sum-title"><i class="fa-solid fa-chart-pie"></i> الملخص المالي</div>
      <div class="sum-grid">
        <div class="sum-box">
          <div class="lbl">إجمالي المدفوع</div>
          <div class="val vc"><%= totals.totalCredit.toLocaleString('ar-EG') %> <%= settings.currency||'₪' %></div>
        </div>
        <div class="sum-box">
          <div class="lbl">الرصيد المستحق</div>
          <div class="val <%= totals.finalBalance>0?'vbp':(totals.finalBalance<0?'vbn':'vbz') %>">
            <%= totals.finalBalance.toLocaleString('ar-EG') %> <%= settings.currency||'₪' %>
          </div>
          <div style="font-size:11px;color:#64748b;margin-top:4px;">
            <% if(totals.finalBalance>0){%>مستحق عليك<%}else if(totals.finalBalance<0){%>رصيد لصالحك<%}else{%>الحساب مسوّى ✓<%}%>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<footer><p><i class="fa-solid fa-couch me-1" style="color:var(--gold);"></i> <%= settings.storeName %></p></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function toggleInvDetail(id){
    const row=document.getElementById(id);
    if(!row)return;
    row.style.display=(row.style.display==='none'||row.style.display==='')?'table-row':'none';
  }
</script>
<script>
