<!DOCTYPE html>
<html lang="ar-u-nu-latn" dir="rtl" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>فواتيري | <%= settings.storeName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{--gold:#d4af37;--bg:#f0f4f8;--card:#fff;--text:#1e293b;--muted:#64748b;--border:#e2e8f0;}
    body{font-family:'Cairo',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;}
    .topbar{background:linear-gradient(135deg,#0f172a,#1e3a5f);padding:12px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;box-shadow:0 3px 20px rgba(0,0,0,.3);}
    .brand{color:var(--gold);font-weight:800;font-size:17px;display:flex;align-items:center;gap:8px;text-decoration:none;}
    .topbar-actions{display:flex;gap:8px;align-items:center;}
    .btn-icon{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:#cbd5e1;padding:7px 12px;border-radius:8px;cursor:pointer;font-family:'Cairo',sans-serif;font-size:13px;text-decoration:none;display:flex;align-items:center;gap:5px;transition:.2s;}
    .btn-icon:hover{background:rgba(212,175,55,.15);color:var(--gold);}
    .page-wrap{max-width:900px;margin:0 auto;padding:30px 16px 60px;}
    .page-title{font-size:20px;font-weight:800;color:var(--text);margin-bottom:20px;display:flex;align-items:center;gap:10px;}
    .page-title i{color:var(--gold);}
    .inv-card{background:var(--card);border-radius:14px;border:1px solid var(--border);box-shadow:0 4px 20px rgba(0,0,0,.06);overflow:hidden;margin-bottom:14px;transition:all .2s;}
    .inv-card:hover{box-shadow:0 8px 30px rgba(0,0,0,.1);transform:translateY(-2px);}
    .inv-card-body{padding:18px 22px;display:flex;flex-wrap:wrap;align-items:center;gap:14px;}
    .inv-number{font-size:16px;font-weight:800;color:var(--gold);}
    .inv-date{font-size:12px;color:var(--muted);}
    .inv-amount{font-size:17px;font-weight:800;color:#dc2626;}
    .inv-paid{font-size:13px;font-weight:700;color:#16a34a;}
    .inv-remaining{font-size:13px;font-weight:700;}
    .badge-status{display:inline-block;padding:3px 12px;border-radius:20px;font-size:12px;font-weight:700;}
    .s-paid{background:#dcfce7;color:#166534;}
    .s-partial{background:#fef3c7;color:#92400e;}
    .s-unpaid{background:#fee2e2;color:#991b1b;}
    .inv-actions{margin-right:auto;display:flex;gap:8px;}
    .btn-view{background:rgba(59,130,246,.1);color:#1d4ed8;border:1px solid rgba(59,130,246,.2);padding:6px 14px;border-radius:8px;font-family:'Cairo',sans-serif;font-size:13px;font-weight:700;text-decoration:none;display:flex;align-items:center;gap:5px;transition:.2s;}
    .btn-view:hover{background:rgba(59,130,246,.2);color:#1d4ed8;}
    .empty-state{text-align:center;padding:60px 20px;color:var(--muted);}
    footer{text-align:center;padding:16px;color:var(--muted);font-size:12px;border-top:1px solid var(--border);}
  </style>
</head>
<body>
<nav class="topbar">
  <a href="/customer/" class="brand"><i class="fa-solid fa-couch"></i> <%= settings.storeName %></a>
  <div class="topbar-actions">
    <a href="/customer/" class="btn-icon"><i class="fa-solid fa-house"></i> الرئيسية</a>
    <a href="/logout" class="btn-icon" onclick="return confirm('هل تريد تسجيل الخروج؟')">
      <i class="fa-solid fa-right-from-bracket"></i> خروج
    </a>
  </div>
</nav>

<div class="page-wrap">
  <div class="page-title">
    <i class="fa-solid fa-receipt"></i>
    فواتيري — <%= customer.fullName %>
  </div>

  <% if (invoices.length === 0) { %>
    <div class="empty-state">
      <i class="fa-solid fa-receipt fa-3x d-block mb-3" style="color:#d4af37;"></i>
      <p class="fw-bold">لا توجد فواتير مسجلة باسمك بعد</p>
    </div>
  <% } else { %>
    <% invoices.forEach(inv => { %>
      <div class="inv-card">
        <div class="inv-card-body">
          <div>
            <div class="inv-number"><i class="fa-solid fa-file-invoice-dollar me-1"></i><%= inv.invoiceNumber %></div>
            <div class="inv-date"><%= new Date(inv.invoiceDate).toLocaleDateString('ar-EG',{year:'numeric',month:'long',day:'numeric'}) %></div>
          </div>
          <div>
            <div class="inv-amount"><%= inv.totalAmount.toLocaleString('ar-EG') %> <%= settings.currency||'₪' %></div>
            <div class="inv-paid">مدفوع: <%= inv.paidAmount.toLocaleString('ar-EG') %> <%= settings.currency||'₪' %></div>
          </div>
          <div>
            <div class="inv-remaining" style="color:<%= inv.remainingBalance>0?'#dc2626':'#16a34a' %>">
              متبقي: <%= inv.remainingBalance.toLocaleString('ar-EG') %> <%= settings.currency||'₪' %>
            </div>
            <span class="badge-status <%= inv.status==='paid'?'s-paid':inv.status==='partial'?'s-partial':'s-unpaid' %>">
              <%= inv.status==='paid'?'مسددة ✓':inv.status==='partial'?'جزئي':'غير مسددة' %>
            </span>
          </div>
          <div class="inv-actions">
            <a href="/customer/invoices/<%= inv._id %>" class="btn-view">
              <i class="fa-solid fa-eye"></i> عرض وطباعة
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<footer><i class="fa-solid fa-couch me-1" style="color:var(--gold);"></i> <%= settings.storeName %></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
/* 25002500 062a062d0648064a0644 0627064406230631064206270645 06270644063906310628064a0629 064406440627062a064a0646064a0629 25002500 */
(function(){
  function fix(n){if(n.nodeType===3){n.nodeValue=n.nodeValue.replace(/[0660-0669]/g,function(d){return d.charCodeAt(0)-0x0660;});}else{n.childNodes.forEach(fix);}}
  document.addEventListener('DOMContentLoaded',function(){fix(document.body);});
})();
</script>
</body>
</html>
