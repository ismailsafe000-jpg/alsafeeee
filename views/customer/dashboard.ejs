<!DOCTYPE html>
<html lang="ar-u-nu-latn" dir="rtl" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>حسابي | <%= settings.storeName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root{--gold:#d4af37;--bg:#f0f4f8;--card:#fff;--text:#1e293b;--muted:#64748b;--border:#e2e8f0;}
    body{font-family:'Cairo',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;flex-direction:column;}
    .topbar{background:linear-gradient(135deg,#0f172a,#1e3a5f);padding:12px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;box-shadow:0 3px 20px rgba(0,0,0,.3);}
    .brand{color:var(--gold);font-weight:800;font-size:17px;display:flex;align-items:center;gap:8px;text-decoration:none;}
    .btn-icon{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:#cbd5e1;padding:7px 14px;border-radius:8px;cursor:pointer;font-family:'Cairo',sans-serif;font-size:13px;text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:.2s;}
    .btn-icon:hover{background:rgba(212,175,55,.15);color:var(--gold);}
    .page-wrap{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 16px;}
    .welcome-card{background:var(--card);border-radius:20px;box-shadow:0 8px 40px rgba(0,0,0,.09);border:1px solid var(--border);padding:40px 36px;max-width:500px;width:100%;text-align:center;}
    .welcome-icon{width:70px;height:70px;background:linear-gradient(135deg,#d4af37,#c5a030);border-radius:18px;display:flex;align-items:center;justify-content:center;font-size:30px;color:white;margin:0 auto 20px;}
    .welcome-name{font-size:22px;font-weight:800;color:var(--text);margin-bottom:4px;}
    .welcome-sub{font-size:14px;color:var(--muted);margin-bottom:32px;}
    .dash-btn{display:flex;align-items:center;gap:14px;padding:18px 22px;border-radius:14px;border:1px solid var(--border);background:var(--card);color:var(--text);text-decoration:none;margin-bottom:14px;transition:all .25s;font-weight:700;font-size:15px;}
    .dash-btn:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,.1);color:var(--text);}
    .dash-btn .btn-ic{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
    .dash-btn.stmt .btn-ic{background:rgba(59,130,246,.1);color:#3b82f6;}
    .dash-btn.inv .btn-ic{background:rgba(220,38,38,.08);color:#dc2626;}
    .dash-btn.visits .btn-ic{background:rgba(212,175,55,.12);color:#d4af37;}
    .dash-btn .btn-txt{text-align:right;flex:1;}
    .dash-btn .btn-lbl{display:block;font-size:15px;font-weight:800;}
    .dash-btn .btn-desc{display:block;font-size:12px;color:var(--muted);font-weight:400;margin-top:2px;}
    footer{text-align:center;padding:16px;color:var(--muted);font-size:12px;border-top:1px solid var(--border);}
  </style>
</head>
<body>
<nav class="topbar">
  <a href="/" class="brand"><i class="fa-solid fa-couch"></i> <%= settings.storeName %></a>
  <a href="/logout" class="btn-icon" onclick="return confirm('هل تريد تسجيل الخروج؟')">
    <i class="fa-solid fa-right-from-bracket"></i> خروج
  </a>
</nav>

<div class="page-wrap">
  <div class="welcome-card">
    <div class="welcome-icon"><i class="fa-solid fa-user"></i></div>
    <div class="welcome-name">أهلاً، <%= customer.fullName %></div>
    <div class="welcome-sub">اختر ما تريد الاطلاع عليه</div>

    <% if (settings.customerShowStatement !== false) { %>
    <a href="/customer/statement" class="dash-btn stmt">
      <div class="btn-ic"><i class="fa-solid fa-file-invoice-dollar"></i></div>
      <div class="btn-txt">
        <span class="btn-lbl">كشف الحساب</span>
        <span class="btn-desc">عرض جميع حركاتك المالية والرصيد</span>
      </div>
      <i class="fa-solid fa-chevron-left" style="color:var(--muted);"></i>
    </a>
    <% } %>

    <% if (settings.customerShowInvoices !== false) { %>
    <a href="/customer/invoices" class="dash-btn inv">
      <div class="btn-ic"><i class="fa-solid fa-receipt"></i></div>
      <div class="btn-txt">
        <span class="btn-lbl">فواتيري</span>
        <span class="btn-desc">عرض جميع الفواتير الصادرة باسمك</span>
      </div>
      <i class="fa-solid fa-chevron-left" style="color:var(--muted);"></i>
    </a>
    <% } %>

    <% if (settings.customerShowVisits !== false) { %>
    <a href="/customer/visits" class="dash-btn visits">
      <div class="btn-ic"><i class="fa-solid fa-calendar-check"></i></div>
      <div class="btn-txt">
        <span class="btn-lbl">زياراتي ومقاساتي</span>
        <span class="btn-desc">عرض جميع الزيارات والمقاسات المسجلة</span>
      </div>
      <i class="fa-solid fa-chevron-left" style="color:var(--muted);"></i>
    </a>
    <% } %>

  </div>
</div>

<footer><i class="fa-solid fa-couch me-1" style="color:var(--gold);"></i> <%= settings.storeName %></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
/* 25002500 062a062d0648064a0644 0627064406230631064206270645 06270644063906310628064a0629 064406440627062a064a0646064a0629 25002500 */
(function(){
  function fix(n){if(n.nodeType===3){n.nodeValue=n.nodeValue.replace(/[0660-0669]/g,function(d){return d.charCodeAt(0)-0x0660;});}else{n.childNodes.forEach(fix);}}
  document.addEventListener('DOMContentLoaded',function(){fix(document.body);});
})();
</script>
</body>
</html>
