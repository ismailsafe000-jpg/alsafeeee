<!DOCTYPE html>
<html lang="ar-u-nu-latn" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= settings.storeName || title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --card-bg:      rgba(15,23,42,0.82);
      --border:       rgba(255,255,255,0.09);
      --primary:      #3b82f6;
      --primary-h:    #2563eb;
      --gold:         #d4af37;
      --text:         #f1f5f9;
      --text-2:       rgba(148,163,184,0.85);
      --input-bg:     rgba(255,255,255,0.06);
      --input-border: rgba(255,255,255,0.12);
    }
    body.light-mode {
      --card-bg:      rgba(255,255,255,0.90);
      --border:       rgba(0,0,0,0.08);
      --text:         #1e293b;
      --text-2:       #64748b;
      --input-bg:     rgba(0,0,0,0.04);
      --input-border: rgba(0,0,0,0.13);
    }

    body {
      font-family: 'Cairo', sans-serif;
      min-height: 100vh;
      background: #0a0f1e;
      overflow-x: hidden;
      transition: background 0.4s;
    }
    body.light-mode { background: #e8edf5; }

    /* ── خلفية ── */
    .bg-layer {
      position: fixed; inset: 0; z-index: 0;
      background: url('/images/login-bg.png') center/cover no-repeat;
    }
    .bg-layer::after {
      content: '';
      position: absolute; inset: 0;
      background: rgba(5,10,24,0.70);
    }
    body.light-mode .bg-layer::after { background: rgba(220,230,245,0.62); }

    .bg-grid {
      position: fixed; inset: 0; z-index: 0;
      background-image: radial-gradient(circle at 1px 1px, rgba(212,175,55,0.06) 1px, transparent 0);
      background-size: 48px 48px;
    }

    /* ── زر الوضع ── */
    .theme-toggle {
      position: fixed; top: 18px; left: 18px; z-index: 100;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 24px;
      padding: 7px 14px 7px 10px;
      display: flex; align-items: center; gap: 8px;
      cursor: pointer;
      color: var(--text);
      font-family: 'Cairo', sans-serif;
      font-size: 13px; font-weight: 700;
      transition: all 0.3s;
      backdrop-filter: blur(10px);
    }
    body.light-mode .theme-toggle { background: rgba(0,0,0,0.07); border-color: rgba(0,0,0,0.12); }
    .theme-toggle:hover { background: rgba(255,255,255,0.14); }
    .toggle-ball {
      width: 34px; height: 18px;
      background: rgba(255,255,255,0.15);
      border-radius: 9px;
      position: relative; flex-shrink: 0;
      transition: background 0.3s;
    }
    .toggle-ball::before {
      content: '';
      position: absolute; top: 3px; right: 3px;
      width: 12px; height: 12px;
      border-radius: 50%;
      background: #94a3b8;
      transition: all 0.3s;
    }
    body.light-mode .toggle-ball { background: rgba(59,130,246,0.25); }
    body.light-mode .toggle-ball::before { right: auto; left: 3px; background: var(--primary); }

    /* ── الصفحة ── */
    .page-wrap {
      position: relative; z-index: 10;
      min-height: 100vh;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 24px 16px 80px;
      gap: 24px;
    }

    /* ── البطاقة ── */
    .login-card {
      width: 100%; max-width: 440px;
      background: var(--card-bg);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: 0 32px 80px rgba(0,0,0,0.55);
      overflow: hidden;
      animation: slideUp 0.5s ease both;
    }
    @keyframes slideUp {
      from { opacity:0; transform: translateY(28px); }
      to   { opacity:1; transform: translateY(0); }
    }

    /* ── رأس البطاقة ── */
    .card-top {
      padding: 36px 36px 28px;
      text-align: center;
      border-bottom: 1px solid var(--border);
      background: linear-gradient(180deg, rgba(212,175,55,0.05) 0%, transparent 100%);
      position: relative;
    }
    .card-top::before {
      content: '';
      position: absolute; top: 0; left: 50%; transform: translateX(-50%);
      width: 55%; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(212,175,55,0.55), transparent);
    }

    .logo-wrap {
      width: 90px; height: 90px;
      border-radius: 50%;
      border: 2px solid rgba(212,175,55,0.35);
      box-shadow: 0 0 0 6px rgba(212,175,55,0.07), 0 8px 28px rgba(0,0,0,0.3);
      margin: 0 auto 18px;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden;
      background: rgba(10,15,30,0.6);
    }
    .logo-wrap img { width: 100%; height: 100%; object-fit: cover; }
    .logo-wrap i { color: var(--gold); font-size: 36px; }

    .store-name {
      font-size: 22px; font-weight: 900;
      color: var(--text);
      margin-bottom: 6px;
    }
    .store-sub {
      font-size: 13px; color: var(--text-2);
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; display: inline-block; animation: blink 2s infinite; }
    @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.35;} }

    /* ── جسم البطاقة ── */
    .card-body-inner { padding: 30px 32px 32px; }

    /* ── رسائل ── */
    .alert-custom {
      border-radius: 12px;
      padding: 11px 16px;
      font-size: 13px;
      margin-bottom: 20px;
      display: flex; align-items: center; gap: 8px;
    }
    .alert-error   { background: rgba(220,38,38,0.12); border: 1px solid rgba(220,38,38,0.25); color: #f87171; }
    .alert-success { background: rgba(22,163,74,0.12);  border: 1px solid rgba(22,163,74,0.25);  color: #4ade80; }

    /* ── حقول الإدخال ── */
    .field { margin-bottom: 16px; position: relative; }
    .field-icon {
      position: absolute; top: 50%; transform: translateY(-50%);
      right: 16px;
      color: var(--text-2);
      font-size: 15px;
      pointer-events: none;
    }
    .field input {
      width: 100%;
      padding: 13px 44px 13px 16px;
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      border-radius: 12px;
      color: var(--text);
      font-family: 'Cairo', sans-serif;
      font-size: 14px;
      outline: none;
      transition: all 0.3s;
    }
    .field input::placeholder { color: var(--text-2); font-size: 13px; }
    .field input:focus {
      border-color: rgba(59,130,246,0.55);
      background: rgba(59,130,246,0.06);
      box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
    }

    /* ── صف تذكرني / نسيت ── */
    .extras {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 22px; font-size: 13px;
    }
    .remember-label {
      display: flex; align-items: center; gap: 7px;
      color: var(--text-2); cursor: pointer; user-select: none;
    }
    .remember-label input[type=checkbox] {
      width: 15px; height: 15px; cursor: pointer;
      accent-color: var(--primary);
    }
    .forgot-link {
      color: var(--primary); font-weight: 700;
      text-decoration: none;
      transition: color 0.2s;
    }
    .forgot-link:hover { color: var(--primary-h); }

    /* ── زر الدخول ── */
    .btn-login {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      color: #fff;
      font-family: 'Cairo', sans-serif;
      font-size: 16px; font-weight: 800;
      cursor: pointer;
      transition: all 0.3s;
      box-shadow: 0 4px 18px rgba(59,130,246,0.35);
      display: flex; align-items: center; justify-content: center; gap: 10px;
    }
    .btn-login:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(59,130,246,0.45); }
    .btn-login:active { transform: translateY(0); }

    /* ── فاصل ── */
    .divider {
      display: flex; align-items: center; gap: 10px;
      margin: 20px 0;
      color: var(--text-2); font-size: 12px;
    }
    .divider::before, .divider::after {
      content: ''; flex: 1;
      height: 1px; background: var(--border);
    }

    /* ── زر الكتالوج ── */
    .btn-catalog {
      width: 100%;
      padding: 13px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: transparent;
      color: var(--text-2);
      font-family: 'Cairo', sans-serif;
      font-size: 14px; font-weight: 700;
      cursor: pointer;
      transition: all 0.3s;
      text-decoration: none;
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .btn-catalog:hover {
      background: rgba(255,255,255,0.05);
      border-color: rgba(255,255,255,0.18);
      color: var(--text);
    }
    body.light-mode .btn-catalog:hover { background: rgba(0,0,0,0.05); }

    /* ── بطاقات المعلومات ── */
    .info-grid {
      display: grid; grid-template-columns: repeat(3,1fr); gap: 12px;
      width: 100%; max-width: 460px;
    }
    .info-card {
      background: rgba(15,23,42,0.55);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 16px;
      padding: 18px 12px;
      text-align: center;
      backdrop-filter: blur(10px);
    }
    body.light-mode .info-card { background: rgba(255,255,255,0.58); border-color: rgba(0,0,0,0.07); }
    .info-icon {
      width: 44px; height: 44px;
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px;
      margin: 0 auto 10px;
    }
    .info-title { font-size: 13px; font-weight: 800; color: var(--text); margin-bottom: 4px; }
    .info-desc  { font-size: 11px; color: var(--text-2); line-height: 1.5; }

    /* ── فوتر ── */
    .page-footer {
      position: fixed; bottom: 0; left: 0; right: 0;
      padding: 11px 24px;
      text-align: center;
      font-size: 12px;
      color: rgba(100,116,139,0.55);
      background: rgba(5,10,24,0.4);
      backdrop-filter: blur(8px);
    }
    body.light-mode .page-footer { background: rgba(220,230,245,0.5); }

    /* ── استجابة ── */
    @media (max-width: 480px) {
      .card-top { padding: 28px 22px 22px; }
      .card-body-inner { padding: 22px 20px 26px; }
      .store-name { font-size: 18px; }
      .info-grid { grid-template-columns: 1fr; max-width: 300px; }
    }
  </style>
</head>
<body>

  <div class="bg-layer"></div>
  <div class="bg-grid"></div>

  <!-- زر الوضع الداكن/الفاتح -->
  <button class="theme-toggle" onclick="toggleTheme()">
    <i class="fa-solid fa-moon" id="themeIcon"></i>
    <span id="themeLabel">الوضع الداكن</span>
    <div class="toggle-ball"></div>
  </button>

  <div class="page-wrap">

    <!-- البطاقة الرئيسية -->
    <div class="login-card">

      <!-- رأس -->
      <div class="card-top">
        <div class="logo-wrap">
          <% if (settings.storeLogo && settings.storeLogo !== '/images/default-logo.png') { %>
            <img src="<%= settings.storeLogo %>" alt="<%= settings.storeName %>">
          <% } else { %>
            <i class="fa-solid fa-couch"></i>
          <% } %>
        </div>
        <div class="store-name"><%= settings.storeName || title %></div>
        <div class="store-sub">
          <span class="dot"></span>
          <%= settings.systemTitle || 'نظام إدارة متكامل وعصري' %>
          <span class="dot"></span>
        </div>
      </div>

      <!-- جسم -->
      <div class="card-body-inner">

        <% if (error_msg && error_msg.length > 0 && error_msg[0] !== '') { %>
          <div class="alert-custom alert-error">
            <i class="fa-solid fa-circle-xmark"></i> <%= error_msg[0] %>
          </div>
        <% } %>
        <% if (success_msg && success_msg.length > 0 && success_msg[0] !== '') { %>
          <div class="alert-custom alert-success">
            <i class="fa-solid fa-circle-check"></i> <%= success_msg[0] %>
          </div>
        <% } %>

        <form action="/login" method="POST">

          <div class="field">
            <span class="field-icon"><i class="fa-solid fa-user"></i></span>
            <input type="text" name="username" placeholder="اسم المستخدم" required autofocus autocomplete="username">
          </div>

          <div class="field">
            <span class="field-icon"><i class="fa-solid fa-lock"></i></span>
            <input type="password" name="password" placeholder="كلمة المرور" required autocomplete="current-password">
          </div>

          <div class="extras">
            <label class="remember-label">
              <input type="checkbox" name="remember"> تذكرني
            </label>
            <a href="#" class="forgot-link">نسيت كلمة المرور؟</a>
          </div>

          <button type="submit" class="btn-login">
            <i class="fa-solid fa-right-to-bracket"></i>
            تسجيل الدخول
          </button>

        </form>

        <div class="divider">أو</div>

        <a href="/catalog" class="btn-catalog">
          <i class="fa-solid fa-book-open"></i>
          استعراض الكتالوج
        </a>

      </div>
    </div>

    <!-- بطاقات المعلومات -->
    <div class="info-grid">
      <div class="info-card">
        <div class="info-icon" style="background:rgba(59,130,246,0.12); color:#60a5fa;">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <div class="info-title">نظام آمن</div>
        <div class="info-desc">حماية متقدمة لبياناتك بأعلى معايير الأمان</div>
      </div>
      <div class="info-card">
        <div class="info-icon" style="background:rgba(34,197,94,0.12); color:#4ade80;">
          <i class="fa-solid fa-gauge-high"></i>
        </div>
        <div class="info-title">أداء عالي</div>
        <div class="info-desc">سرعة وكفاءة في إدارة جميع العمليات</div>
      </div>
      <div class="info-card">
        <div class="info-icon" style="background:rgba(245,158,11,0.12); color:#fbbf24;">
          <i class="fa-solid fa-chart-line"></i>
        </div>
        <div class="info-title">إدارة ذكية</div>
        <div class="info-desc">تقارير وتحليلات دقيقة لمساعدتك في اتخاذ القرار</div>
      </div>
    </div>

  </div>

  <!-- فوتر -->
  <div class="page-footer">
    © <%= new Date().getFullYear() %> <%= settings.storeName || 'معرض الصافي للمفروشات' %> — جميع الحقوق محفوظة
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function toggleTheme() {
      const isLight = document.body.classList.toggle('light-mode');
      document.getElementById('themeIcon').className = isLight ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
      document.getElementById('themeLabel').textContent = isLight ? 'الوضع الفاتح' : 'الوضع الداكن';
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
    }
    (function(){
      if (localStorage.getItem('theme') === 'light') {
        document.body.classList.add('light-mode');
        document.getElementById('themeIcon').className = 'fa-solid fa-sun';
        document.getElementById('themeLabel').textContent = 'الوضع الفاتح';
      }
    })();
    // تحويل الأرقام الهندية
    (function(){
      function fix(n){if(n.nodeType===3){n.nodeValue=n.nodeValue.replace(/[٠-٩]/g,d=>d.charCodeAt(0)-0x0660);}else n.childNodes.forEach(fix);}
      document.addEventListener('DOMContentLoaded',()=>fix(document.body));
    })();
  </script>
</body>
</html>
