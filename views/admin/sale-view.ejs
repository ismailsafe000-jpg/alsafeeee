<%- include('../partials/admin-header') %>
<style>
  @media print {
    @page { size: A4; margin: 10mm 12mm; }
    body { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    .no-print { display: none !important; }
    .container { padding: 0 !important; }
    nav, footer { display: none !important; }
  }
  .inv-head { display:flex; justify-content:space-between; align-items:stretch; background:#fff; border-bottom:2px solid #0f172a; padding:8px 12px; margin-bottom:6px; gap:8px; min-height:72px; }
  .header-right { flex:1; display:flex; align-items:center; gap:8px; }
  .store-name { font-size:16px; font-weight:800; color:#0f172a; }
  .store-details { font-size:10px; color:#334155; line-height:1.5; }
  .header-center { flex:1; text-align:center; display:flex; flex-direction:column; justify-content:center; }
  .sale-title { font-size:17px; font-weight:900; color:#0f172a; letter-spacing:1px; }
  .header-left { text-align:left; display:flex; flex-direction:column; justify-content:center; gap:2px; }
  .meta-item { font-size:11px; color:#0f172a; }
  .meta-label { font-weight:700; color:#64748b; margin-left:4px; }
  .party-strip { background:#0f172a; color:#fff; padding:6px 14px; border-radius:8px; margin-bottom:8px; display:flex; gap:20px; flex-wrap:wrap; align-items:center; }
  .party-strip .pi { font-size:12px; }
  .party-strip .pi strong { color:#d4af37; }
  .items-table { width:100%; border-collapse:collapse; margin-bottom:8px; font-size:12px; }
  .items-table th { background:#0f172a; color:#d4af37; padding:6px 8px; text-align:right; font-size:11px; }
  .items-table td { padding:5px 8px; border-bottom:1px solid #e2e8f0; }
  .items-table tr:last-child td { border-bottom:none; }
  .items-table tr:nth-child(even) td { background:#f8fafc; }
  .totals-box { background:#0f172a; color:#fff; border-radius:8px; padding:10px 16px; display:flex; gap:20px; flex-wrap:wrap; align-items:center; margin-bottom:10px; }
  .totals-box .t-item { display:flex; flex-direction:column; align-items:center; }
  .totals-box .t-lbl { font-size:11px; color:#94a3b8; }
  .totals-box .t-val { font-size:18px; font-weight:800; color:#d4af37; }
  .pays-table { width:100%; border-collapse:collapse; font-size:12px; margin-top:6px; }
  .pays-table th { background:#f1f5f9; color:#0f172a; padding:5px 8px; text-align:right; font-size:11px; border:1px solid #e2e8f0; }
  .pays-table td { padding:5px 8px; border:1px solid #e2e8f0; }
  .status-badge { display:inline-flex; align-items:center; gap:4px; padding:2px 10px; border-radius:20px; font-size:12px; font-weight:700; }
  .status-unpaid  { background:#fee2e2; color:#991b1b; }
  .status-partial { background:#fef3c7; color:#92400e; }
  .status-paid    { background:#d1fae5; color:#065f46; }
  .sig-row { display:flex; gap:16px; margin-top:14px; }
  .sig-box { flex:1; border:1px dashed #cbd5e1; border-radius:8px; text-align:center; padding:20px 8px 8px; min-height:64px; font-size:11px; color:#94a3b8; }
  .action-bar { display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap; }
</style>

<!-- أزرار الإجراءات -->
<div class="action-bar no-print">
  <a href="/admin/sales/print/<%= sale._id %>" target="_blank" class="btn btn-gold">
    <i class="fa-solid fa-print me-1"></i> طباعة / PDF
  </a>
  <a href="/admin/sales/edit/<%= sale._id %>" class="btn btn-outline-warning">
    <i class="fa-solid fa-pen me-1"></i> تعديل
  </a>
  <a href="/admin/sales" class="btn btn-outline-secondary">
    <i class="fa-solid fa-arrow-right me-1"></i> قائمة المبيعات
  </a>
  <form action="/admin/sales/delete/<%= sale._id %>" method="POST" style="display:inline;"
        onsubmit="return confirm('حذف المبيعة <%= sale.saleNumber %>؟')">
    <button class="btn btn-outline-danger"><i class="fa-solid fa-trash me-1"></i> حذف</button>
  </form>
</div>

<!-- ===== ورقة المبيعة ===== -->
<div style="background:#fff;border-radius:14px;border:1px solid #e2e8f0;padding:16px;max-width:900px;">

  <!-- الرأسية -->
  <div class="inv-head">
    <div class="header-right">
      <% if(settings.storeLogo && settings.storeLogo !== '/images/default-logo.png') { %>
        <img src="<%= settings.storeLogo %>" style="max-height:52px;object-fit:contain;border-radius:6px;" alt="شعار">
      <% } %>
      <div>
        <div class="store-name"><%= settings.storeName %></div>
        <div class="store-details">
          <% if(settings.storeAddress) { %><i class="fa-solid fa-location-dot"></i> <%= settings.storeAddress %><br><% } %>
          <% if(settings.storePhone) { %><i class="fa-solid fa-phone"></i> <%= settings.storePhone %>&nbsp;&nbsp;<% } %>
          <% if(settings.storeEmail) { %><i class="fa-solid fa-envelope"></i> <%= settings.storeEmail %><% } %>
        </div>
      </div>
    </div>
    <div class="header-center">
      <div class="sale-title">مبيعة معرض</div>
      <div style="font-size:13px;color:#64748b;margin-top:3px;font-weight:600;">Showroom Sale</div>
    </div>
    <div class="header-left">
      <div class="meta-item"><span class="meta-label">رقم المبيعة:</span> <%= sale.saleNumber %></div>
      <div class="meta-item"><span class="meta-label">التاريخ:</span> <%= new Date(sale.saleDate).toLocaleDateString('ar-EG') %></div>
      <div class="meta-item"><span class="meta-label">الوقت:</span> <%= new Date(sale.saleDate).toLocaleTimeString('ar-EG', {hour:'2-digit',minute:'2-digit'}) %></div>
      <div class="meta-item" style="margin-top:4px;">
        <span class="status-badge status-<%= sale.status %>">
          <%= sale.status==='paid'?'✅ مكتملة':sale.status==='partial'?'🔶 مدفوعة جزئياً':'🔴 غير مدفوعة' %>
        </span>
      </div>
    </div>
  </div>

  <!-- بيانات الزبون -->
  <div class="party-strip">
    <div class="pi"><strong>الزبون: </strong><%= sale.customerName %></div>
    <% if(sale.customerPhone) { %><div class="pi"><strong>الهاتف: </strong><%= sale.customerPhone %></div><% } %>
    <% if(sale.notes) { %><div class="pi"><strong>ملاحظات: </strong><%= sale.notes %></div><% } %>
  </div>

  <!-- جدول الأصناف -->
  <table class="items-table">
    <thead>
      <tr>
        <th>#</th>
        <th>الصنف / البيان</th>
        <th>النوع</th>
        <th>الكمية/المقاس</th>
        <th>سعر الوحدة</th>
        <th>الخصم</th>
        <th>الإجمالي</th>
      </tr>
    </thead>
    <tbody>
      <% sale.items.forEach((item, i) => { %>
        <tr>
          <td><%= i+1 %></td>
          <td style="font-weight:700;"><%= item.description %></td>
          <td>
            <% if(item.quantityType==='piece') { %>كمية
            <% } else if(item.quantityType==='meter') { %>متر طولي
            <% } else { %>متر مربع<% } %>
          </td>
          <td>
            <% if(item.quantityType==='sqmeter') { %>
              <%= item.length %> × <%= item.width %> = <%= item.quantity.toFixed(2) %> م²
            <% } else if(item.quantityType==='meter') { %>
              <%= item.quantity.toFixed(2) %> م
            <% } else { %>
              <%= item.quantity %>
            <% } %>
          </td>
          <td><%= item.unitPrice.toLocaleString('ar-EG') %> ₪</td>
          <td><%= (item.discount||0).toLocaleString('ar-EG') %> ₪</td>
          <td style="font-weight:800;color:#dc2626;"><%= item.total.toLocaleString('ar-EG') %> ₪</td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <!-- الإجماليات -->
  <div class="totals-box">
    <div class="t-item"><span class="t-lbl">المجموع الفرعي</span><span class="t-val"><%= sale.subtotal.toLocaleString('ar-EG') %> ₪</span></div>
    <div style="color:#475569;font-size:18px;">−</div>
    <div class="t-item"><span class="t-lbl">الخصم</span><span class="t-val" style="color:#4ade80;"><%= sale.discount.toLocaleString('ar-EG') %> ₪</span></div>
    <div style="color:#475569;font-size:18px;">=</div>
    <div class="t-item"><span class="t-lbl">الإجمالي</span><span class="t-val" style="font-size:22px;"><%= sale.totalAmount.toLocaleString('ar-EG') %> ₪</span></div>
    <div style="margin-right:auto;">
      <div class="t-item"><span class="t-lbl">المحصّل</span><span class="t-val" style="color:#4ade80;font-size:18px;"><%= sale.paidAmount.toLocaleString('ar-EG') %> ₪</span></div>
    </div>
    <div class="t-item"><span class="t-lbl">المتبقي</span><span class="t-val" style="color:#f87171;font-size:18px;"><%= sale.remainingBalance.toLocaleString('ar-EG') %> ₪</span></div>
  </div>

  <!-- الدفعات -->
  <% if(sale.payments && sale.payments.length > 0) { %>
    <div style="font-size:13px;font-weight:800;margin-bottom:6px;"><i class="fa-solid fa-money-bill-wave me-1"></i> سجل الدفعات</div>
    <table class="pays-table">
      <thead>
        <tr><th>#</th><th>المبلغ</th><th>الطريقة</th><th>التاريخ</th><th>ملاحظات</th></tr>
      </thead>
      <tbody>
        <% sale.payments.forEach((p,i) => { %>
          <tr>
            <td><%= i+1 %></td>
            <td style="font-weight:700;color:#059669;"><%= p.amount.toLocaleString('ar-EG') %> ₪</td>
            <td>
              <% if(p.method==='cash') { %>نقداً
              <% } else if(p.method==='bank_transfer') { %>تحويل بنكي
              <% } else if(p.method==='check') { %>شيك <%= p.checkNumber ? '('+p.checkNumber+')' : '' %>
              <% } else { %>بطاقة<% } %>
            </td>
            <td><%= new Date(p.date).toLocaleDateString('ar-EG') %></td>
            <td><%= p.notes || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <!-- التوقيعات -->
  <div class="sig-row">
    <div class="sig-box">توقيع الزبون</div>
    <div class="sig-box">توقيع الموظف</div>
    <div class="sig-box">الختم</div>
  </div>
</div>

<%- include('../partials/admin-footer') %>
