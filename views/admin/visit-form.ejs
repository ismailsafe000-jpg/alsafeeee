function renderPhotos() {
  const grid = document.getElementById('photosGrid');
  if (!grid) return;
  grid.innerHTML = photos.map((p, i) => `
  <div class="photo-item">
    <img src="${esc(p.url)}" alt="">
    <button class="photo-del" onclick="delPhoto(${i})"><i class="fa-solid fa-trash"></i></button>
  </div>`).join('');
}
async function uploadPhotos(input) {
  for (const file of [...input.files]) {
    const fd = new FormData(); fd.append('photo', file);
    const res = await fetch(`/admin/visits/upload-photo/${VISIT_ID}`, { method:'POST', body:fd });
    const data = await res.json();
    if (data.ok) { photos.push({ url:data.url, caption:'' }); renderPhotos(); showToast('✓ تم رفع الصورة'); }
    else showToast('فشل رفع الصورة','err');
  }
  input.value = '';
}
async function delPhoto(idx) {
  if (!confirm('حذف هذه الصورة؟')) return;
  const res = await fetch(`/admin/visits/delete-photo/${VISIT_ID}`, {
    method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({index:idx})
  });
  const data = await res.json();
  if (data.ok) { photos.splice(idx,1); renderPhotos(); showToast('تم الحذف ✓'); }
}

// ===== TOTAL CALCULATIONS =====
function calcTotalCarpet() {
  let total = 0;
  rooms.forEach(r => { total += (r.area || 0); });
  return total;
}

function calcTotalCurtains() {
  let total = 0;
  let totalCount = 0;
  let details = [];
  let totalPrice = 0;
  windows.forEach((w, i) => {
    const itemTotal = (w.width||0) * (w.count||1);
    total += itemTotal;
    totalCount += (w.count||1);
    totalPrice += itemTotal * (w.pricePerMeter||0);
    if (w.width > 0 && w.count > 0) {
      details.push(`${w.location||'شباك'} ${w.count}×${w.width}=${itemTotal.toFixed(2)}م`);
    }
  });
  return { total, totalCount, details, totalPrice };
}

function renderTotals() {
  document.querySelectorAll('.total-summary').forEach(el => el.remove());
  
  // إجمالي الموكيت
  if (rooms.length > 0) {
    const carpetSec = document.querySelector('#panel-carpet .sec');
    if (carpetSec) {
      const div = document.createElement('div');
      div.className = 'total-summary';
      let totalArea = 0;
      let totalPrice = 0;
      rooms.forEach(r => {
        totalArea += (r.area || 0);
        totalPrice += (r.area || 0) * (r.pricePerMeter || 0);
      });
      div.innerHTML = `
        <div class="total-item" style="flex-wrap:wrap;">
          <i class="fa-solid fa-border-all"></i>
          <span>إجمالي الموكيت:</span>
          <span class="total-value">${totalArea.toFixed(2)}</span>
          <span class="total-unit">م²</span>
          <span class="total-count">(${rooms.length} غرفة)</span>
          <span style="color:#d4af37;font-size:13px;margin-right:10px;">| الإجمالي: ${totalPrice.toFixed(2)} ₪</span>
        </div>
      `;
      const roomList = document.getElementById('roomList');
      if (roomList) {
        roomList.parentNode.insertBefore(div, roomList.nextSibling);
      }
    }
  }
  
  // إجمالي البرادي
  if (windows.length > 0) {
    const winSec = document.querySelector('#panel-windows .sec');
    if (winSec) {
      const result = calcTotalCurtains();
      let detailsHtml = '';
      if (result.details.length > 0) {
        detailsHtml = `<div style="font-size:11px;color:var(--text-muted);margin-top:5px;padding-top:5px;border-top:1px dashed rgba(212,175,55,.2);">`;
        detailsHtml += result.details.map(d => `<div>• ${d}</div>`).join('');
        detailsHtml += `</div>`;
      }
      
      const div = document.createElement('div');
      div.className = 'total-summary';
      div.innerHTML = `
        <div class="total-item" style="flex-wrap:wrap;">
          <i class="fa-solid fa-window-maximize"></i>
          <span>إجمالي البرادي:</span>
          <span class="total-value">${result.total.toFixed(2)}</span>
          <span class="total-unit">م</span>
          <span class="total-count">(${result.totalCount} قطعة - ${windows.length} نوع)</span>
          <span style="color:#d4af37;font-size:13px;margin-right:10px;">| الإجمالي: ${result.totalPrice.toFixed(2)} ₪</span>
        </div>
        ${detailsHtml}
      `;
      const winList = document.getElementById('windowList');
      if (winList) {
        winList.parentNode.insertBefore(div, winList.nextSibling);
      }
    }
  }
}

// ===== CANVAS ENGINE =====
const cvs = {
  qc: document.getElementById('cvQaada'),
  wc: document.getElementById('cvWin')
};
const ctxs = { qc: cvs.qc.getContext('2d'), wc: cvs.wc.getContext('2d') };
const cvState = {
  qc: { tool:'pencil', color:'#1e293b', size:3, drawing:false, sx:0, sy:0, snap:null, undo:[] },
  wc: { tool:'pencil', color:'#1e293b', size:3, drawing:false, sx:0, sy:0, snap:null, undo:[] }
};

function initCV(id) {
  const ctx = ctxs[id];
  ctx.fillStyle = 'white'; ctx.fillRect(0,0,cvs[id].width,cvs[id].height);
  saveCVState(id);
}
function saveCVState(id) {
  const st = cvState[id];
  st.undo.push(ctxs[id].getImageData(0,0,cvs[id].width,cvs[id].height));
  if (st.undo.length > 25) st.undo.shift();
}
function undoCV(id) {
  const st = cvState[id];
  if (st.undo.length > 1) { st.undo.pop(); ctxs[id].putImageData(st.undo[st.undo.length-1],0,0); }
}
function clearCV(id) {
  if (confirm('مسح الرسم كاملاً؟')) {
    cvState[id].undo = [];
    ctxs[id].fillStyle = 'white'; ctxs[id].fillRect(0,0,cvs[id].width,cvs[id].height);
    saveCVState(id);
  }
}
function setCTool(t, id, btn) {
  cvState[id].tool = t;
  const container = document.getElementById(id + 'Tools');
  container.querySelectorAll('.ctool').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
}
function getPos(e, id) {
  const r = cvs[id].getBoundingClientRect();
  const sx = cvs[id].width / r.width, sy = cvs[id].height / r.height;
  const cx = e.touches ? e.touches[0].clientX : e.clientX;
  const cy = e.touches ? e.touches[0].clientY : e.clientY;
  return { x:(cx-r.left)*sx, y:(cy-r.top)*sy };
}

function drawAngle(ctx, x, y, endX, endY, color, size) {
  const dx = endX - x;
  const dy = endY - y;
  const length = Math.sqrt(dx*dx + dy*dy);
  const maxLength = 200;
  const actualLength = Math.min(length, maxLength);
  
  const hLength = actualLength * 0.7;
  const vLength = actualLength * 0.7;
  
  ctx.strokeStyle = color;
  ctx.lineWidth = size;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  
  ctx.beginPath();
  ctx.moveTo(x, y);
  ctx.lineTo(x + hLength, y);
  ctx.stroke();
  
  ctx.beginPath();
  ctx.moveTo(x, y);
  ctx.lineTo(x, y + vLength);
  ctx.stroke();
  
  const cornerSize = 15;
  ctx.beginPath();
  ctx.moveTo(x + cornerSize, y);
  ctx.lineTo(x + cornerSize, y + cornerSize);
  ctx.lineTo(x, y + cornerSize);
  ctx.stroke();
  
  const endpoints = [
    { x: x + hLength, y: y },
    { x: x, y: y + vLength }
  ];
  ctx.fillStyle = '#3b82f6';
  endpoints.forEach(p => {
    ctx.beginPath();
    ctx.arc(p.x, p.y, 4, 0, 2 * Math.PI);
    ctx.fill();
  });
}

function startDraw(e, id) {
  const st = cvState[id]; 
  const p = getPos(e,id);
  st.drawing = true;
  st.sx = p.x;
  st.sy = p.y;
  const ctx = ctxs[id];
  
  saveCVState(id);
  
  if (st.tool === 'pencil' || st.tool === 'eraser') {
    ctx.beginPath();
    ctx.moveTo(p.x, p.y);
    ctx.strokeStyle = st.tool === 'eraser' ? 'white' : st.color;
    ctx.lineWidth = st.tool === 'eraser' ? st.size * 4 : st.size;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
  } else {
    st.snap = ctx.getImageData(0, 0, cvs[id].width, cvs[id].height);
  }
}

function doDraw(e, id) {
  const st = cvState[id];
  if (!st.drawing) return;
  const p = getPos(e, id);
  const ctx = ctxs[id];
  
  if (st.tool === 'pencil' || st.tool === 'eraser') {
    ctx.lineTo(p.x, p.y);
    ctx.stroke();
  } else {
    ctx.putImageData(st.snap, 0, 0);
    
    if (st.tool === 'line') {
      ctx.beginPath();
      ctx.strokeStyle = st.color;
      ctx.lineWidth = st.size;
      ctx.moveTo(st.sx, st.sy);
      ctx.lineTo(p.x, p.y);
      ctx.stroke();
    } else if (st.tool === 'rect') {
      ctx.strokeStyle = st.color;
      ctx.lineWidth = st.size;
      ctx.strokeRect(st.sx, st.sy, p.x - st.sx, p.y - st.sy);
    } else if (st.tool === 'circle') {
      ctx.strokeStyle = st.color;
      ctx.lineWidth = st.size;
      const rx = (p.x - st.sx) / 2;
      const ry = (p.y - st.sy) / 2;
      ctx.beginPath();
      ctx.ellipse(st.sx + rx, st.sy + ry, Math.abs(rx), Math.abs(ry), 0, 0, 2 * Math.PI);
      ctx.stroke();
    } else if (st.tool === 'angle') {
      drawAngle(ctx, st.sx, st.sy, p.x, p.y, st.color, st.size);
    }
  }
}

function endDraw(id) {
  const st = cvState[id];
  if (st.drawing) {
    st.drawing = false;
    saveCVState(id);
  }
}

// Bind canvases
['qc', 'wc'].forEach(id => {
  cvs[id].addEventListener('mousedown', e => startDraw(e, id));
  cvs[id].addEventListener('mousemove', e => doDraw(e, id));
  cvs[id].addEventListener('mouseup', () => endDraw(id));
  cvs[id].addEventListener('mouseleave', () => endDraw(id));
  cvs[id].addEventListener('touchstart', e => { e.preventDefault(); startDraw(e, id); }, { passive: false });
  cvs[id].addEventListener('touchmove', e => { e.preventDefault(); doDraw(e, id); }, { passive: false });
  cvs[id].addEventListener('touchend', () => endDraw(id));
  
  function resize() {
    const w = Math.min(cvs[id].parentElement.offsetWidth - 2, 880);
    cvs[id].style.width = w + 'px';
  }
  resize();
  window.addEventListener('resize', resize);
});

// Load saved canvas data
const savedQaada = `<%- (vData.qaadaCanvasData || '').replace(/`/g,'\\`') %>`;
const savedWin   = `<%- (vData.windowsCanvasData || '').replace(/`/g,'\\`') %>`;

function loadCV(id, data) {
  if (data) {
    const img = new Image();
    img.onload = () => { ctxs[id].drawImage(img, 0, 0); saveCVState(id); };
    img.src = data;
  } else {
    initCV(id);
  }
}
loadCV('qc', savedQaada);
loadCV('wc', savedWin);

// ===== SAVE =====
async function saveVisit() {
  const btn = document.querySelector('.btn-save');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جاري الحفظ...';
  
  const payload = {
    sofas, qaadas,
    qaadaCanvasData: cvs.qc.toDataURL('image/png'),
    rooms, windows,
    windowsCanvasData: cvs.wc.toDataURL('image/png'),
    generalNotes: document.getElementById('generalNotes').value,
    visitDate: document.getElementById('visitDateInput').value
  };
  
  const url = IS_NEW
    ? `/admin/customers/${CUST_ID}/visits`
    : `/admin/customers/${CUST_ID}/visits/${VISIT_ID}/update`;
  
  try {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    
    if (data.ok) {
      if (IS_NEW) {
        showToast('✓ تم الحفظ، سيتم تحويلك لصفحة التعديل...');
        setTimeout(() => {
          window.location.href = `/admin/customers/${CUST_ID}/visits/${data.visitId}/edit`;
        }, 1500);
      } else {
        showToast('✓ تم حفظ الزيارة بنجاح');
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> حفظ الزيارة';
      }
    } else {
      showToast('خطأ: ' + data.error, 'err');
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> حفظ الزيارة';
    }
  } catch(e) {
    showToast('خطأ في الاتصال', 'err');
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> حفظ الزيارة';
  }
}

// ===== INIT =====
renderSofas();
renderQaadas();
renderRooms();
renderWins();
renderPhotos();
renderTotals();
</script>

