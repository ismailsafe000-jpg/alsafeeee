// ===== IMAGE UPLOAD =====
async function uploadImgFor(input, type, idx, previewId) {
  if (!input.files[0]) return;
  const fd = new FormData(); fd.append('image', input.files[0]);
  const vidForUpload = VISIT_ID || 'none';
  const res = await fetch(`/admin/visits/upload-style/${vidForUpload}/${type}/${idx}`, { method:'POST', body:fd });
  const data = await res.json();
  if (data.ok) {
    const img = document.getElementById(previewId);
    if (img) { img.src = data.url; img.style.display = 'block'; }
    if (type === 'sofa')  sofas[idx].styleImage  = data.url;
    if (type === 'qaada') qaadas[idx].styleImage  = data.url;
  } else showToast('فشل رفع الصورة', 'err');
}

async function uploadCurtainImg(input, idx) {
  if (!input.files[0]) return;
  const fd = new FormData(); fd.append('image', input.files[0]);
  const vidForUpload = VISIT_ID || 'none';
  const res = await fetch(`/admin/visits/upload-curtain/${vidForUpload}/${idx}`, { method:'POST', body:fd });
  const data = await res.json();
  if (data.ok) {
    windows[idx].curtainTypeImage = data.url;
    renderWins();
  } else showToast('فشل رفع الصورة', 'err');
}

