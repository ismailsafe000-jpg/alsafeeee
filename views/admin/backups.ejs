<%- include('../partials/admin-header') %>

<div class="page-header">
  <div class="page-header-left">
    <h1 class="page-title"><i class="fa-solid fa-database"></i> النسخ الاحتياطية</h1>
    <p class="page-sub">إدارة واستعادة نسخ قاعدة البيانات</p>
  </div>
  <div class="page-header-right">
    <form action="/admin/backups/create" method="POST" style="display:inline">
      <button type="submit" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> إنشاء نسخة الآن
      </button>
    </form>
  </div>
</div>

<%- include('../partials/messages') %>

<!-- Auto-backup info -->
<div class="info-card mb-4" style="background:rgba(99,102,241,.08);border:1px solid rgba(99,102,241,.2);border-radius:12px;padding:16px 20px;display:flex;align-items:center;gap:14px;">
  <div style="width:42px;height:42px;border-radius:10px;background:rgba(99,102,241,.15);display:flex;align-items:center;justify-content:center;font-size:18px;color:#6366f1;flex-shrink:0;">
    <i class="fa-solid fa-clock-rotate-left"></i>
  </div>
  <div>
    <div style="font-weight:700;font-size:14px;color:var(--text);">نسخ احتياطي تلقائي مفعّل</div>
    <div style="font-size:12px;color:var(--text-2);">يتم إنشاء نسخة احتياطية تلقائياً كل يوم في الساعة 2:00 صباحاً — يتم الاحتفاظ بآخر 7 نسخ</div>
  </div>
</div>

<% if (backups.length === 0) { %>
  <div class="empty-state" style="text-align:center;padding:60px 20px;color:var(--text-2);">
    <i class="fa-solid fa-box-open" style="font-size:48px;opacity:.3;display:block;margin-bottom:16px;"></i>
    <p style="font-size:15px;font-weight:600;">لا توجد نسخ احتياطية بعد</p>
    <p style="font-size:13px;margin-top:6px;">اضغط "إنشاء نسخة الآن" لإنشاء أول نسخة احتياطية</p>
  </div>
<% } else { %>
  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>#</th>
              <th>اسم الملف</th>
              <th>الحجم</th>
              <th>تاريخ الإنشاء</th>
              <th>النوع</th>
              <th>الإجراءات</th>
            </tr>
          </thead>
          <tbody>
            <% backups.forEach((b, i) => { %>
              <tr>
                <td><%= i + 1 %></td>
                <td>
                  <div style="display:flex;align-items:center;gap:8px;">
                    <i class="fa-solid fa-file-code" style="color:#6366f1;font-size:15px;"></i>
                    <span style="font-family:monospace;font-size:13px;"><%= b.name %></span>
                  </div>
                </td>
                <td><span class="badge bg-secondary"><%= b.size %></span></td>
                <td style="white-space:nowrap;">
                  <%= new Date(b.createdAt).toLocaleString('ar-SA', {year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}) %>
                </td>
                <td>
                  <% if (b.name.startsWith('auto-')) { %>
                    <span class="status-badge" style="background:rgba(16,185,129,.1);color:#10b981;">تلقائي</span>
                  <% } else { %>
                    <span class="status-badge" style="background:rgba(99,102,241,.1);color:#6366f1;">يدوي</span>
                  <% } %>
                </td>
                <td>
                  <div style="display:flex;gap:6px;flex-wrap:wrap;">
                    <a href="/admin/backups/download/<%= b.name %>" class="btn btn-sm btn-outline-primary" title="تحميل">
                      <i class="fa-solid fa-download"></i>
                    </a>
                    <form action="/admin/backups/restore/<%= b.name %>" method="POST" style="display:inline"
                          onsubmit="return confirm('هل أنت متأكد من الاستعادة من هذه النسخة؟ سيتم دمج البيانات مع الموجودة.')">
                      <button type="submit" class="btn btn-sm btn-outline-success" title="استعادة">
                        <i class="fa-solid fa-rotate-right"></i>
                      </button>
                    </form>
                    <form action="/admin/backups/delete/<%= b.name %>" method="POST" style="display:inline"
                          onsubmit="return confirm('حذف هذه النسخة نهائياً؟')">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<%- include('../partials/admin-footer') %>
