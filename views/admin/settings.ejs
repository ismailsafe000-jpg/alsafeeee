        </div>
      </div>

      <!-- معلومات الإصدار -->
      <div style="background:var(--bg-2);border-radius:10px;padding:16px 18px;margin-bottom:20px;">
        <div style="font-size:13px;font-weight:800;color:var(--text);margin-bottom:10px;">
          <i class="fa-solid fa-circle-info me-2" style="color:var(--primary);"></i>معلومات الإصدار
        </div>
