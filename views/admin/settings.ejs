          <div class="col-md-3"><span style="color:var(--text-2);">الإصدار:</span> <strong>v<%= settings.systemVersion || '2.0.0' %></strong></div>
          <div class="col-md-3"><span style="color:var(--text-2);">Node.js:</span> <strong><%= process.version %></strong></div>
          <div class="col-md-3"><span style="color:var(--text-2);">البيئة:</span> <strong><%= process.env.NODE_ENV || 'development' %></strong></div>
          <div class="col-md-3"><span style="color:var(--text-2);">المنصة:</span> <strong><%= process.platform %></strong></div>
        </div>
      </div>

      <!-- أدوات النظام -->
      <div style="font-size:13px;font-weight:800;color:var(--text);margin-bottom:12px;">
        <i class="fa-solid fa-toolbox me-2" style="color:var(--primary);"></i>أدوات النظام
      </div>
      <div class="d-flex flex-wrap gap-3">
        <button type="button" class="btn btn-outline-warning" onclick="doSystemAction('/admin/clear-cache','مسح الكاش؟')">
