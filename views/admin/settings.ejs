          </div>
        </div>
      </div>
    </div>

    <!-- ===== 9. إعدادات الطباعة ===== -->
    <div class="settings-section" id="print">
      <h5>
        <i class="fa-solid fa-print" style="color:#d4af37;"></i>
        إعدادات الطباعة
      </h5>

      <!-- حجم الورق لكل مستند -->
      <div class="mb-4">
        <div style="font-size:13px;font-weight:800;color:var(--text);margin-bottom:12px;">
          <i class="fa-solid fa-file me-2" style="color:var(--primary);"></i>حجم الورق لكل مستند
        </div>
        <div class="row g-3">
          <% const printDocs = [
            { name:'invoicePrintSize',   label:'الفاتورة',      opts:['A4','A5','Thermal'] },
            { name:'receiptPrintSize',   label:'سند القبض',     opts:['A4','A5','R80','R58'] },
            { name:'paymentPrintSize',   label:'سند الصرف',     opts:['A4','A5','R80','R58'] },
            { name:'statementPrintSize', label:'كشف الحساب',    opts:['A4','A5'] },
            { name:'salePrintSize',      label:'عقد البيع',     opts:['A4','A5'] },
            { name:'visitPrintSize',     label:'سجل الزيارة',   opts:['A4','A5'] },
          ]; %>
