        </button>
        <button type="button" class="btn btn-outline-info" onclick="doSystemAction('/admin/rebuild-indexes','إعادة بناء الفهارس؟ قد يستغرق وقتاً.')">
          <i class="fa-solid fa-database me-2"></i>إعادة بناء الفهارس
        </button>
        <a href="/admin/backup/download" class="btn btn-outline-danger" target="_blank">
          <i class="fa-solid fa-file-pdf me-2"></i>تنزيل نسخة PDF الآن
        </a>
      </div>
    </div>

    <!-- زر الحفظ -->
    <div class="save-bar">
      <button type="submit" class="btn btn-gold px-5">
        <i class="fa-solid fa-floppy-disk me-2"></i> حفظ جميع الإعدادات
      </button>
      <a href="/admin/voucher-settings" class="btn btn-outline-primary">
        <i class="fa-solid fa-receipt me-1"></i> إعدادات سندات القبض والصرف
      </a>
      <a href="/admin/dashboard" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-right me-1"></i> رجوع
      </a>
    </div>

  </form>
</div>

<script>
function setColor(inputName, hex, valId, previewId){
  document.querySelector('input[name="'+inputName+'"]').value = hex;
  document.getElementById(valId).textContent = hex;
  document.getElementById(previewId).style.background = hex;
}
function pickTheme(val, el){
  document.querySelectorAll('.theme-pick-btn').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
  el.querySelector('input').checked = true;
}
function pickFont(val, el){
  document.querySelectorAll('.font-pick-btn').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
  el.querySelector('input').checked = true;
}
function doSystemAction(url, msg){
  if(!confirm(msg)) return;
  fetch(url, { method:'POST', headers:{'Content-Type':'application/json'} })
    .then(function(r){ return r.redirected ? window.location.href = r.url : r.text(); })
    .then(function(){ window.location.reload(); })
    .catch(function(e){ alert('خطأ: ' + e.message); });
}

/* ── خلفية لوحة التحكم ── */
function previewBg(input) {
  if (!input.files || !input.files[0]) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    const zone = document.getElementById('bgDropZone');
    zone.style.backgroundImage = 'url(' + e.target.result + ')';
    zone.style.backgroundSize = 'cover';
    zone.style.backgroundPosition = 'center';
    // remove old thumb image if any
    const old = zone.querySelector('.bg-current-thumb');
    if (old) old.remove();
    // ensure overlay label exists
    let lbl = zone.querySelector('.bg-overlay-label');
    if (!lbl) {
      lbl = document.createElement('div');
      lbl.className = 'bg-overlay-label';
      lbl.textContent = 'انقر لتغيير الخلفية';
      zone.appendChild(lbl);
    }
    // clear gradient field
    document.getElementById('adminBgGradient').value = '';
    // clear preset selection
    document.querySelectorAll('.bg-preset').forEach(p => p.classList.remove('selected'));
  };
  reader.readAsDataURL(input.files[0]);
}

function setGradientBg(gradient) {
  const zone = document.getElementById('bgDropZone');
  zone.style.backgroundImage = gradient;
  zone.style.backgroundSize = '100%';
  zone.style.backgroundPosition = 'center';
  const old = zone.querySelector('.bg-current-thumb');
  if (old) old.remove();
  let lbl = zone.querySelector('.bg-overlay-label');
  if (lbl) lbl.style.display = 'none';
  // store gradient in hidden field
  document.getElementById('adminBgGradient').value = gradient;
  // clear file input
  document.getElementById('adminBgInput').value = '';
  // highlight selected preset
  document.querySelectorAll('.bg-preset').forEach(p => {
    p.classList.toggle('selected', p.getAttribute('onclick') && p.getAttribute('onclick').includes(gradient.slice(0,30)));
  });
}

function clearBg() {
  const zone = document.getElementById('bgDropZone');
  zone.style.backgroundImage = '';
  const old = zone.querySelector('.bg-current-thumb');
  if (old) old.remove();
  let lbl = zone.querySelector('.bg-overlay-label');
  if (lbl) lbl.style.display = 'none';
  document.getElementById('adminBgGradient').value = '__clear__';
  document.getElementById('adminBgInput').value = '';
  // show empty state
  if (!zone.querySelector('.bg-empty-state')) {
    const es = document.createElement('div');
    es.className = 'bg-empty-state';
    es.innerHTML = '<i class="fa-solid fa-cloud-arrow-up fa-2x mb-2" style="color:var(--primary);opacity:.7;"></i><div style="font-weight:700;font-size:13px;">اسحب صورة أو انقر للرفع</div><div style="font-size:11.5px;color:var(--text-muted);margin-top:4px;">JPG · PNG · WEBP · حتى 5 ميغا</div>';
    zone.appendChild(es);
  }
  document.querySelectorAll('.bg-preset').forEach(p => p.classList.remove('selected'));
}

/* Drag-and-drop on upload zone */
(function(){
  const zone = document.getElementById('bgDropZone');
  if (!zone) return;
  ['dragover','dragenter'].forEach(ev => zone.addEventListener(ev, e => { e.preventDefault(); zone.style.borderColor='var(--primary)'; }));
  ['dragleave','drop'].forEach(ev => zone.addEventListener(ev, e => { zone.style.borderColor=''; }));
  zone.addEventListener('drop', function(e) {
    e.preventDefault();
    const file = e.dataTransfer.files[0];
    if (!file || !file.type.startsWith('image/')) return;
    const dt = new DataTransfer();
    dt.items.add(file);
    const inp = document.getElementById('adminBgInput');
    inp.files = dt.files;
    previewBg(inp);
  });
})();
</script>
