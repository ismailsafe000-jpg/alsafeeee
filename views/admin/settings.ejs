          <div class="col-md-4">
            <label class="form-label"><%= doc.label %></label>
            <select name="<%= doc.name %>" class="form-select">
              <% doc.opts.forEach(function(o){ %>
              <option value="<%= o %>" <%= (settings[doc.name]||'A4')===o?'selected':'' %>><%= o %></option>
              <% }); %>
