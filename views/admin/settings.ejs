<%- include('../partials/admin-header') %>
<style>
  .settings-wrap { max-width: 860px; margin: 0 auto; }
  .settings-section {
    background: var(--card-bg);
    border-radius: 14px;
    border: 1px solid var(--border-color);
    padding: 24px 28px;
    margin-bottom: 20px;
    box-shadow: var(--shadow-soft);
  }
  .settings-section h5 {
    font-size: 15px; font-weight: 800; color: var(--text-main);
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 10px; margin-bottom: 18px;
    display: flex; align-items: center; gap: 8px;
  }
  .form-label { font-weight: 700; font-size: 13px; color: var(--text-main); margin-bottom: 5px; }
  .form-hint { font-size: 11px; color: var(--text-muted); margin-top: 4px; }

  .switch-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 13px 0; border-bottom: 1px solid var(--border-color);
    gap: 12px;
  }
  .switch-row:last-of-type { border-bottom: none; }
  .switch-info .sw-title { font-size: 14px; font-weight: 700; color: var(--text-main); }
  .switch-info .sw-desc { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
  .portal-name-row {
    margin-top: 10px; padding: 12px 16px;
    background: var(--table-hover); border-radius: 10px;
    border: 1px solid var(--border-color);
  }
  .portal-name-row label { font-size: 12px; font-weight: 700; color: var(--text-muted); margin-bottom: 5px; display: block; }

  .form-check-input { width: 40px; height: 22px; cursor: pointer; }
  .form-check-input:checked { background-color: #d4af37; border-color: #d4af37; }

  .logo-preview-wrap {
    display: flex; align-items: center; gap: 12px; margin-top: 10px;
  }
  .logo-preview-wrap img {
    height: 60px; border-radius: 10px; border: 2px solid var(--border-color); object-fit: contain;
  }
  .logo-preview-wrap .remove-logo-btn {
    font-size: 12px; color: #dc2626; background: rgba(220,38,38,0.08);
    border: 1px solid rgba(220,38,38,0.2); border-radius: 8px;
    padding: 4px 10px; cursor: pointer; text-decoration: none;
  }

  .color-preview {
    width: 32px; height: 32px; border-radius: 8px; border: 2px solid var(--border-color);
    display: inline-block; vertical-align: middle; margin-right: 8px;
  }

  .section-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(212,175,55,0.12); color: #d4af37;
    font-size: 11px; font-weight: 700; padding: 3px 10px;
    border-radius: 20px; margin-right: 8px;
  }

  .save-bar {
    position: sticky; bottom: 0; z-index: 100;
    background: var(--card-bg); border-top: 1px solid var(--border-color);
    padding: 16px 0; margin-top: 8px;
    display: flex; gap: 12px; align-items: center;
  }

  /* ── عناصر المظهر ── */
  .color-pick-row { display:flex; align-items:center; gap:12px; margin-top:6px; }
  .color-big-input { width:56px; height:48px; padding:3px; border-radius:10px; border:2px solid var(--border-color); cursor:pointer; }
  .color-swatch { width:48px; height:48px; border-radius:10px; border:2px solid var(--border-color); }
  .color-presets { display:flex; flex-wrap:wrap; gap:7px; }
  .color-presets span { width:28px; height:28px; border-radius:7px; cursor:pointer; transition:.15s; display:inline-block; }
  .color-presets span:hover { transform:scale(1.2); box-shadow:0 2px 8px rgba(0,0,0,.25); }

  .theme-pick-btn {
    display:inline-flex; flex-direction:column; align-items:center; justify-content:center;
    gap:4px; padding:12px 22px; border-radius:12px; cursor:pointer; font-size:13px; font-weight:700;
    border:2px solid var(--border-color); background:var(--bg-2); color:var(--text-2);
    transition:.15s;
  }
  .theme-pick-btn.active { border-color:var(--primary); background:var(--primary-light); color:var(--primary); }
  .theme-pick-btn:hover:not(.active) { border-color:var(--primary); }

  .font-options { display:flex; flex-direction:column; gap:7px; }
  .font-pick-btn {
    display:block; padding:9px 14px; border-radius:10px; cursor:pointer; font-size:14px;
    border:2px solid var(--border-color); background:var(--bg-2); color:var(--text-2);
    transition:.15s; text-align:right;
  }
  .font-pick-btn.active { border-color:var(--primary); background:var(--primary-light); color:var(--primary); font-weight:700; }
  .font-pick-btn:hover:not(.active) { border-color:var(--primary); }

  /* ── خلفية لوحة التحكم ── */
  .bg-builder { display:flex; flex-direction:column; gap:0; }

  .bg-upload-zone {
    width:100%; height:160px;
    border:2px dashed var(--border-color);
    border-radius:14px;
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; overflow:hidden; position:relative;
    background:var(--bg-2);
    transition: border-color .2s, background .2s;
  }
  .bg-upload-zone:hover { border-color:var(--primary); background:var(--primary-light); }
  .bg-current-thumb {
    width:100%; height:100%; object-fit:cover;
    position:absolute; inset:0;
  }
  .bg-overlay-label {
    position:absolute; inset:0;
    display:flex; align-items:center; justify-content:center;
    background:rgba(0,0,0,0.45);
    color:#fff; font-size:13px; font-weight:800;
    opacity:0; transition:opacity .2s;
  }
  .bg-upload-zone:hover .bg-overlay-label { opacity:1; }
  .bg-empty-state { text-align:center; color:var(--text-muted); }

  .bg-presets {
    display:flex; flex-wrap:wrap; gap:8px;
  }
  .bg-preset {
    width:44px; height:44px; border-radius:10px; cursor:pointer;
    transition:.15s; border:2px solid transparent;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
  }
  .bg-preset:hover { transform:scale(1.12); box-shadow:0 3px 10px rgba(0,0,0,.3); }
  .bg-preset.selected { border-color:var(--primary); box-shadow:0 0 0 3px var(--primary-light); }

  @media (max-width: 768px) {
    .settings-section { padding: 18px 16px; }
    .switch-row { flex-wrap: wrap; }
  }
</style>

<div class="settings-wrap">
  <h2 class="section-title mb-4">
    <i class="fa-solid fa-gear"></i> إعدادات النظام
  </h2>

  <form action="/admin/settings" method="POST" enctype="multipart/form-data">

    <!-- ===== 1. معلومات المعرض ===== -->
    <div class="settings-section">
      <h5>
        <i class="fa-solid fa-store" style="color:#d4af37;"></i>
        معلومات المعرض
        <span class="section-badge"><i class="fa-solid fa-star fa-xs"></i> أساسي</span>
      </h5>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">اسم المعرض / النظام</label>
          <input name="storeName" class="form-control" value="<%= settings.storeName %>" required placeholder="مثال: معرض الصافي للمفروشات">
          <div class="form-hint">يظهر في الصفحة الرئيسية والفواتير</div>
        </div>
        <div class="col-md-6">
          <label class="form-label">العنوان الفرعي للنظام</label>
          <input name="systemTitle" class="form-control" value="<%= settings.systemTitle || 'نظام إدارة متكامل وعصري' %>" placeholder="مثال: نظام إدارة متكامل وعصري">
          <div class="form-hint">يظهر أسفل اسم المعرض في صفحة الدخول</div>
        </div>
        <div class="col-md-4">
          <label class="form-label">هاتف المعرض</label>
          <input name="storePhone" class="form-control" value="<%= settings.storePhone || '' %>" placeholder="+972-XX-XXXXXXX">
        </div>
        <div class="col-md-4">
          <label class="form-label">واتساب المعرض</label>
          <input name="storeWhatsapp" class="form-control" value="<%= settings.storeWhatsapp || '' %>" placeholder="+972XXXXXXXXX">
          <div class="form-hint">يُستخدم في أزرار واتساب للمنتجات</div>
        </div>
        <div class="col-md-4">
          <label class="form-label">البريد الإلكتروني</label>
          <input name="storeEmail" class="form-control" type="email" value="<%= settings.storeEmail || '' %>" placeholder="info@example.com">
        </div>
        <div class="col-md-12">
          <label class="form-label">عنوان المعرض</label>
          <textarea name="storeAddress" class="form-control" rows="2" placeholder="اكتب العنوان كاملاً..."><%= settings.storeAddress || '' %></textarea>
        </div>
        <div class="col-md-6">
          <label class="form-label">نص التذييل (Footer)</label>
          <input name="footerText" class="form-control" value="<%= settings.footerText || '' %>" placeholder="مثال: جميع البيانات آمنة ومحمية">
          <div class="form-hint">يظهر أسفل صفحة الدخول</div>
        </div>
      </div>
    </div>

    <!-- ===== 2. المظهر والهوية البصرية ===== -->
    <div class="settings-section">
      <h5>
        <i class="fa-solid fa-palette" style="color:#d4af37;"></i>
        المظهر والهوية البصرية
        <span class="section-badge"><i class="fa-solid fa-wand-magic-sparkles fa-xs"></i> تخصيص كامل</span>
      </h5>
      <div class="row g-4">

        <!-- الشعار -->
        <div class="col-md-6">
          <label class="form-label"><i class="fa-solid fa-image me-1"></i> شعار المعرض</label>
          <input type="file" name="storeLogo" class="form-control" accept="image/*">
          <div class="form-hint">PNG أو JPG — يظهر في الشريط الجانبي والفواتير</div>
          <% if(settings.storeLogo && settings.storeLogo !== '/images/default-logo.png'){ %>
            <div class="logo-preview-wrap mt-2">
              <img src="<%= settings.storeLogo %>" alt="شعار المعرض">
              <div style="font-size:12px;color:var(--text-muted);">الشعار الحالي</div>
            </div>
          <% } %>
        </div>

        <!-- الوضع الافتراضي -->
        <div class="col-md-6">
          <label class="form-label"><i class="fa-solid fa-circle-half-stroke me-1"></i> الوضع الافتراضي عند الدخول</label>
          <div class="d-flex gap-3 mt-2">
            <label class="theme-pick-btn <%= (settings.defaultTheme||'light')==='light' ? 'active' : '' %>" onclick="pickTheme('light',this)">
              <input type="radio" name="defaultTheme" value="light" <%= (settings.defaultTheme||'light')==='light' ? 'checked' : '' %> style="display:none;">
              <i class="fa-solid fa-sun fa-lg mb-1"></i><br>فاتح
            </label>
            <label class="theme-pick-btn <%= (settings.defaultTheme||'light')==='dark' ? 'active' : '' %>" onclick="pickTheme('dark',this)">
              <input type="radio" name="defaultTheme" value="dark" <%= settings.defaultTheme==='dark' ? 'checked' : '' %> style="display:none;">
              <i class="fa-solid fa-moon fa-lg mb-1"></i><br>داكن
            </label>
          </div>
        </div>

        <!-- اللون الرئيسي -->
        <div class="col-md-4">
          <label class="form-label"><i class="fa-solid fa-droplet me-1"></i> اللون الرئيسي</label>
          <div class="color-pick-row">
            <input type="color" name="primaryColor" id="primaryColorPicker"
                   class="color-big-input"
                   value="<%= settings.primaryColor || '#4F46E5' %>"
                   oninput="document.getElementById('primaryColorVal').textContent=this.value; document.getElementById('primaryPreview').style.background=this.value;">
            <div>
              <div id="primaryPreview" class="color-swatch" style="background:<%= settings.primaryColor || '#4F46E5' %>;"></div>
              <div class="form-hint mt-1" id="primaryColorVal"><%= settings.primaryColor || '#4F46E5' %></div>
            </div>
          </div>
          <div class="color-presets mt-2">
            <span onclick="setColor('primaryColor','#4F46E5','primaryColorVal','primaryPreview')" style="background:#4F46E5;" title="بنفسجي"></span>
            <span onclick="setColor('primaryColor','#0ea5e9','primaryColorVal','primaryPreview')" style="background:#0ea5e9;" title="سماوي"></span>
            <span onclick="setColor('primaryColor','#10b981','primaryColorVal','primaryPreview')" style="background:#10b981;" title="أخضر"></span>
            <span onclick="setColor('primaryColor','#f59e0b','primaryColorVal','primaryPreview')" style="background:#f59e0b;" title="ذهبي"></span>
            <span onclick="setColor('primaryColor','#ef4444','primaryColorVal','primaryPreview')" style="background:#ef4444;" title="أحمر"></span>
            <span onclick="setColor('primaryColor','#8b5cf6','primaryColorVal','primaryPreview')" style="background:#8b5cf6;" title="أرجواني"></span>
            <span onclick="setColor('primaryColor','#ec4899','primaryColorVal','primaryPreview')" style="background:#ec4899;" title="وردي"></span>
            <span onclick="setColor('primaryColor','#1e293b','primaryColorVal','primaryPreview')" style="background:#1e293b;" title="رمادي غامق"></span>
          </div>
        </div>

        <!-- لون الشريط الجانبي -->
        <div class="col-md-4">
          <label class="form-label"><i class="fa-solid fa-sidebar me-1"></i> لون الشريط الجانبي</label>
          <div class="color-pick-row">
            <input type="color" name="sidebarColor" id="sidebarColorPicker"
                   class="color-big-input"
                   value="<%= settings.sidebarColor || '#1E1B4B' %>"
                   oninput="document.getElementById('sidebarColorVal').textContent=this.value; document.getElementById('sidebarPreview').style.background=this.value;">
            <div>
              <div id="sidebarPreview" class="color-swatch" style="background:<%= settings.sidebarColor || '#1E1B4B' %>;"></div>
              <div class="form-hint mt-1" id="sidebarColorVal"><%= settings.sidebarColor || '#1E1B4B' %></div>
            </div>
          </div>
          <div class="color-presets mt-2">
            <span onclick="setColor('sidebarColor','#1E1B4B','sidebarColorVal','sidebarPreview')" style="background:#1E1B4B;" title="بنفسجي غامق"></span>
            <span onclick="setColor('sidebarColor','#0f172a','sidebarColorVal','sidebarPreview')" style="background:#0f172a;" title="كحلي"></span>
            <span onclick="setColor('sidebarColor','#1e3a5f','sidebarColorVal','sidebarPreview')" style="background:#1e3a5f;" title="أزرق غامق"></span>
            <span onclick="setColor('sidebarColor','#14532d','sidebarColorVal','sidebarPreview')" style="background:#14532d;" title="أخضر غامق"></span>
            <span onclick="setColor('sidebarColor','#1c1917','sidebarColorVal','sidebarPreview')" style="background:#1c1917;" title="بني غامق"></span>
            <span onclick="setColor('sidebarColor','#4a1d96','sidebarColorVal','sidebarPreview')" style="background:#4a1d96;" title="بنفسجي"></span>
            <span onclick="setColor('sidebarColor','#374151','sidebarColorVal','sidebarPreview')" style="background:#374151;" title="رمادي"></span>
            <span onclick="setColor('sidebarColor','#ffffff','sidebarColorVal','sidebarPreview')" style="background:#ffffff;border:1px solid #e2e8f0;" title="أبيض"></span>
          </div>
        </div>

        <!-- نوع الخط -->
        <div class="col-md-4">
          <label class="form-label"><i class="fa-solid fa-font me-1"></i> نوع الخط</label>
          <div class="font-options mt-2">
            <% ['Cairo','Tajawal','Noto Sans Arabic','Almarai','IBM Plex Sans Arabic'].forEach(function(f){ %>
            <label class="font-pick-btn <%= (settings.fontFamily||'Cairo')===f ? 'active' : '' %>"
                   style="font-family:'<%= f %>';" onclick="pickFont('<%= f %>',this)">
              <input type="radio" name="fontFamily" value="<%= f %>"
                     <%= (settings.fontFamily||'Cairo')===f ? 'checked' : '' %> style="display:none;">
              <%= f %>
            </label>
            <% }); %>
          </div>
        </div>

        <!-- ═══ خلفية لوحة التحكم ═══ -->
        <div class="col-md-12">
          <label class="form-label"><i class="fa-solid fa-image me-1"></i> خلفية لوحة التحكم</label>
          <div class="bg-builder">

            <!-- منطقة الرفع -->
            <div class="bg-upload-zone" id="bgDropZone" onclick="document.getElementById('adminBgInput').click()">
              <% if(settings.adminBg){ %>
                <img src="<%= settings.adminBg %>" alt="الخلفية الحالية" class="bg-current-thumb">
                <div class="bg-overlay-label">انقر لتغيير الخلفية</div>
              <% } else { %>
                <div class="bg-empty-state">
                  <i class="fa-solid fa-cloud-arrow-up fa-2x mb-2" style="color:var(--primary);opacity:.7;"></i>
                  <div style="font-weight:700;font-size:13px;">اسحب صورة أو انقر للرفع</div>
                  <div style="font-size:11.5px;color:var(--text-muted);margin-top:4px;">JPG · PNG · WEBP · حتى 5 ميغا</div>
                </div>
              <% } %>
            </div>
            <input type="file" name="adminBg" id="adminBgInput" accept="image/*" style="display:none;" onchange="previewBg(this)">

            <!-- مجموعة الخلفيات المدمجة -->
            <div class="form-hint mb-2 mt-3">أو اختر لوناً متدرجاً جاهزاً:</div>
            <div class="bg-presets">
              <span class="bg-preset" title="بدون خلفية" onclick="clearBg()" style="background:var(--bg-2);border:2px dashed var(--border-color);">
                <i class="fa-solid fa-xmark" style="font-size:16px;color:var(--text-muted);"></i>
              </span>
              <span class="bg-preset" style="background:linear-gradient(135deg,#0f0c29,#302b63,#24243e);" onclick="setGradientBg('linear-gradient(135deg,#0f0c29,#302b63,#24243e)')"></span>
              <span class="bg-preset" style="background:linear-gradient(135deg,#0d1b2a,#1b263b,#415a77);" onclick="setGradientBg('linear-gradient(135deg,#0d1b2a,#1b263b,#415a77)')"></span>
              <span class="bg-preset" style="background:linear-gradient(135deg,#1a0533,#4a1d96,#6366f1);" onclick="setGradientBg('linear-gradient(135deg,#1a0533,#4a1d96,#6366f1)')"></span>
              <span class="bg-preset" style="background:linear-gradient(135deg,#064e3b,#065f46,#10b981);" onclick="setGradientBg('linear-gradient(135deg,#064e3b,#065f46,#10b981)')"></span>
              <span class="bg-preset" style="background:linear-gradient(135deg,#7c2d12,#9a3412,#f97316);" onclick="setGradientBg('linear-gradient(135deg,#7c2d12,#9a3412,#f97316)')"></span>
              <span class="bg-preset" style="background:linear-gradient(135deg,#1e293b,#334155,#64748b);" onclick="setGradientBg('linear-gradient(135deg,#1e293b,#334155,#64748b)')"></span>
              <span class="bg-preset" style="background:linear-gradient(135deg,#450a0a,#7f1d1d,#dc2626);" onclick="setGradientBg('linear-gradient(135deg,#450a0a,#7f1d1d,#dc2626)')"></span>
              <span class="bg-preset" style="background:linear-gradient(135deg,#f0fdf4,#dcfce7,#bbf7d0);" onclick="setGradientBg('linear-gradient(135deg,#f0fdf4,#dcfce7,#bbf7d0)')"></span>
            </div>
            <input type="hidden" name="adminBgGradient" id="adminBgGradient" value="">

            <!-- شفافية وضبابية -->
            <div class="row g-3 mt-1">
              <div class="col-md-6">
                <label class="form-label" style="font-size:12px;">
                  <i class="fa-solid fa-circle-half-stroke me-1"></i> شفافية الطبقة الداكنة
                  <strong id="opacityVal" style="color:var(--primary);">(<%= settings.adminBgOpacity || 15 %>%)</strong>
                </label>
                <input type="range" name="adminBgOpacity" min="0" max="90" step="5"
                       value="<%= settings.adminBgOpacity || 15 %>"
                       class="form-range"
                       oninput="document.getElementById('opacityVal').textContent='('+this.value+'%)'">
                <div class="form-hint">0% = الصورة واضحة كاملاً &nbsp;·&nbsp; 90% = شبه خفية</div>
              </div>
              <div class="col-md-6">
                <label class="form-label" style="font-size:12px;">
                  <i class="fa-solid fa-droplet me-1"></i> ضبابية (Blur)
                  <strong id="blurVal" style="color:var(--primary);">(<%= settings.adminBgBlur || 0 %>px)</strong>
                </label>
                <input type="range" name="adminBgBlur" min="0" max="20" step="1"
                       value="<%= settings.adminBgBlur || 0 %>"
                       class="form-range"
                       oninput="document.getElementById('blurVal').textContent='('+this.value+'px)'">
                <div class="form-hint">0 = بدون ضبابية &nbsp;·&nbsp; 20 = ضبابي جداً</div>
              </div>
            </div>

            <!-- زر الحذف -->
            <% if(settings.adminBg){ %>
            <div class="mt-3">
              <label class="d-flex align-items-center gap-2" style="cursor:pointer;font-size:13px;">
                <input type="checkbox" name="removeAdminBg" value="yes" style="accent-color:#ef4444;">
                <span style="color:#ef4444;font-weight:700;"><i class="fa-solid fa-trash me-1"></i>حذف الخلفية الحالية</span>
              </label>
            </div>
            <% } %>
          </div>
        </div>

        <!-- خيارات الفاتورة -->
        <div class="col-md-6">
          <label class="form-label"><i class="fa-solid fa-file-invoice me-1"></i> خيارات عرض الفاتورة</label>
          <div class="d-flex flex-column gap-2 mt-1">
            <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
              <input type="checkbox" name="showLogoInInvoice" class="form-check-input" style="width:20px;height:20px;"
                     <%= settings.showLogoInInvoice !== false ? 'checked' : '' %>>
              <span style="font-size:13px;">إظهار الشعار في الفواتير</span>
            </label>
            <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
              <input type="checkbox" name="showAddressInInvoice" class="form-check-input" style="width:20px;height:20px;"
                     <%= settings.showAddressInInvoice !== false ? 'checked' : '' %>>
              <span style="font-size:13px;">إظهار العنوان في الفواتير</span>
            </label>
            <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
              <input type="checkbox" name="showPhoneInInvoice" class="form-check-input" style="width:20px;height:20px;"
                     <%= settings.showPhoneInInvoice !== false ? 'checked' : '' %>>
              <span style="font-size:13px;">إظهار الهاتف في الفواتير</span>
            </label>
          </div>
        </div>

      </div>
    </div>

    <!-- ===== 3. إعدادات الفواتير ===== -->
    <div class="settings-section">
      <h5>
        <i class="fa-solid fa-file-invoice" style="color:#d4af37;"></i>
        إعدادات الفواتير
      </h5>
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">بادئة رقم الفاتورة</label>
          <input name="invoicePrefix" class="form-control" value="<%= settings.invoicePrefix || 'INV' %>" placeholder="INV" maxlength="10">
          <div class="form-hint">مثال: INV → الفاتورة ستكون INV-12345</div>
        </div>
        <div class="col-md-4">
          <label class="form-label">رمز العملة</label>
          <input name="currency" class="form-control" value="<%= settings.currency || '₪' %>" placeholder="₪" maxlength="5">
          <div class="form-hint">مثال: ₪ أو USD أو JD</div>
        </div>
      </div>
    </div>

    <!-- ===== 4. كلمة المرور ===== -->
    <div class="settings-section">
      <h5>
        <i class="fa-solid fa-lock" style="color:#d4af37;"></i>
        تغيير كلمة مرور المدير
      </h5>
      <div class="row g-3">
        <div class="col-md-5">
          <label class="form-label">كلمة المرور الجديدة</label>
          <input type="password" name="adminPassword" class="form-control" placeholder="اتركه فارغاً لعدم التغيير" autocomplete="new-password">
          <div class="form-hint">اتركه فارغاً إذا لم تريد تغيير كلمة المرور الحالية</div>
        </div>
      </div>
    </div>

    <!-- ===== 5. إعدادات البوابات ===== -->
    <div class="settings-section">
      <h5>
        <i class="fa-solid fa-door-open" style="color:#d4af37;"></i>
        إعدادات بوابات الدخول
      </h5>

      <!-- بوابة الزبائن -->
      <div class="switch-row">
        <div class="switch-info">
          <div class="sw-title"><i class="fa-solid fa-users me-2" style="color:#60a5fa;"></i>تفعيل بوابة الزبائن</div>
          <div class="sw-desc">السماح للزبائن بتسجيل الدخول وعرض كشف حساباتهم</div>
        </div>
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" name="enableCustomerPortal"
                 <%= settings.enableCustomerPortal ? 'checked' : '' %>>
        </div>
      </div>
      <div class="portal-name-row mb-2">
        <label><i class="fa-solid fa-tag me-1"></i> اسم بوابة الزبائن</label>
        <input type="text" name="customerPortalName" class="form-control"
               value="<%= settings.customerPortalName || 'بوابة الزبائن' %>"
               placeholder="مثال: بوابة العملاء">
      </div>
      <div class="portal-name-row mb-3" style="background:rgba(59,130,246,.04);border-color:rgba(59,130,246,.2);">
        <label style="color:#1d4ed8;"><i class="fa-solid fa-eye me-1"></i> الأقسام المرئية للزبون</label>
        <div class="d-flex flex-wrap gap-3 mt-2">
          <label class="d-flex align-items-center gap-2" style="cursor:pointer;font-size:13px;">
            <input type="checkbox" name="customerShowStatement" class="form-check-input" style="width:18px;height:18px;"
                   <%= settings.customerShowStatement !== false ? 'checked' : '' %>>
            كشف الحساب
          </label>
          <label class="d-flex align-items-center gap-2" style="cursor:pointer;font-size:13px;">
            <input type="checkbox" name="customerShowInvoices" class="form-check-input" style="width:18px;height:18px;"
                   <%= settings.customerShowInvoices !== false ? 'checked' : '' %>>
            الفواتير
          </label>
          <label class="d-flex align-items-center gap-2" style="cursor:pointer;font-size:13px;">
            <input type="checkbox" name="customerShowVisits" class="form-check-input" style="width:18px;height:18px;"
                   <%= settings.customerShowVisits !== false ? 'checked' : '' %>>
            الزيارات والمقاسات
          </label>
        </div>
      </div>

      <!-- بوابة التجار -->
      <div class="switch-row">
        <div class="switch-info">
          <div class="sw-title"><i class="fa-solid fa-store me-2" style="color:#34d399;"></i>تفعيل بوابة التجار</div>
          <div class="sw-desc">السماح للتجار بتسجيل الدخول وعرض كشف حساباتهم</div>
        </div>
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" name="enableDealerPortal"
                 <%= settings.enableDealerPortal ? 'checked' : '' %>>
        </div>
      </div>
      <div class="portal-name-row mb-2">
        <label><i class="fa-solid fa-tag me-1"></i> اسم بوابة التجار</label>
        <input type="text" name="dealerPortalName" class="form-control"
               value="<%= settings.dealerPortalName || 'بوابة التجار' %>"
               placeholder="مثال: بوابة الموردين">
      </div>
      <div class="portal-name-row" style="background:rgba(52,211,153,.04);border-color:rgba(52,211,153,.2);">
        <label style="color:#065f46;"><i class="fa-solid fa-eye me-1"></i> الأقسام المرئية للتاجر</label>
        <div class="d-flex flex-wrap gap-3 mt-2">
          <label class="d-flex align-items-center gap-2" style="cursor:pointer;font-size:13px;">
            <input type="checkbox" name="dealerShowStatement" class="form-check-input" style="width:18px;height:18px;"
                   <%= settings.dealerShowStatement !== false ? 'checked' : '' %>>
            كشف الحساب
          </label>
          <label class="d-flex align-items-center gap-2" style="cursor:pointer;font-size:13px;">
            <input type="checkbox" name="dealerShowInvoices" class="form-check-input" style="width:18px;height:18px;"
                   <%= settings.dealerShowInvoices !== false ? 'checked' : '' %>>
            الفواتير
          </label>
        </div>
      </div>
    </div>

    <!-- ===== 6. الكتالوج ===== -->
    <div class="settings-section">
      <h5>
        <i class="fa-solid fa-book-open" style="color:#d4af37;"></i>
        إعدادات الكتالوج العام
      </h5>
      <div class="switch-row">
        <div class="switch-info">
          <div class="sw-title">إظهار الأسعار في الكتالوج العام</div>
          <div class="sw-desc">يتحكم في ظهور أسعار المنتجات للزوار العاديين</div>
        </div>
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" name="catalogPricesMode"
                 <%= settings.catalogPricesMode ? 'checked' : '' %>>
        </div>
      </div>
    </div>

    <!-- ===== 7. النسخ الاحتياطي ===== -->
    <div class="settings-section" id="backup">
      <h5>
        <i class="fa-solid fa-database" style="color:#d4af37;"></i>
        النسخ الاحتياطي
      </h5>

      <div class="switch-row">
        <div class="switch-info">
          <div class="sw-title"><i class="fa-solid fa-rotate me-2" style="color:#10b981;"></i>نسخة احتياطية تلقائية</div>
          <div class="sw-desc">تشغيل النسخ الاحتياطي التلقائي حسب الجدول المحدد</div>
        </div>
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" name="backupEnabled" <%= settings.backupEnabled ? 'checked' : '' %>>
        </div>
      </div>

      <div class="row g-3 mt-1">
        <div class="col-md-3">
          <label class="form-label">يوم النسخ</label>
          <select name="backupDay" class="form-select">
            <% ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'].forEach(function(d,i){
               const labels = ['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت']; %>
            <option value="<%= d %>" <%= (settings.backupDay||'sunday')===d ? 'selected' : '' %>><%= labels[i] %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">وقت النسخ</label>
          <input type="time" name="backupTime" class="form-control" value="<%= settings.backupTime || '02:00' %>">
        </div>
        <div class="col-md-3">
          <label class="form-label">عدد النسخ المحتفظ بها</label>
          <input type="number" name="backupKeepCount" class="form-control" min="1" max="30" value="<%= settings.backupKeepCount || 5 %>">
          <div class="form-hint">الحد الأقصى: 30 نسخة</div>
        </div>
        <div class="col-md-3 d-flex align-items-end">
          <a href="/admin/backup/download" class="btn btn-outline-primary w-100" target="_blank">
            <i class="fa-solid fa-file-pdf me-2" style="color:#ef4444;"></i>
            تنزيل نسخة احتياطية PDF
          </a>
        </div>
      </div>
    </div>

    <!-- ===== 8. التكامل ===== -->
    <div class="settings-section" id="integrations">
      <h5>
        <i class="fa-solid fa-plug" style="color:#d4af37;"></i>
        التكامل مع الخدمات الخارجية
        <span class="section-badge"><i class="fa-solid fa-link fa-xs"></i> API Keys</span>
      </h5>

      <div class="row g-3">
        <!-- WhatsApp -->
        <div class="col-12">
          <div style="background:rgba(37,211,102,.06);border:1px solid rgba(37,211,102,.2);border-radius:10px;padding:16px 18px;">
            <div style="font-size:13px;font-weight:800;color:#25d366;margin-bottom:12px;">
              <i class="fab fa-whatsapp me-2"></i>إعدادات WhatsApp API
            </div>
            <div class="row g-2">
              <div class="col-md-12">
                <label class="form-label">WhatsApp API Key</label>
                <input type="password" name="whatsappApiKey" class="form-control" value="<%= settings.whatsappApiKey || '' %>" placeholder="API Key من مزود الخدمة" autocomplete="new-password">
                <div class="form-hint">سيتم استخدام رقم الواتساب المحدد في قسم (معلومات المعرض) لإرسال الرسائل.</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Email -->
        <div class="col-12">
          <div style="background:rgba(79,70,229,.06);border:1px solid rgba(79,70,229,.2);border-radius:10px;padding:16px 18px;">
            <div style="font-size:13px;font-weight:800;color:var(--primary);margin-bottom:12px;">
              <i class="fa-solid fa-envelope me-2"></i>إعدادات البريد الإلكتروني (SMTP)
            </div>
            <div class="row g-2">
              <div class="col-md-4">
                <label class="form-label">SMTP Host</label>
                <input name="emailHost" class="form-control" value="<%= settings.emailHost || '' %>" placeholder="smtp.gmail.com">
              </div>
              <div class="col-md-2">
                <label class="form-label">Port</label>
                <input type="number" name="emailPort" class="form-control" value="<%= settings.emailPort || 587 %>">
              </div>
              <div class="col-md-3">
                <label class="form-label">البريد الإلكتروني</label>
                <input name="emailUser" class="form-control" value="<%= settings.emailUser || '' %>" placeholder="info@example.com">
              </div>
              <div class="col-md-3">
                <label class="form-label">اسم المرسِل</label>
                <input name="emailFromName" class="form-control" value="<%= settings.emailFromName || '' %>" placeholder="معرض الصافي">
              </div>
            </div>
          </div>
        </div>

        <!-- Telegram + Google Maps + SMS -->
        <div class="col-md-4">
          <div style="background:rgba(0,136,204,.06);border:1px solid rgba(0,136,204,.2);border-radius:10px;padding:14px 16px;">
