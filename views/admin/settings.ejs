            <label class="form-label">Bot Token</label>
            <input type="password" name="telegramBotToken" class="form-control" value="<%= settings.telegramBotToken || '' %>" placeholder="123456:ABC..." autocomplete="new-password">
            <label class="form-label mt-2">Chat ID</label>
            <input name="telegramChatId" class="form-control" value="<%= settings.telegramChatId || '' %>" placeholder="-100XXXXXXXXX">
          </div>
        </div>
        <div class="col-md-4">
          <div style="background:rgba(234,67,53,.06);border:1px solid rgba(234,67,53,.2);border-radius:10px;padding:14px 16px;">
            <div style="font-size:13px;font-weight:800;color:#ea4335;margin-bottom:10px;"><i class="fab fa-google me-2"></i>Google Maps</div>
            <label class="form-label">API Key</label>
            <input type="password" name="googleMapsApiKey" class="form-control" value="<%= settings.googleMapsApiKey || '' %>" placeholder="AIza..." autocomplete="new-password">
            <div class="form-hint mt-1">لعرض موقع المعرض على الخريطة</div>
          </div>
        </div>
        <div class="col-md-4">
          <div style="background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.2);border-radius:10px;padding:14px 16px;">
            <div style="font-size:13px;font-weight:800;color:#f59e0b;margin-bottom:10px;"><i class="fa-solid fa-comment-sms me-2"></i>SMS API</div>
            <label class="form-label">مزود الخدمة</label>
            <input name="smsProvider" class="form-control" value="<%= settings.smsProvider || '' %>" placeholder="Twilio, Vonage...">
            <label class="form-label mt-2">API Key</label>
