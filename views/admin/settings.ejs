        <div class="col-md-4 d-flex flex-column gap-2 justify-content-end">
          <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
            <input type="checkbox" name="printShowSignature" class="form-check-input" style="width:20px;height:20px;"
                   <%= settings.printShowSignature !== false ? 'checked' : '' %>>
            <span style="font-size:13px;">إظهار خانة التوقيع</span>
          </label>
          <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
            <input type="checkbox" name="printShowStamp" class="form-check-input" style="width:20px;height:20px;"
