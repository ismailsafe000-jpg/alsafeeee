        </div>
        <div class="col-md-3">
          <label class="form-label">هامش أعلى/أسفل (mm)</label>
          <input type="number" name="printMarginTop" class="form-control" min="0" max="40" value="<%= settings.printMarginTop || 15 %>">
        </div>
        <div class="col-md-3">
          <label class="form-label">هامش يمين/يسار (mm)</label>
          <input type="number" name="printMarginSide" class="form-control" min="0" max="40" value="<%= settings.printMarginSide || 15 %>">
        </div>
        <div class="col-md-3">
          <label class="form-label">حجم الشعار (px)</label>
