<%- include('../partials/admin-header') %>
<h2 class="section-title"><i class="fa-solid fa-store"></i> <%= dealer._id ? 'تعديل بيانات' : 'إضافة' %> تاجر</h2>
<div class="card p-4 shadow-sm" style="border-radius: 16px;">
  <form action="<%= dealer._id ? '/admin/dealers/edit/' + dealer._id : '/admin/dealers/add' %>" method="POST">
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label fw-bold">الاسم الكامل</label><input name="fullName" class="form-control" value="<%= dealer.fullName || '' %>" required></div>
      <div class="col-md-6"><label class="form-label fw-bold">رقم الهاتف</label><input name="phone" class="form-control" value="<%= dealer.phone || '' %>" required></div>
      <div class="col-md-12"><label class="form-label fw-bold">اسم الشركة / المؤسسة</label><input name="company" class="form-control" value="<%= dealer.company || '' %>"></div>
    </div>
    <button type="submit" class="btn btn-gold mt-4"><i class="fa-solid fa-save"></i> حفظ البيانات</button>
  </form>
</div>
<%- include('../partials/admin-footer') %>