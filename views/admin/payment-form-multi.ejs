<%- include('../partials/admin-header') %>

<style>
  .section-card {
    background: var(--card-bg); border-radius: 14px;
    border: 1px solid var(--border-color); padding: 20px 24px; margin-bottom: 16px;
  }
  .section-card h6 {
    font-size: 13px; font-weight: 800; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.5px;
    border-bottom: 1px solid var(--border-color); padding-bottom: 10px; margin-bottom: 16px;
  }
  .pay-row {
    border: 2px solid var(--border-color);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 12px;
    position: relative;
    background: var(--bg-body, rgba(0,0,0,0.02));
  }
  .pay-row .row-badge {
    position: absolute; top: -12px; right: 16px;
    background: var(--primary-gold); color: #1a1200;
    font-weight: 800; font-size: 12px; padding: 3px 12px; border-radius: 20px;
  }
  .pay-row .remove-row-btn {
    position: absolute; top: -12px; left: 16px;
  }
  .total-box {
    background: #f0f9ff; border: 2px solid #93c5fd; border-radius: 12px;
    padding: 16px 20px; text-align: center; margin-top: 8px;
  }
  .total-box .value { font-size: 26px; font-weight: 900; color: #0369a1; }
</style>

<h2 class="section-title">
  <i class="fa-solid fa-layer-group"></i>
  إضافة دفعات متعددة في عملية واحدة
</h2>
<p style="color:var(--text-muted);font-size:13px;margin-top:-8px;">
  أضِف أكثر من دفعة (نقدي، شيك، تحويل...) لنفس الطرف، ثم اضغط "حفظ جميع الدفعات" لتسجيلها كلها دفعة واحدة —
  كل دفعة تُسجَّل بشكل مستقل في كشف الحساب.
</p>

<form id="multiPayForm" action="/admin/payments/add-multi" method="POST">

  <!-- بيانات العملية المشتركة -->
  <div class="section-card">
    <h6><i class="fa-solid fa-hashtag me-2"></i>بيانات العملية</h6>
    <div class="row g-3">
      <div class="col-md-3">
        <label class="form-label fw-bold">نوع السند</label>
        <select name="voucherType" class="form-select">
          <option value="receipt">سند قبض (مال مستلم)</option>
          <option value="payment">سند صرف (مال مدفوع)</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label fw-bold">نوع الحساب</label>
        <select name="type" id="payType" class="form-select">
          <option value="customer">زبون</option>
          <option value="dealer">تاجر</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label fw-bold">الاسم</label>
        <select name="partyId" id="payParty" class="form-select">
          <% customers.forEach(c => { %>
            <option value="<%= c._id %>" data-type="customer"><%= c.fullName %></option>
          <% }) %>
          <% dealers.forEach(d => { %>
            <option value="<%= d._id %>" data-type="dealer"><%= d.fullName %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label fw-bold">التاريخ والوقت</label>
        <input type="datetime-local" name="paymentDate" class="form-control"
          value="<%= new Date().toISOString().slice(0,16) %>">
      </div>
      <div class="col-md-6">
        <label class="form-label fw-bold">ربط بفاتورة <span style="font-weight:400;color:var(--text-muted);">(اختياري)</span></label>
        <select name="invoiceId" class="form-select">
          <option value="">بدون ربط بفاتورة</option>
          <% invoices.forEach(i => { %>
            <option value="<%= i._id %>">
              <%= i.invoiceNumber %> — <%= i.partyName %>
              (<%= i.remainingBalance ? i.remainingBalance.toLocaleString('ar-EG') : '0' %> <%= settings.currency || '₪' %> متبقي)
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label fw-bold">اسم الموظف</label>
        <input name="employeeName" class="form-control" placeholder="اسم الموظف المسؤول">
      </div>
      <div class="col-md-12">
        <label class="form-label fw-bold">البيان</label>
        <input name="description" class="form-control" placeholder="مثال: تسوية دفعات فاتورة الستائر">
      </div>
      <div class="col-md-12">
        <label class="form-label fw-bold">ملاحظات <span style="font-weight:400;color:var(--text-muted);">(اختياري)</span></label>
        <textarea name="notes" class="form-control" rows="2"></textarea>
      </div>
    </div>
  </div>

  <!-- الدفعات -->
  <div class="section-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h6 class="mb-0"><i class="fa-solid fa-coins me-2"></i>الدفعات</h6>
      <button type="button" class="btn btn-sm btn-outline-primary" id="addRowBtn">
        <i class="fa-solid fa-plus"></i> إضافة دفعة
      </button>
    </div>
    <div id="rowsContainer"></div>

    <div class="total-box">
      <div style="font-size:13px;color:var(--text-muted);">إجمالي كل الدفعات</div>
      <div class="value" id="totalValue">0</div>
    </div>
  </div>

  <input type="hidden" name="paymentsJson" id="paymentsJson">

  <div class="d-flex gap-3 mt-3">
    <button type="submit" class="btn btn-gold flex-grow-1 py-2" style="font-size:15px;">
      <i class="fa-solid fa-check-double me-2"></i> حفظ جميع الدفعات
    </button>
    <a href="/admin/payments" class="btn btn-outline-secondary px-4">
      <i class="fa-solid fa-arrow-right me-1"></i> إلغاء
    </a>
  </div>
</form>

<template id="rowTemplate">
  <div class="pay-row" data-row>
    <span class="row-badge">دفعة <span class="row-index"></span></span>
    <button type="button" class="btn btn-sm btn-outline-danger remove-row-btn" data-remove>
      <i class="fa-solid fa-xmark"></i>
    </button>
    <div class="row g-3 mt-2">
      <div class="col-md-4">
        <label class="form-label fw-bold">طريقة الدفع</label>
        <select class="form-select" data-method>
          <option value="cash">💵 نقد</option>
          <option value="bank_transfer">🏦 تحويل بنكي</option>
          <option value="check">📄 شيك</option>
          <option value="card">💳 بطاقة</option>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label fw-bold">المبلغ</label>
        <input type="number" step="0.01" class="form-control fw-bold" placeholder="0.00" data-amount>
      </div>
      <div class="col-md-4 bank-field" style="display:none;">
        <label class="form-label fw-bold">اسم البنك</label>
        <input class="form-control" data-bank>
      </div>
    </div>
    <div class="row g-3 mt-1 cheque-fields" style="display:none;">
      <div class="col-md-3">
        <label class="form-label fw-bold">رقم الشيك</label>
        <input class="form-control" data-cheque-number>
      </div>
      <div class="col-md-3">
        <label class="form-label fw-bold">البنك</label>
        <input class="form-control" data-cheque-bank>
      </div>
      <div class="col-md-3">
        <label class="form-label fw-bold">تاريخ الاستلام</label>
        <input type="date" class="form-control" data-cheque-received>
      </div>
      <div class="col-md-3">
        <label class="form-label fw-bold">تاريخ الاستحقاق</label>
        <input type="date" class="form-control" data-cheque-due>
      </div>
    </div>
  </div>
</template>

<script>
  const container = document.getElementById('rowsContainer');
  const template = document.getElementById('rowTemplate');

  function renumberRows() {
    container.querySelectorAll('[data-row]').forEach((row, i) => {
      row.querySelector('.row-index').textContent = i + 1;
    });
  }

  function addRow() {
    const node = template.content.cloneNode(true);
    const row = node.querySelector('[data-row]');
    const methodSelect = row.querySelector('[data-method]');
    const bankField = row.querySelector('.bank-field');
    const chequeFields = row.querySelector('.cheque-fields');

    methodSelect.addEventListener('change', () => {
      const m = methodSelect.value;
      bankField.style.display = m === 'bank_transfer' ? 'block' : 'none';
      chequeFields.style.display = m === 'check' ? 'flex' : 'none';
    });
    row.querySelector('[data-amount]').addEventListener('input', updateTotal);
    row.querySelector('[data-remove]').addEventListener('click', () => {
      if (container.querySelectorAll('[data-row]').length <= 1) {
        alert('يجب أن تبقى دفعة واحدة على الأقل');
        return;
      }
      row.remove();
      renumberRows();
      updateTotal();
    });

    container.appendChild(row);
    renumberRows();
  }

  function updateTotal() {
    let total = 0;
    container.querySelectorAll('[data-amount]').forEach(inp => {
      total += parseFloat(inp.value) || 0;
    });
    document.getElementById('totalValue').textContent =
      total.toLocaleString('ar-EG') + ' <%= settings.currency || "₪" %>';
  }

  document.getElementById('addRowBtn').addEventListener('click', addRow);
  addRow(); // دفعة أولى افتراضية

  // فلترة قائمة الأطراف حسب النوع
  const allCustomers = [<%- customers.map(c=>`{id:'${c._id}',name:'${c.fullName.replace(/'/g,"\\'")}',type:'customer'}`).join(',') %>];
  const allDealers   = [<%- dealers.map(d=>`{id:'${d._id}',name:'${d.fullName.replace(/'/g,"\\'")}',type:'dealer'}`).join(',') %>];
  document.getElementById('payType').addEventListener('change', function () {
    const sel = document.getElementById('payParty');
    sel.innerHTML = '';
    const list = this.value === 'customer' ? allCustomers : allDealers;
    list.forEach(p => {
      const opt = document.createElement('option');
      opt.value = p.id;
      opt.textContent = p.name;
      sel.appendChild(opt);
    });
  });

  document.getElementById('multiPayForm').addEventListener('submit', function (e) {
    const rows = [];
    container.querySelectorAll('[data-row]').forEach(row => {
      const amount = parseFloat(row.querySelector('[data-amount]').value) || 0;
      if (amount <= 0) return;
      const method = row.querySelector('[data-method]').value;
      const entry = { paymentMethod: method, amount };
      if (method === 'bank_transfer') {
        entry.bankName = row.querySelector('[data-bank]').value || '';
      } else if (method === 'check') {
        entry.chequeNumber = row.querySelector('[data-cheque-number]').value || '';
        entry.bankName = row.querySelector('[data-cheque-bank]').value || '';
        entry.chequeReceivedDate = row.querySelector('[data-cheque-received]').value || '';
        entry.chequeDueDate = row.querySelector('[data-cheque-due]').value || '';
      }
      rows.push(entry);
    });
    if (!rows.length) {
      e.preventDefault();
      alert('أضف دفعة واحدة على الأقل بمبلغ صحيح');
      return;
    }
    document.getElementById('paymentsJson').value = JSON.stringify(rows);
  });
</script>

<%- include('../partials/admin-footer') %>
