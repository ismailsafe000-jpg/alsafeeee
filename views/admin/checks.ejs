<%- include('../partials/admin-header') %>
<style>
  .checks-wrap { max-width: 1150px; margin: 0 auto; }
  .checks-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .checks-header h2 { font-size: 20px; font-weight: 800; color: #1e293b; margin: 0; }

  .tab-bar { display: flex; gap: 8px; margin-bottom: 16px; border-bottom: 2px solid var(--border-color, #e2e8f0); }
  .tab-btn {
    padding: 10px 22px; border: none; background: none; cursor: pointer;
    font-family: inherit; font-size: 14px; font-weight: 700; color: var(--text-muted, #64748b);
    border-bottom: 3px solid transparent; margin-bottom: -2px;
  }
  .tab-btn.active { color: #1e293b; border-bottom-color: #d97706; }
  .tab-pane { display: none; }
  .tab-pane.active { display: block; }

  .filter-bar { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
  .filter-btn {
    padding: 6px 16px; border-radius: 20px; border: 1px solid #e2e8f0;
    background: white; cursor: pointer; font-family: inherit; font-size: 13px;
    font-weight: 600; color: #64748b; transition: 0.15s;
  }
  .filter-btn:hover { border-color: #94a3b8; color: #334155; }
  .filter-btn.active { background: #1e293b; color: white; border-color: #1e293b; }
  .filter-btn.f-pending.active { background: #d97706; border-color: #d97706; }
  .filter-btn.f-cleared.active { background: #15803d; border-color: #15803d; }
  .filter-btn.f-returned.active { background: #dc2626; border-color: #dc2626; }
  .filter-btn.f-transferred_to_dealer.active { background: #6d28d9; border-color: #6d28d9; }

  .checks-table-wrap { background: var(--card-bg, white); border-radius: 12px; border: 1px solid var(--border-color, #e2e8f0); overflow: hidden; }
  .checks-table { width: 100%; border-collapse: collapse; }
  .checks-table thead tr { background: var(--table-hover, #f8fafc); }
  .checks-table thead th { padding: 11px 14px; text-align: center; font-size: 12px; font-weight: 700; color: var(--text-muted, #475569); border-bottom: 2px solid var(--border-color, #e2e8f0); }
  .checks-table tbody td { padding: 10px 14px; text-align: center; font-size: 13px; border-bottom: 1px solid var(--border-color, #f1f5f9); vertical-align: middle; color: var(--text-main); }
  .checks-table tbody tr:last-child td { border-bottom: none; }
  .checks-table tbody tr:hover { background: var(--table-hover, #f8fafc); }
  @media (max-width: 768px) {
    .summary-cards { grid-template-columns: 1fr; }
    .checks-table-wrap { overflow-x: auto; }
    .checks-table { min-width: 700px; font-size: 12px; }
    .checks-table thead th, .checks-table tbody td { padding: 8px 8px; }
    .clear-form { flex-wrap: wrap; }
    .clear-form input[type="date"] { width: 100%; }
  }

  .badge-pending { background: #fef3c7; color: #92400e; border: 1px solid #fcd34d; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
  .badge-cleared { background: #dcfce7; color: #166534; border: 1px solid #86efac; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
  .badge-returned { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
  .badge-transferred { background: #ede9fe; color: #5b21b6; border: 1px solid #c4b5fd; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
  .badge-source-new { background: #e0f2fe; color: #075985; border: 1px solid #7dd3fc; padding: 2px 8px; border-radius: 8px; font-size: 10px; font-weight: 700; }
  .badge-source-transferred { background: #ede9fe; color: #5b21b6; border: 1px solid #c4b5fd; padding: 2px 8px; border-radius: 8px; font-size: 10px; font-weight: 700; }

  .due-warning { color: #dc2626; font-weight: 700; }
  .due-ok { color: #15803d; }
  .due-soon { color: #d97706; font-weight: 600; }

  .action-area { display: flex; flex-direction: column; gap: 6px; align-items: center; }
  .btn-collect {
    display: inline-block; padding: 5px 14px; background: #15803d; color: white;
    border-radius: 6px; font-size: 12px; font-weight: 700; text-decoration: none;
    text-align: center; transition: 0.15s;
  }
  .btn-collect:hover { background: #166534; color: white; text-decoration: none; }
  .collected-badge { color: #15803d; font-size: 12px; font-weight: 700; }
  .replacement-info { font-size: 11px; color: #6d28d9; background: #ede9fe; padding: 3px 8px; border-radius: 6px; display: inline-block; margin-top: 4px; }
  .clear-form { display: flex; gap: 5px; align-items: center; }
  .clear-form input[type="date"] {
    border: 1px solid #e2e8f0; border-radius: 6px; padding: 4px 8px;
    font-size: 12px; font-family: inherit; color: #334155;
  }
  .btn-clear { background: #15803d; color: white; border: none; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; white-space: nowrap; }
  .btn-clear:hover { background: #166534; }
  .btn-bounce { background: #dc2626; color: white; border: none; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; white-space: nowrap; }
  .btn-bounce:hover { background: #b91c1c; }
  .btn-transfer { background: #6d28d9; color: white; border: none; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; white-space: nowrap; }
  .btn-transfer:hover { background: #5b21b6; }
  .btn-del-check { background: #64748b; color: white; border: none; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; white-space: nowrap; }
  .btn-del-check:hover { background: #475569; }

  .party-link { color: #1e40af; text-decoration: none; font-weight: 700; }
  .party-link:hover { text-decoration: underline; }
  .party-type-badge { font-size: 10px; background: #e2e8f0; color: #475569; padding: 1px 6px; border-radius: 8px; margin-right: 4px; }

  .empty-row td { text-align: center; padding: 50px; color: #94a3b8; font-size: 14px; }

  .summary-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 18px; }
  .sum-card { background: var(--card-bg, white); border-radius: 10px; padding: 14px 18px; border: 1px solid var(--border-color, #e2e8f0); }
  .sum-card .sc-lbl { font-size: 12px; color: #64748b; margin-bottom: 4px; }
  .sum-card .sc-val { font-size: 18px; font-weight: 800; }
  .sum-card.pending .sc-val { color: #d97706; }
  .sum-card.cleared .sc-val { color: #15803d; }
  .sum-card.returned .sc-val { color: #dc2626; }
  .sum-card.transferred .sc-val { color: #6d28d9; }

  @media print {
    body { background: white; }
    .no-print, .navbar, .navbar-luxury, nav, .filter-bar, .tab-bar, .action-area, .actions-col { display: none !important; }
    .tab-pane { display: block !important; }
    .checks-table thead th, .checks-table tbody td { padding: 6px 9px; font-size: 9pt; border: 1px solid #ccc; }
    @page { margin: 10mm; size: A4; }
  }
</style>

<div class="checks-wrap">

  <div class="checks-header no-print">
    <h2><i class="fa-solid fa-money-check-dollar"></i> دفتر الشيكات</h2>
    <div style="display:flex; gap:8px;">
      <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
        <i class="fa-solid fa-print"></i> طباعة
      </button>
    </div>
  </div>

  <!-- تبويبات: شيكات الزبائن / شيكات التجار -->
  <div class="tab-bar no-print">
    <button class="tab-btn active" data-tab="customer" onclick="switchTab('customer', this)">
      <i class="fa-solid fa-user me-1"></i> شيكات الزبائن (<%= customerChecks.length %>)
    </button>
    <button class="tab-btn" data-tab="dealer" onclick="switchTab('dealer', this)">
      <i class="fa-solid fa-store me-1"></i> شيكات التجار (<%= dealerChecks.length %>)
    </button>
  </div>

  <!-- ========================= شيكات الزبائن ========================= -->
  <div class="tab-pane active" id="pane-customer">
    <%
      const cPending = customerChecks.filter(c => c.status === 'pending');
      const cCleared = customerChecks.filter(c => c.status === 'cleared');
      const cReturned = customerChecks.filter(c => c.status === 'returned');
      const cTransferred = customerChecks.filter(c => c.status === 'transferred_to_dealer');
    %>
    <div class="summary-cards no-print">
      <div class="sum-card pending">
        <div class="sc-lbl">⏳ جديد (<%= cPending.length %>)</div>
        <div class="sc-val"><%= cPending.reduce((s,c)=>s+c.amount,0).toLocaleString('ar-EG') %> ₪</div>
      </div>
      <div class="sum-card cleared">
        <div class="sc-lbl">✅ تم الصرف (<%= cCleared.length %>)</div>
        <div class="sc-val"><%= cCleared.reduce((s,c)=>s+c.amount,0).toLocaleString('ar-EG') %> ₪</div>
      </div>
      <div class="sum-card returned">
        <div class="sc-lbl">↩️ مرتجع (<%= cReturned.length %>)</div>
        <div class="sc-val"><%= cReturned.reduce((s,c)=>s+c.amount,0).toLocaleString('ar-EG') %> ₪</div>
      </div>
      <div class="sum-card transferred">
        <div class="sc-lbl">🔁 محوّل لتاجر (<%= cTransferred.length %>)</div>
        <div class="sc-val"><%= cTransferred.reduce((s,c)=>s+c.amount,0).toLocaleString('ar-EG') %> ₪</div>
      </div>
    </div>

    <div class="filter-bar no-print">
      <button class="filter-btn active" onclick="filterChecks('customer','all', this)">الكل (<%= customerChecks.length %>)</button>
      <button class="filter-btn f-pending" onclick="filterChecks('customer','pending', this)">جديد (<%= cPending.length %>)</button>
      <button class="filter-btn f-cleared" onclick="filterChecks('customer','cleared', this)">تم الصرف (<%= cCleared.length %>)</button>
      <button class="filter-btn f-returned" onclick="filterChecks('customer','returned', this)">مرتجع (<%= cReturned.length %>)</button>
      <button class="filter-btn f-transferred_to_dealer" onclick="filterChecks('customer','transferred_to_dealer', this)">محوّل لتاجر (<%= cTransferred.length %>)</button>
    </div>

    <div class="checks-table-wrap">
      <table class="checks-table" id="customerChecksTable">
        <thead>
          <tr>
            <th style="width:4%">#</th>
            <th style="width:9%">رقم الشيك</th>
            <th style="width:9%">البنك</th>
            <th style="width:16%">الزبون</th>
            <th style="width:8%">المبلغ ₪</th>
            <th style="width:9%">تاريخ الاستلام</th>
            <th style="width:10%">تاريخ الاستحقاق</th>
            <th style="width:14%">الحالة</th>
            <th style="width:21%" class="actions-col no-print">الإجراء</th>
          </tr>
        </thead>
        <tbody>
          <% if(customerChecks.length === 0) { %>
            <tr class="empty-row"><td colspan="9">لا توجد شيكات زبائن مسجلة بعد</td></tr>
          <% } else { %>
            <% customerChecks.forEach((c, i) => {
              const now = new Date();
              const due = new Date(c.maturityDate);
              const diffDays = Math.ceil((due - now) / (1000*60*60*24));
              let dueClass = 'due-ok';
              let dueNote = '';
              if (c.status === 'pending') {
                if (diffDays < 0) { dueClass = 'due-warning'; dueNote = '(متأخر)'; }
                else if (diffDays <= 7) { dueClass = 'due-soon'; dueNote = `(بعد ${diffDays} يوم)`; }
              }
            %>
            <tr data-status="<%= c.status %>">
              <td style="color:#94a3b8; font-size:11px;"><%= i+1 %></td>
              <td style="font-weight:700;">#<%= c.checkNumber %></td>
              <td style="font-size:12px; color:#475569;"><%= c.bankName %></td>
              <td style="text-align:right;">
                <a href="/admin/statement/customer/<%= c.partyId %>" class="party-link"><%= c.partyName %></a>
              </td>
              <td style="font-weight:700;"><%= c.amount.toLocaleString('ar-EG') %></td>
              <td style="font-size:12px;"><%= c.receivedDate ? new Date(c.receivedDate).toLocaleDateString('ar-EG') : '-' %></td>
              <td class="<%= dueClass %>">
                <%= due.toLocaleDateString('ar-EG') %>
                <% if(dueNote) { %><span style="font-size:10px; display:block;"><%= dueNote %></span><% } %>
              </td>
              <td>
                <% if(c.status === 'pending') { %>
                  <span class="badge-pending">⏳ جديد</span>
                <% } else if(c.status === 'cleared') { %>
                  <span class="badge-cleared">✅ تم الصرف</span>
                  <% if(c.clearDate) { %><span style="font-size:10px; display:block; color:#64748b;"><%= new Date(c.clearDate).toLocaleDateString('ar-EG') %></span><% } %>
                <% } else if(c.status === 'returned') { %>
                  <span class="badge-returned">↩️ مرتجع</span>
                <% } else { %>
                  <span class="badge-transferred">🔁 محوّل لتاجر</span>
                  <span style="font-size:10px; display:block; color:#64748b;">
                    <%= c.transferredToDealerName %><br>
                    <%= c.transferDate ? new Date(c.transferDate).toLocaleDateString('ar-EG') : '' %> — <%= c.transferVoucherNumber %>
                  </span>
                <% } %>
              </td>
              <td class="actions-col no-print">
                <%
                  // pending أو محوّل لتاجر: يظهر زر "تم الصرف" و"مرتجع" دائماً
                  // لا يختفيان بعد التحويل للتاجر — حسب متطلبات النظام
                %>
                <% if(c.status === 'pending' || c.status === 'transferred_to_dealer') { %>
                  <div class="action-area">
                    <form action="/admin/checks/clear/<%= c._id %>" method="POST" class="clear-form">
                      <input type="date" name="clearDate" value="<%= new Date().toISOString().slice(0,10) %>" required>
                      <button type="submit" class="btn-clear">✅ تم الصرف</button>
                    </form>
                    <form action="/admin/checks/bounce/<%= c._id %>" method="POST" onsubmit="return confirm('تسجيل رجوع الشيك سيُضيف المبلغ مدين على حساب <%= c.partyName %>. تأكيد؟')">
                      <button type="submit" class="btn-bounce">↩️ مرتجع</button>
                    </form>
                    <% if(c.status === 'pending') { %>
                      <button type="button" class="btn-transfer" onclick="openTransferModal('<%= c._id %>', '<%= c.checkNumber %>', '<%= c.amount %>')">
                        🔁 تحويل لتاجر
                      </button>
                    <% } %>
                  </div>
                <% } else if(c.status === 'returned') { %>
                  <div class="action-area">
                    <% if(!c.replacedByCheckId) { %>
                      <a href="/admin/checks/collect/<%= c._id %>" class="btn-collect">💰 تحصيل الشيك المرتجع</a>
                    <% } else { %>
                      <span class="collected-badge">✅ تم التحصيل</span>
                      <span class="replacement-info">شيك بديل مرتبط</span>
                    <% } %>
                  </div>
                <% } else { %>
                  <span style="color:#15803d; font-size:12px;">✅ تم الصرف</span>
                <% } %>
                <form action="/admin/checks/delete/<%= c._id %>" method="POST" style="margin-top:6px;" onsubmit="return confirm('حذف الشيك رقم <%= c.checkNumber %> سيحذفه نهائياً من الفاتورة وكشف الحساب (وسيتراجع عن التحويل للتاجر إن وُجد). هل أنت متأكد؟')">
                  <button type="submit" class="btn-del-check"><i class="fa-solid fa-trash"></i> حذف</button>
                </form>
              </td>
            </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ========================= شيكات التجار ========================= -->
  <div class="tab-pane" id="pane-dealer">
    <%
      const dPending = dealerChecks.filter(c => c.status === 'pending');
      const dCleared = dealerChecks.filter(c => c.status === 'cleared');
      const dReturned = dealerChecks.filter(c => c.status === 'returned');
    %>
    <div class="summary-cards no-print">
      <div class="sum-card pending">
        <div class="sc-lbl">⏳ قيد الانتظار (<%= dPending.length %>)</div>
        <div class="sc-val"><%= dPending.reduce((s,c)=>s+c.amount,0).toLocaleString('ar-EG') %> ₪</div>
      </div>
      <div class="sum-card cleared">
        <div class="sc-lbl">✅ تم الصرف (<%= dCleared.length %>)</div>
        <div class="sc-val"><%= dCleared.reduce((s,c)=>s+c.amount,0).toLocaleString('ar-EG') %> ₪</div>
      </div>
      <div class="sum-card returned">
        <div class="sc-lbl">↩️ مرتجع (<%= dReturned.length %>)</div>
        <div class="sc-val"><%= dReturned.reduce((s,c)=>s+c.amount,0).toLocaleString('ar-EG') %> ₪</div>
      </div>
      <div class="sum-card">
        <div class="sc-lbl">📋 الإجمالي</div>
        <div class="sc-val"><%= dealerChecks.length %> شيك</div>
      </div>
    </div>

    <div class="filter-bar no-print">
      <button class="filter-btn active" onclick="filterChecks('dealer','all', this)">الكل (<%= dealerChecks.length %>)</button>
      <button class="filter-btn f-pending" onclick="filterChecks('dealer','pending', this)">قيد الانتظار (<%= dPending.length %>)</button>
      <button class="filter-btn f-cleared" onclick="filterChecks('dealer','cleared', this)">تم الصرف (<%= dCleared.length %>)</button>
      <button class="filter-btn f-returned" onclick="filterChecks('dealer','returned', this)">مرتجع (<%= dReturned.length %>)</button>
    </div>

    <div class="checks-table-wrap">
      <table class="checks-table" id="dealerChecksTable">
        <thead>
          <tr>
            <th style="width:4%">#</th>
            <th style="width:9%">رقم الشيك</th>
            <th style="width:9%">البنك</th>
            <th style="width:16%">التاجر</th>
            <th style="width:8%">المبلغ ₪</th>
            <th style="width:12%">المصدر</th>
            <th style="width:10%">تاريخ الاستحقاق</th>
            <th style="width:12%">الحالة</th>
            <th style="width:20%" class="actions-col no-print">الإجراء</th>
          </tr>
        </thead>
        <tbody>
          <% if(dealerChecks.length === 0) { %>
            <tr class="empty-row"><td colspan="9">لا توجد شيكات تجار مسجلة بعد</td></tr>
          <% } else { %>
            <% dealerChecks.forEach((c, i) => {
              const now = new Date();
              const due = new Date(c.maturityDate);
              const diffDays = Math.ceil((due - now) / (1000*60*60*24));
              let dueClass = 'due-ok';
              let dueNote = '';
              if (c.status === 'pending') {
                if (diffDays < 0) { dueClass = 'due-warning'; dueNote = '(متأخر)'; }
                else if (diffDays <= 7) { dueClass = 'due-soon'; dueNote = `(بعد ${diffDays} يوم)`; }
              }
              const isTransferred = c.status === 'transferred_to_dealer';
              const dealerName = isTransferred ? c.transferredToDealerName : c.partyName;
            %>
            <tr data-status="<%= isTransferred ? 'cleared_via_transfer' : c.status %>">
              <td style="color:#94a3b8; font-size:11px;"><%= i+1 %></td>
              <td style="font-weight:700;">#<%= c.checkNumber %></td>
              <td style="font-size:12px; color:#475569;"><%= c.bankName %></td>
              <td style="text-align:right;">
                <% if (isTransferred && c.transferredToDealerId) { %>
                  <a href="/admin/statement/dealer/<%= c.transferredToDealerId %>" class="party-link"><%= dealerName %></a>
                <% } else { %>
                  <a href="/admin/statement/dealer/<%= c.partyId %>" class="party-link"><%= dealerName %></a>
                <% } %>
              </td>
              <td style="font-weight:700;"><%= c.amount.toLocaleString('ar-EG') %></td>
              <td>
                <% if (isTransferred) { %>
                  <span class="badge-source-transferred">🔁 شيك زبون محوّل</span>
                  <span style="font-size:10px; display:block; color:#64748b;">من: <%= c.partyName %></span>
                <% } else { %>
                  <span class="badge-source-new">🆕 شيك جديد من المعرض</span>
                <% } %>
              </td>
              <td class="<%= dueClass %>">
                <%= due.toLocaleDateString('ar-EG') %>
                <% if(dueNote) { %><span style="font-size:10px; display:block;"><%= dueNote %></span><% } %>
              </td>
              <td>
                <% if (isTransferred) { %>
                  <span class="badge-transferred">🔁 محوّل — سند <%= c.transferVoucherNumber %></span>
                <% } else if(c.status === 'pending') { %>
                  <span class="badge-pending">⏳ انتظار</span>
                <% } else if(c.status === 'cleared') { %>
                  <span class="badge-cleared">✅ تم الصرف</span>
                <% } else { %>
                  <span class="badge-returned">↩️ راجع</span>
                <% } %>
              </td>
              <td class="actions-col no-print">
                <% if(!isTransferred && c.status === 'pending') { %>
                  <div class="action-area">
                    <form action="/admin/checks/clear/<%= c._id %>" method="POST" class="clear-form">
                      <input type="date" name="clearDate" value="<%= new Date().toISOString().slice(0,10) %>" required>
                      <button type="submit" class="btn-clear">✅ انصرف</button>
                    </form>
                    <form action="/admin/checks/bounce/<%= c._id %>" method="POST" onsubmit="return confirm('تسجيل رجوع الشيك سيُضيف المبلغ مدين على حساب <%= c.partyName %>. تأكيد؟')">
                      <button type="submit" class="btn-bounce">↩️ راجع</button>
                    </form>
                  </div>
                <% } else if (!isTransferred) { %>
                  <span style="color:#94a3b8; font-size:12px;">تمت المعالجة</span>
                <% } else { %>
                  <span style="color:#94a3b8; font-size:12px;">إدارته من شيكات الزبائن</span>
                <% } %>
                <% if (!isTransferred) { %>
                <form action="/admin/checks/delete/<%= c._id %>" method="POST" style="margin-top:6px;" onsubmit="return confirm('حذف الشيك رقم <%= c.checkNumber %> سيحذفه نهائياً من الفاتورة وكشف الحساب. هل أنت متأكد؟')">
                  <button type="submit" class="btn-del-check"><i class="fa-solid fa-trash"></i> حذف</button>
                </form>
                <% } %>
              </td>
            </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal: تحويل شيك زبون لتاجر -->
<div class="modal fade" id="transferModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="transferForm" method="POST">
        <div class="modal-header">
          <h5 class="modal-title">🔁 تحويل شيك لتاجر</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p style="font-size:13px; color:#64748b;">
            سيُسجَّل هذا كسند صرف للتاجر باستخدام نفس الشيك — لن يتم إنشاء شيك جديد، فقط ستتغيّر حالة الشيك الحالي.
          </p>
          <div class="mb-3">
            <label class="form-label fw-bold">الشيك رقم <span id="transferCheckNumber"></span> — <span id="transferCheckAmount"></span> ₪</label>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">التاجر المستفيد</label>
            <select name="dealerId" class="form-select" required>
              <option value="">اختر تاجراً...</option>
              <% dealers.forEach(d => { %>
                <option value="<%= d._id %>"><%= d.fullName %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">تاريخ التحويل</label>
            <input type="date" name="transferDate" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
          <button type="submit" class="btn" style="background:#6d28d9;color:white;">تأكيد التحويل</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function switchTab(tab, btn) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    document.getElementById('pane-' + tab).classList.add('active');
  }

  function filterChecks(scope, status, btn) {
    const bar = btn.closest('.filter-bar');
    bar.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const tableId = scope === 'customer' ? 'customerChecksTable' : 'dealerChecksTable';
    document.querySelectorAll('#' + tableId + ' tbody tr[data-status]').forEach(row => {
      if (status === 'all' || row.dataset.status === status) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  let transferModal;
  document.addEventListener('DOMContentLoaded', () => {
    transferModal = new bootstrap.Modal(document.getElementById('transferModal'));
  });

  function openTransferModal(checkId, checkNumber, amount) {
    document.getElementById('transferCheckNumber').textContent = '#' + checkNumber;
    document.getElementById('transferCheckAmount').textContent = parseFloat(amount).toLocaleString('ar-EG');
    document.getElementById('transferForm').action = '/admin/checks/transfer/' + checkId;
    transferModal.show();
  }
</script>

<%- include('../partials/admin-footer') %>
