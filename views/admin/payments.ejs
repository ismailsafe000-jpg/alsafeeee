<%- include('../partials/admin-header') %>

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
  <h2 class="section-title mb-0">
    <i class="fa-solid fa-receipt"></i> سندات القبض والصرف
  </h2>
  <div class="d-flex gap-2 flex-wrap">
    <a href="/admin/payments/add-multi" class="btn btn-gold">
      <i class="fa-solid fa-layer-group"></i> دفعات متعددة
    </a>
    <a href="/admin/payments/add" class="btn btn-outline-secondary">
      <i class="fa-solid fa-plus"></i> سند مفرد
    </a>
  </div>
</div>

<!-- ملخص إحصائي -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="stat-card text-center">
      <div style="font-size:12px;color:var(--text-muted);font-weight:600;">إجمالي السندات</div>
      <div class="fw-bold" style="font-size:22px;color:var(--primary-gold);"><%= payments.length %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card text-center">
      <div style="font-size:12px;color:var(--text-muted);font-weight:600;">سندات قبض</div>
      <div class="fw-bold text-success" style="font-size:20px;"><%= payments.filter(p=>p.voucherType==='receipt'||!p.voucherType).length %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card text-center">
      <div style="font-size:12px;color:var(--text-muted);font-weight:600;">سندات صرف</div>
      <div class="fw-bold text-danger" style="font-size:20px;"><%= payments.filter(p=>p.voucherType==='payment').length %></div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="stat-card text-center">
      <div style="font-size:12px;color:var(--text-muted);font-weight:600;">إجمالي المبالغ</div>
      <div class="fw-bold" style="font-size:17px;color:var(--primary-gold);">
        <%= payments.reduce((s,p)=>s+p.amount,0).toLocaleString('ar-EG') %> <%= settings.currency || '₪' %>
      </div>
    </div>
  </div>
</div>

<% if (payments.length === 0) { %>
  <div class="text-center py-5" style="background:var(--card-bg);border-radius:var(--radius);border:1px solid var(--border-color);">
    <i class="fa-solid fa-receipt fa-3x mb-3" style="color:var(--primary-gold);"></i>
    <h5 style="color:var(--text-muted);">لا توجد سندات بعد</h5>
    <a href="/admin/payments/add" class="btn btn-gold mt-2">
      <i class="fa-solid fa-plus"></i> إضافة أول سند
    </a>
  </div>
<% } else { %>

<!-- Desktop Table -->
<div class="table-responsive-wrap d-none d-lg-block">
  <table class="table table-luxury align-middle mb-0" style="font-size:13px;">
    <thead>
      <tr>
        <th>رقم السند</th>
        <th>التاريخ / الوقت</th>
        <th>النوع</th>
        <th>نوع الحساب</th>
        <th>الاسم</th>
        <th>المبلغ</th>
        <th>طريقة الدفع</th>
        <th>الفاتورة</th>
        <th>البيان</th>
        <th>الحالة</th>
        <th>الموظف</th>
        <th style="min-width:200px;">إجراءات</th>
      </tr>
    </thead>
    <tbody>
      <% payments.forEach(p => {
        const isReceipt = !p.voucherType || p.voucherType === 'receipt';
      %>
        <tr>
          <td>
            <a href="/admin/payments/view/<%= p._id %>"
               class="fw-bold text-decoration-none"
               style="color:var(--primary-gold); font-family:monospace;">
              <%= p.voucherNumber || '—' %>
            </a>
          </td>
          <td style="white-space:nowrap;">
            <div><%= new Date(p.paymentDate).toLocaleDateString('ar-EG', {year:'numeric',month:'2-digit',day:'2-digit'}) %></div>
            <div style="font-size:11px;color:var(--text-muted);">
              <%= new Date(p.paymentDate).toLocaleTimeString('ar-EG', {hour:'2-digit',minute:'2-digit'}) %>
            </div>
          </td>
          <td>
            <% if(isReceipt) { %>
              <span class="badge rounded-pill" style="background:#d1fae5;color:#065f46;font-size:11px;">
                <i class="fa-solid fa-arrow-down-to-line"></i> قبض
              </span>
            <% } else { %>
              <span class="badge rounded-pill" style="background:#fee2e2;color:#991b1b;font-size:11px;">
                <i class="fa-solid fa-arrow-up-from-line"></i> صرف
              </span>
            <% } %>
          </td>
          <td>
            <span class="badge bg-<%= p.type === 'customer' ? 'primary' : 'success' %> rounded-pill" style="font-size:11px;">
              <%= p.type === 'customer' ? 'زبون' : 'تاجر' %>
            </span>
          </td>
          <td class="fw-bold"><%= p.partyName %></td>
          <td class="fw-bold <%= isReceipt ? 'text-success' : 'text-danger' %>">
            <%= p.amount.toLocaleString('ar-EG') %> <%= p.currency || settings.currency || '₪' %>
          </td>
          <td>
            <% if(p.paymentMethod==='cash') { %>
              <span class="badge bg-success rounded-pill" style="font-size:11px;"><i class="fa-solid fa-money-bill"></i> نقداً</span>
            <% } else if(p.paymentMethod==='bank_transfer') { %>
              <span class="badge bg-info rounded-pill" style="font-size:11px;"><i class="fa-solid fa-building-columns"></i> تحويل</span>
            <% } else if(p.paymentMethod==='check') { %>
              <span class="badge bg-warning text-dark rounded-pill" style="font-size:11px;"><i class="fa-solid fa-money-check"></i> شيك</span>
            <% } else if(p.paymentMethod==='card') { %>
              <span class="badge rounded-pill" style="background:#e0e7ff;color:#3730a3;font-size:11px;"><i class="fa-solid fa-credit-card"></i> بطاقة</span>
            <% } %>
          </td>
          <td style="font-size:12px;">
            <% if(p.invoiceId) { %>
              <a href="/admin/invoices/view/<%= p.invoiceId._id %>" class="text-decoration-none" style="color:var(--primary-gold);">
                <%= p.invoiceId.invoiceNumber %>
              </a>
            <% } else { %>—<% } %>
          </td>
          <td style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-muted);">
            <%= p.description || p.notes || '—' %>
          </td>
          <td>
            <% if(!p.status || p.status==='active') { %>
              <span class="badge bg-success rounded-pill" style="font-size:11px;">نشط</span>
            <% } else { %>
              <span class="badge bg-secondary rounded-pill" style="font-size:11px;">ملغى</span>
            <% } %>
          </td>
          <td style="font-size:12px;color:var(--text-muted);"><%= p.employeeName || '—' %></td>
          <td>
            <div class="d-flex gap-1 flex-wrap">
              <a href="/admin/payments/view/<%= p._id %>" class="btn btn-sm btn-outline-primary" title="عرض">
                <i class="fa-solid fa-eye"></i>
              </a>
              <a href="/admin/payments/edit/<%= p._id %>" class="btn btn-sm btn-outline-warning" title="تعديل">
                <i class="fa-solid fa-pen"></i>
              </a>
              <a href="/admin/payments/print/<%= p._id %>" target="_blank" class="btn btn-sm btn-outline-secondary" title="طباعة">
                <i class="fa-solid fa-print"></i>
              </a>
              <a href="/admin/payments/print/<%= p._id %>?pdf=1" target="_blank" class="btn btn-sm btn-outline-dark" title="PDF">
                <i class="fa-solid fa-file-pdf"></i>
              </a>
              <form action="/admin/payments/delete/<%= p._id %>" method="POST"
                onsubmit="return confirm('هل أنت متأكد من حذف السند <%= p.voucherNumber || '' %>؟ سيتم تحديث الفاتورة والكشف والشيكات تلقائياً.')">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- Mobile Cards -->
<div class="d-lg-none">
  <% payments.forEach(p => {
    const isReceipt = !p.voucherType || p.voucherType === 'receipt';
  %>
    <div class="invoice-card mb-3">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
          <div class="fw-bold" style="font-size:14px;color:var(--primary-gold);font-family:monospace;">
            <%= p.voucherNumber || '—' %>
          </div>
          <div class="fw-bold" style="font-size:15px;"><%= p.partyName %></div>
        </div>
        <div class="text-end">
          <div class="fw-bold <%= isReceipt ? 'text-success' : 'text-danger' %>" style="font-size:16px;">
            <%= isReceipt ? '+' : '-' %><%= p.amount.toLocaleString('ar-EG') %> <%= p.currency || settings.currency || '₪' %>
          </div>
          <div style="font-size:11px;color:var(--text-muted);">
            <%= new Date(p.paymentDate).toLocaleDateString('ar-EG') %>
          </div>
        </div>
      </div>
      <div class="d-flex gap-2 flex-wrap mb-2">
        <% if(isReceipt) { %>
          <span class="badge rounded-pill" style="background:#d1fae5;color:#065f46;font-size:11px;">سند قبض</span>
        <% } else { %>
          <span class="badge rounded-pill" style="background:#fee2e2;color:#991b1b;font-size:11px;">سند صرف</span>
        <% } %>
        <span class="badge bg-<%= p.type==='customer'?'primary':'success' %> rounded-pill" style="font-size:11px;">
          <%= p.type==='customer'?'زبون':'تاجر' %>
        </span>
        <% if(p.paymentMethod==='cash') { %><span class="badge bg-success rounded-pill" style="font-size:11px;">نقداً</span>
        <% } else if(p.paymentMethod==='bank_transfer') { %><span class="badge bg-info rounded-pill" style="font-size:11px;">تحويل</span>
        <% } else if(p.paymentMethod==='check') { %><span class="badge bg-warning text-dark rounded-pill" style="font-size:11px;">شيك</span>
        <% } else if(p.paymentMethod==='card') { %><span class="badge rounded-pill" style="background:#e0e7ff;color:#3730a3;font-size:11px;">بطاقة</span>
        <% } %>
      </div>
      <% if(p.description) { %>
        <div style="font-size:12px;color:var(--text-muted);margin-bottom:8px;">
          <i class="fa-solid fa-comment-dots me-1"></i><%= p.description %>
        </div>
      <% } %>
      <div class="d-flex gap-2 mt-2 flex-wrap">
        <a href="/admin/payments/view/<%= p._id %>" class="btn btn-sm btn-outline-primary flex-grow-1">
          <i class="fa-solid fa-eye"></i> عرض
        </a>
        <a href="/admin/payments/edit/<%= p._id %>" class="btn btn-sm btn-outline-warning flex-grow-1">
          <i class="fa-solid fa-pen"></i> تعديل
        </a>
        <a href="/admin/payments/print/<%= p._id %>" target="_blank" class="btn btn-sm btn-outline-secondary">
          <i class="fa-solid fa-print"></i>
        </a>
        <form action="/admin/payments/delete/<%= p._id %>" method="POST"
          onsubmit="return confirm('هل أنت متأكد من الحذف؟')">
          <button type="submit" class="btn btn-sm btn-outline-danger">
            <i class="fa-solid fa-trash"></i>
          </button>
        </form>
      </div>
    </div>
  <% }) %>
</div>
<% } %>

<%- include('../partials/admin-footer') %>
