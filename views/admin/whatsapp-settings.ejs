<%- include('../partials/admin-header') %>
<style>
  .wa-wrap { max-width: 980px; margin: 0 auto; }

  /* ── Status Card ── */
  .wa-status-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 22px 26px;
    margin-bottom: 20px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    flex-wrap: wrap;
  }
  .wa-status-left { display: flex; align-items: center; gap: 14px; }
  .wa-status-icon {
    width: 52px; height: 52px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
  }
  .wa-status-icon.connected   { background: rgba(34,197,94,0.12); color: #16a34a; }
  .wa-status-icon.qr_ready   { background: rgba(245,158,11,0.12); color: #d97706; }
  .wa-status-icon.disconnected { background: rgba(100,116,139,0.12); color: #64748b; }
  .wa-status-icon.error       { background: rgba(220,38,38,0.12);  color: #dc2626; }
  .wa-status-title { font-size: 16px; font-weight: 800; color: var(--text-main); }
  .wa-status-sub   { font-size: 12px; color: var(--text-muted); margin-top: 3px; }

  .badge-connected   { background:#dcfce7; color:#166534; border:1px solid #86efac; padding:4px 14px; border-radius:20px; font-size:12px; font-weight:700; }
  .badge-qr_ready   { background:#fef3c7; color:#92400e; border:1px solid #fcd34d; padding:4px 14px; border-radius:20px; font-size:12px; font-weight:700; }
  .badge-disconnected{ background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; padding:4px 14px; border-radius:20px; font-size:12px; font-weight:700; }
  .badge-error       { background:#fee2e2; color:#991b1b; border:1px solid #fca5a5; padding:4px 14px; border-radius:20px; font-size:12px; font-weight:700; }

  .wa-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  /* ── QR Box ── */
  .qr-box {
    background: var(--card-bg); border: 2px dashed var(--border-color);
    border-radius: 14px; padding: 28px;
    text-align: center; margin-bottom: 20px;
  }
  .qr-box img { max-width: 230px; border-radius: 10px; }
  .qr-box .qr-hint { font-size: 13px; color: var(--text-muted); margin-top: 12px; }

  /* ── Settings Sections ── */
  .wa-section {
    background: var(--card-bg); border: 1px solid var(--border-color);
    border-radius: 14px; padding: 22px 26px; margin-bottom: 18px;
  }
  .wa-section h5 {
    font-size: 14px; font-weight: 800; color: var(--text-main);
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 10px; margin-bottom: 16px;
    display: flex; align-items: center; gap: 8px;
  }
  .switch-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 11px 0; border-bottom: 1px solid var(--border-color);
  }
  .switch-row:last-of-type { border-bottom: none; }
  .switch-info .sw-title { font-size: 13.5px; font-weight: 700; color: var(--text-main); }
  .switch-info .sw-desc  { font-size: 11.5px; color: var(--text-muted); margin-top: 2px; }
  .form-check-input { width: 40px; height: 22px; cursor: pointer; }
  .form-check-input:checked { background-color: #25d366; border-color: #25d366; }
  .form-label { font-weight: 700; font-size: 13px; color: var(--text-main); margin-bottom: 5px; }

  /* ── Logs Table ── */
  .logs-table-wrap { overflow-x: auto; }
  .logs-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .logs-table thead tr { background: var(--table-hover); }
  .logs-table thead th { padding: 10px 12px; font-size: 11px; font-weight: 700; color: var(--text-muted); border-bottom: 2px solid var(--border-color); white-space: nowrap; }
  .logs-table tbody td { padding: 9px 12px; border-bottom: 1px solid var(--border-color); vertical-align: middle; color: var(--text-main); }
  .logs-table tbody tr:last-child td { border-bottom: none; }
  .logs-table tbody tr:hover { background: var(--table-hover); }
  .badge-SUCCESS { background:#dcfce7; color:#166534; border:1px solid #86efac; padding:2px 10px; border-radius:20px; font-size:11px; font-weight:700; }
  .badge-FAILED  { background:#fee2e2; color:#991b1b; border:1px solid #fca5a5; padding:2px 10px; border-radius:20px; font-size:11px; font-weight:700; }

  .empty-state { text-align:center; padding:40px 20px; color:var(--text-muted); }
  .empty-state i { font-size:36px; margin-bottom:12px; opacity:.4; }
</style>

<div class="wa-wrap">

  <!-- ═══ Page Header ═══ -->
  <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h2 class="section-title mb-0">
      <i class="fa-brands fa-whatsapp" style="color:#25d366;"></i> إعدادات واتساب الإشعارات
    </h2>
    <div class="wa-actions">
      <form method="POST" action="/admin/whatsapp-test" style="display:inline;">
        <button class="btn btn-sm btn-outline-success">
          <i class="fa-solid fa-paper-plane"></i> إرسال رسالة اختبار
        </button>
      </form>
      <form method="POST" action="/admin/whatsapp-run-cron" style="display:inline;">
        <button class="btn btn-sm btn-outline-warning">
          <i class="fa-solid fa-play"></i> تشغيل المهمة اليومية
        </button>
      </form>
    </div>
  </div>

  <!-- Alerts -->
  <% if (success_msg && success_msg.length && success_msg[0]) { %>
    <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
      <i class="fa-solid fa-circle-check"></i> <%= success_msg[0] %>
    </div>
  <% } %>
  <% if (error_msg && error_msg.length && error_msg[0]) { %>
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
      <i class="fa-solid fa-circle-xmark"></i> <%= error_msg[0] %>
    </div>
  <% } %>

  <!-- ═══ Connection Status ═══ -->
  <div class="wa-status-card">
    <div class="wa-status-left">
      <div class="wa-status-icon <%= waStatus %>">
        <% if (waStatus === 'connected') { %>
          <i class="fa-brands fa-whatsapp"></i>
        <% } else if (waStatus === 'qr_ready') { %>
          <i class="fa-solid fa-qrcode"></i>
        <% } else if (waStatus === 'error') { %>
          <i class="fa-solid fa-triangle-exclamation"></i>
        <% } else { %>
          <i class="fa-solid fa-plug-circle-xmark"></i>
        <% } %>
      </div>
      <div>
        <div class="wa-status-title">
          حالة اتصال واتساب
          <span class="badge-<%= waStatus %> ms-2">
            <% if (waStatus === 'connected') { %>متصل<% } else if (waStatus === 'qr_ready') { %>في انتظار QR<% } else if (waStatus === 'error') { %>خطأ<% } else { %>غير متصل<% } %>
          </span>
        </div>
        <div class="wa-status-sub">
          <% if (waStatus === 'connected') { %>الخدمة تعمل وجاهزة لإرسال الإشعارات<% } else if (waStatus === 'qr_ready') { %>امسح كود QR بتطبيق واتساب<% } else if (waStatus === 'error') { %>حدث خطأ — جرّب إعادة الاتصال<% } else { %>الخدمة غير متصلة — تحقق من الإعدادات<% } %>
        </div>
      </div>
    </div>
    <div class="wa-actions">
      <form method="POST" action="/admin/whatsapp-reconnect" style="display:inline;">
        <button class="btn btn-sm btn-outline-primary">
          <i class="fa-solid fa-rotate-right"></i> إعادة الاتصال
        </button>
      </form>
      <form method="POST" action="/admin/whatsapp-logout"
            onsubmit="return confirm('هل تريد فصل الرقم الحالي ومسح الجلسة؟');" style="display:inline;">
        <button class="btn btn-sm btn-outline-danger">
          <i class="fa-solid fa-right-from-bracket"></i> تغيير الرقم
        </button>
      </form>
    </div>
  </div>

  <!-- ═══ QR Code ═══ -->
  <% if (waStatus === 'qr_ready' && waQR) { %>
    <div class="qr-box">
      <img src="<%= waQR %>" alt="WhatsApp QR Code">
      <div class="qr-hint">
        <i class="fa-brands fa-whatsapp" style="color:#25d366;"></i>
        افتح واتساب → الأجهزة المرتبطة → ربط جهاز → امسح الكود
      </div>
    </div>
  <% } %>

  <!-- ═══ Settings Form ═══ -->
  <form method="POST" action="/admin/whatsapp-settings">

    <!-- تفعيل الإشعارات -->
    <div class="wa-section">
      <h5><i class="fa-solid fa-toggle-on" style="color:#25d366;"></i> التفعيل العام</h5>
      <div style="background:#ecfdf5; border:1px solid #86efac; border-radius:10px; padding:12px 16px; margin-bottom:14px; font-size:12.5px; color:#166534; display:flex; align-items:center; gap:8px;">
        <i class="fa-solid fa-circle-info"></i>
        <span>جميع الإشعارات تُرسل حصراً إلى رقم المدير المُحدَّد أدناه — لا يُرسل أي إشعار تلقائي للزبائن أو التجار.</span>
      </div>
      <div class="switch-row">
        <div class="switch-info">
          <div class="sw-title">تفعيل إشعارات واتساب</div>
          <div class="sw-desc">المفتاح الرئيسي — يوقف/يشغّل جميع إشعارات المدير</div>
        </div>
        <div class="form-check form-switch mb-0">
          <input class="form-check-input" type="checkbox" name="waNotificationsEnabled"
                 <%= settings.waNotificationsEnabled ? 'checked' : '' %>>
        </div>
      </div>
    </div>

    <!-- إشعارات الشيكات -->
    <div class="wa-section">
      <h5><i class="fa-solid fa-money-check-dollar" style="color:#f59e0b;"></i> إشعارات الشيكات <span style="font-size:11px; font-weight:400; color:var(--text-muted);">← للمدير فقط</span></h5>
      <% const checkToggles = [
        { name:'waAddedEnabled',    title:'شيك جديد',       desc:'إشعار للمدير عند إضافة شيك جديد' },
        { name:'waClearedEnabled',  title:'صرف الشيك',      desc:'إشعار للمدير عند صرف الشيك' },
        { name:'waReturnedEnabled', title:'رجوع الشيك',     desc:'إشعار للمدير عند رجوع/ارتداد الشيك' },
        { name:'waCancelledEnabled',title:'إلغاء الشيك',    desc:'إشعار للمدير عند إلغاء الشيك' },
        { name:'waEditEnabled',     title:'تعديل الشيك',    desc:'إشعار للمدير عند تعديل بيانات الشيك' },
        { name:'waReminderEnabled', title:'تذكيرات الاستحقاق',desc:'تذكيرات آلية للمدير قبل موعد الاستحقاق' },
      ]; %>
      <% checkToggles.forEach(t => { %>
        <div class="switch-row">
          <div class="switch-info">
            <div class="sw-title"><%= t.title %></div>
            <div class="sw-desc"><%= t.desc %></div>
          </div>
          <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" name="<%= t.name %>"
                   <%= settings[t.name] ? 'checked' : '' %>>
          </div>
        </div>
      <% }); %>

      <div class="mt-3">
        <label class="form-label">أيام التذكير المسبق</label>
        <input type="number" class="form-control" name="waReminderDays"
               value="<%= settings.waReminderDays || 5 %>" min="1" max="30" style="max-width:140px;">
        <div class="form-text" style="font-size:12px; color:var(--text-muted);">عدد الأيام قبل الاستحقاق لإرسال التذكير</div>
      </div>
    </div>

    <!-- إشعارات الفواتير والمدفوعات -->
    <div class="wa-section">
      <h5><i class="fa-solid fa-file-invoice" style="color:#6366f1;"></i> إشعارات الفواتير والمدفوعات <span style="font-size:11px; font-weight:400; color:var(--text-muted);">← للمدير فقط</span></h5>
      <% const invToggles = [
        { name:'waInvoiceNewEnabled',       title:'فاتورة جديدة',          desc:'إشعار للمدير عند إصدار فاتورة جديدة (مع التفاصيل)' },
        { name:'waInvoicePaidEnabled',      title:'فاتورة مدفوعة كاملاً',  desc:'إشعار للمدير عند سداد الفاتورة بالكامل' },
        { name:'waPaymentReceivedEnabled',  title:'استلام دفعة / سند قبض أو صرف', desc:'إشعار للمدير عند كل دفعة (مع المبلغ والطريقة والرصيد)' },
        { name:'waStatementEntryEnabled',   title:'حركة كشف الحساب',       desc:'إشعار للمدير عند كل قيد في كشف الحساب (مع الرصيد السابق والجديد)' },
      ]; %>
      <% invToggles.forEach(t => { %>
        <div class="switch-row">
          <div class="switch-info">
            <div class="sw-title"><%= t.title %></div>
            <div class="sw-desc"><%= t.desc %></div>
          </div>
          <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" name="<%= t.name %>"
                   <%= settings[t.name] ? 'checked' : '' %>>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- إعدادات المدير -->
    <div class="wa-section">
      <h5><i class="fa-solid fa-user-tie" style="color:#8b5cf6;"></i> إعدادات المدير — المستلم الوحيد للإشعارات</h5>
      <div style="background:#eff6ff; border:1px solid #93c5fd; border-radius:10px; padding:12px 16px; margin-bottom:14px; font-size:12.5px; color:#1e40af; display:flex; align-items:center; gap:8px;">
        <i class="fa-solid fa-shield-halved"></i>
        <span>جميع إشعارات النظام (الفواتير، المدفوعات، الشيكات، كشف الحساب، التذكيرات، التقارير) تذهب إلى هذا الرقم <strong>حصراً</strong>. لا يُرسل أي إشعار للزبائن أو التجار.</span>
      </div>
      <div class="switch-row">
        <div class="switch-info">
          <div class="sw-title">🤖 تفعيل بوت التحكم من واتساب</div>
          <div class="sw-desc">يُمكّنك من إدارة النظام بالكامل من واتسابك — اكتب "مساعدة" لعرض الأوامر</div>
        </div>
        <div class="form-check form-switch mb-0">
          <input class="form-check-input" type="checkbox" name="waBotEnabled"
                 <%= settings.waBotEnabled ? 'checked' : '' %>>
        </div>
      </div>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">رقم واتساب المدير</label>
          <input type="text" class="form-control" name="waManagerPhone"
                 value="<%= settings.waManagerPhone || '' %>"
                 placeholder="مثال: 0501234567">
          <div class="form-text" style="font-size:11px;color:var(--text-muted);">المستلم الوحيد لجميع إشعارات النظام</div>
        </div>
        <div class="col-md-6">
          <label class="form-label">وقت التقرير اليومي</label>
          <input type="time" class="form-control" name="waCronTime"
                 value="<%= settings.waCronTime || '09:00' %>">
        </div>
      </div>

      <hr style="border-color:var(--border-color); margin:18px 0;">
      <div class="switch-row">
        <div class="switch-info">
          <div class="sw-title">التقرير الأسبوعي (كشوفات الحسابات PDF)</div>
          <div class="sw-desc">يرسل كشف حساب PDF لكل زبون للمدير عبر واتساب</div>
        </div>
        <div class="form-check form-switch mb-0">
          <input class="form-check-input" type="checkbox" name="waWeeklyReportEnabled"
                 <%= settings.waWeeklyReportEnabled ? 'checked' : '' %>>
        </div>
      </div>

      <div class="row g-3 mt-1">
        <div class="col-md-6">
          <label class="form-label">يوم التقرير الأسبوعي</label>
          <select class="form-select" name="waWeeklyReportDay">
            <% ['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'].forEach((d,i) => { %>
              <option value="<%= i %>" <%= (settings.waWeeklyReportDay == i) ? 'selected' : '' %>><%= d %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">وقت التقرير الأسبوعي</label>
          <input type="time" class="form-control" name="waWeeklyReportTime"
                 value="<%= settings.waWeeklyReportTime || '08:00' %>">
        </div>
      </div>
    </div>

    <button type="submit" class="btn btn-gold w-100">
      <i class="fa-solid fa-floppy-disk"></i> حفظ إعدادات الواتساب
    </button>
  </form>

  <!-- ═══ Bot Instructions ═══ -->
  <div class="wa-section mt-4">
    <h5><i class="fa-solid fa-robot" style="color:#8b5cf6;"></i> بوت التحكم من واتساب</h5>
    <div style="background:#faf5ff; border:1px solid #c4b5fd; border-radius:10px; padding:16px; margin-bottom:14px; font-size:12.5px; color:#5b21b6;">
      <p style="margin:0 0 10px;"><strong>🤖 كيف يعمل البوت؟</strong></p>
      <p style="margin:0 0 8px;">أرسل أي أمر من رقم المدير المُحدَّد أعلاه وسيرة البوت يرد عليك فوراً.</p>
      <p style="margin:0 0 12px;">اكتب <code>مساعدة</code> في واتساب لعرض جميع الأوامر المتاحة.</p>
      <table style="width:100%; border-collapse:collapse; font-size:12px;">
        <thead><tr style="border-bottom:2px solid #c4b5fd;">
          <th style="padding:6px 8px; text-align:right;">الأمر</th>
          <th style="padding:6px 8px; text-align:right;">الوصف</th>
        </tr></thead>
        <tbody>
          <tr style="border-bottom:1px solid #e9d5ff;"><td style="padding:5px 8px;"><code>رصيد</code></td><td style="padding:5px 8px;">عرض أرصدة جميع الزبائن</td></tr>
          <tr style="border-bottom:1px solid #e9d5ff;"><td style="padding:5px 8px;"><code>رصيد [اسم]</code></td><td style="padding:5px 8px;">عرض رصيد طرف محدد + آخر الحركات</td></tr>
          <tr style="border-bottom:1px solid #e9d5ff;"><td style="padding:5px 8px;"><code>كشف [اسم]</code></td><td style="padding:5px 8px;">كشف حساب تفصيلي</td></tr>
          <tr style="border-bottom:1px solid #e9d5ff;"><td style="padding:5px 8px;"><code>فواتير</code></td><td style="padding:5px 8px;">الفواتير المعلقة</td></tr>
          <tr style="border-bottom:1px solid #e9d5ff;"><td style="padding:5px 8px;"><code>شيكات</code></td><td style="padding:5px 8px;">الشيكات المستحقة</td></tr>
          <tr style="border-bottom:1px solid #e9d5ff;"><td style="padding:5px 8px;"><code>دفعات [اسم]</code></td><td style="padding:5px 8px;">آخر الدفعات لطرف</td></tr>
          <tr style="border-bottom:1px solid #e9d5ff;"><td style="padding:5px 8px;"><code>زبائن</code> / <code>تجار</code></td><td style="padding:5px 8px;">قائمة الزبائن أو التجار</td></tr>
          <tr style="border-bottom:1px solid #e9d5ff;"><td style="padding:5px 8px;"><code>تقرير</code></td><td style="padding:5px 8px;">تقرير شامل</td></tr>
          <tr style="border-bottom:1px solid #e9d5ff;"><td style="padding:5px 8px;"><code>دفعة [اسم] [مبلغ] [نقد]</code></td><td style="padding:5px 8px;">تسجيل دفعة (نقد/شيك/تحويل/بطاقة)</td></tr>
          <tr style="border-bottom:1px solid #e9d5ff;"><td style="padding:5px 8px;"><code>فاتورة [اسم] [مبلغ]</code></td><td style="padding:5px 8px;">إنشاء فاتورة جديدة</td></tr>
          <tr style="border-bottom:1px solid #e9d5ff;"><td style="padding:5px 8px;"><code>حركة [اسم] [مبلغ] [مدين] [وصف]</code></td><td style="padding:5px 8px;">إضافة حركة يدوية</td></tr>
          <tr><td style="padding:5px 8px;"><code>تذكير</code></td><td style="padding:5px 8px;">تشغيل التذكيرات الآن</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ═══ Bulk Actions ═══ -->
  <div class="wa-section mt-4">
    <h5><i class="fa-solid fa-paper-plane" style="color:#0ea5e9;"></i> إجراءات جماعية</h5>
    <div class="d-flex gap-2 flex-wrap">
      <form method="POST" action="/admin/whatsapp-bulk"
            onsubmit="return confirm('سيتم إرسال ملخص الشيكات المعلقة للمدير فقط. متأكد؟');">
        <button class="btn btn-outline-primary btn-sm">
          <i class="fa-solid fa-bullhorn"></i> إرسال ملخص الشيكات المعلقة للمدير
        </button>
      </form>
      <form method="POST" action="/admin/whatsapp-manager-report"
            onsubmit="return confirm('سيتم إرسال كشوفات حسابات جميع الزبائن للمدير عبر واتساب. متأكد؟');">
        <button class="btn btn-outline-info btn-sm">
          <i class="fa-solid fa-chart-bar"></i> إرسال كشوفات الحسابات للمدير
        </button>
      </form>
    </div>
    <div class="form-text mt-2" style="font-size:12px;color:var(--text-muted);">
      جميع الإجراءات أعلاه تُرسل إلى المدير فقط.
    </div>
  </div>

  <!-- ═══ سجل الرسائل ═══ -->
  <div class="wa-section mt-4">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
      <h5 class="mb-0"><i class="fa-solid fa-list-check" style="color:#10b981;"></i> سجل الرسائل (آخر 100)</h5>
      <div class="d-flex gap-2">
        <form method="POST" action="/admin/whatsapp-logs-clear" style="display:inline;">
          <input type="hidden" name="mode" value="old">
          <button class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-clock-rotate-left"></i> حذف الأقدم من 30 يوم
          </button>
        </form>
        <form method="POST" action="/admin/whatsapp-logs-clear"
              onsubmit="return confirm('هل تريد حذف جميع سجلات الرسائل؟');" style="display:inline;">
          <input type="hidden" name="mode" value="all">
          <button class="btn btn-sm btn-outline-danger">
            <i class="fa-solid fa-trash"></i> مسح الكل
          </button>
        </form>
      </div>
    </div>

    <% if (!logs || logs.length === 0) { %>
      <div class="empty-state">
        <i class="fa-regular fa-comment-dots d-block"></i>
        لا توجد سجلات بعد
      </div>
    <% } else { %>
      <div class="logs-table-wrap">
        <table class="logs-table">
          <thead>
            <tr>
              <th>الوقت</th>
              <th>الطرف</th>
              <th>النوع</th>
              <th>الهاتف</th>
              <th>الحالة</th>
              <th>سبب الفشل</th>
            </tr>
          </thead>
          <tbody>
            <% logs.forEach(l => { %>
              <tr>
                <td style="white-space:nowrap;"><%= new Date(l.sentAt).toLocaleString('ar-EG') %></td>
                <td><strong><%= l.partyName || '-' %></strong></td>
                <td><code style="font-size:11px;"><%= l.messageType || '-' %></code></td>
                <td dir="ltr"><%= l.partyPhone || '-' %></td>
                <td><span class="badge-<%= l.status %>"><%= l.status === 'SUCCESS' ? '✓ نجح' : '✗ فشل' %></span></td>
                <td style="font-size:11px; color:var(--text-muted);"><%= l.failReason || '' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- ═══ سجل Cron ═══ -->
  <div class="wa-section mt-4">
    <h5><i class="fa-solid fa-clock" style="color:#f59e0b;"></i> سجل المهام التلقائية (آخر 20)</h5>
    <% if (!cronHistory || cronHistory.length === 0) { %>
      <div class="empty-state">
        <i class="fa-regular fa-clock d-block"></i>
        لم تُنفَّذ أي مهمة تلقائية بعد
      </div>
    <% } else { %>
      <div class="logs-table-wrap">
        <table class="logs-table">
          <thead>
            <tr>
              <th>وقت البدء</th>
              <th>وقت الانتهاء</th>
              <th>شيكات فُحصت</th>
              <th>رسائل نجحت</th>
              <th>رسائل فشلت</th>
              <th>ملاحظات</th>
            </tr>
          </thead>
          <tbody>
            <% cronHistory.forEach(h => { %>
              <tr>
                <td style="white-space:nowrap;"><%= h.startTime ? new Date(h.startTime).toLocaleString('ar-EG') : '-' %></td>
                <td style="white-space:nowrap;"><%= h.endTime   ? new Date(h.endTime).toLocaleString('ar-EG')   : '-' %></td>
                <td class="text-center"><%= h.checksScanned   || 0 %></td>
                <td class="text-center" style="color:#166534; font-weight:700;"><%= h.messagesSent   || 0 %></td>
                <td class="text-center" style="color:#991b1b; font-weight:700;"><%= h.messagesFailed || 0 %></td>
                <td style="font-size:11px; color:var(--text-muted);"><%= h.lastError || '' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

</div>

<%- include('../partials/admin-footer') %>
