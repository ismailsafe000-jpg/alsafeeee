<%- include('../partials/admin-header') %>
<style>
  .gb-page { max-width: 900px; margin: 0 auto; }
  .gb-header { text-align: center; padding: 18px 0 10px; }
  .gb-header h2 { font-size: 22px; font-weight: 800; color: #1e293b; margin: 0; }
  .gb-header p { color: #64748b; font-size: 13px; margin: 4px 0 0; }

  .gb-section { background: var(--card-bg, white); border-radius: 12px; border: 1px solid var(--border-color, #e2e8f0); overflow: hidden; margin-bottom: 28px; }
  .gb-section-title {
    padding: 14px 22px; font-weight: 800; font-size: 15px;
    display: flex; align-items: center; gap: 10px;
    border-bottom: 2px solid var(--border-color, #e2e8f0);
    background: var(--table-hover, #f8fafc);
  }
  @media (max-width: 768px) {
    .gb-section { overflow-x: auto; }
    .gb-table { min-width: 500px; font-size: 12px; }
    .summary-cards { grid-template-columns: 1fr; }
  }
  .gb-section-title.customers { color: #1e40af; border-bottom-color: #1e40af; }
  .gb-section-title.dealers { color: #065f46; border-bottom-color: #065f46; }

  .gb-table { width: 100%; border-collapse: collapse; }
  .gb-table thead tr { background: #f1f5f9; }
  .gb-table thead th { padding: 11px 14px; text-align: center; font-size: 13px; font-weight: 700; color: #334155; border-bottom: 1px solid #e2e8f0; }
  .gb-table tbody td { padding: 10px 14px; text-align: center; font-size: 13px; border-bottom: 1px solid #f1f5f9; }
  .gb-table tbody tr:last-child td { border-bottom: none; }
  .gb-table tbody tr:hover { background: #f8fafc; }
  .gb-table tfoot tr { background: #f1f5f9; font-weight: 800; }
  .gb-table tfoot td { padding: 12px 14px; text-align: center; font-size: 13px; border-top: 2px solid #e2e8f0; }

  .name-cell { text-align: right !important; font-weight: 700; }
  .phone-cell { color: #64748b; direction: ltr; }
  .debit-col { color: #b91c1c; font-weight: 700; }
  .credit-col { color: #15803d; font-weight: 700; }
  .bal-pos { color: #b91c1c; font-weight: 800; }
  .bal-neg { color: #1d4ed8; font-weight: 800; }
  .bal-zero { color: #15803d; font-weight: 800; }
  .empty-notice { text-align: center; padding: 30px; color: #94a3b8; font-size: 14px; }

  .actions-bar { display: flex; gap: 10px; margin-bottom: 18px; }
  .print-note { color: #94a3b8; font-size: 12px; text-align: center; margin-top: 12px; }

  /* ===== طباعة ===== */
  @media print {
    body { background: white !important; margin: 0; padding: 0; }
    .no-print, .navbar, .navbar-luxury, nav, .actions-bar { display: none !important; }
    .container.py-4 { padding: 0 !important; }
    .gb-page { max-width: 100%; }

    .print-header { display: block !important; text-align: center; padding: 10px 0 14px; border-bottom: 2px solid #000; margin-bottom: 16px; }
    .print-header .store-name { font-size: 18px; font-weight: 800; margin: 0 0 2px; }
    .print-header .doc-title { font-size: 14px; font-weight: 700; margin: 6px 0 2px; }
    .print-header .doc-date { font-size: 11px; color: #555; }

    .gb-section { border: 1px solid #ccc; border-radius: 0; margin-bottom: 18px; page-break-inside: avoid; }
    .gb-section-title { background: white !important; padding: 8px 14px; font-size: 13px; }
    .gb-section-title.customers { color: #000; border-bottom-color: #000; }
    .gb-section-title.dealers { color: #000; border-bottom-color: #000; }

    .gb-table { font-size: 10pt; }
    .gb-table thead tr { background: #eee !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .gb-table thead th { padding: 7px 10px; color: #000 !important; border-bottom: 1px solid #999; }
    .gb-table tbody td { padding: 6px 10px; border-bottom: 1px solid #ddd; }
    .gb-table tfoot tr { background: #eee !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .gb-table tfoot td { padding: 7px 10px; border-top: 2px solid #999; }

    .debit-col, .credit-col, .bal-pos, .bal-neg, .bal-zero { color: #000 !important; }

    @page { margin: 12mm; size: A4; }
  }

  .print-header { display: none; }
</style>

<div class="no-print actions-bar">
  <h2 class="section-title mb-0" style="font-size:18px;">
    <i class="fa-solid fa-scale-balanced"></i> كشف الأرصدة العام
  </h2>
  <div style="margin-right: auto; display:flex; gap:8px;">
    <button class="btn btn-primary" onclick="window.print()">
      <i class="fa-solid fa-print"></i> طباعة / حفظ PDF
    </button>
  </div>
</div>

<!-- ترويسة الطباعة فقط -->
<div class="print-header">
  <% if(settings && settings.storeLogo){ %>
    <img src="<%= settings.storeLogo %>" height="60" style="margin-bottom:8px;"><br>
  <% } %>
  <div class="store-name"><%= settings ? settings.storeName : '' %></div>
  <% if(settings && settings.storePhone){ %><div style="font-size:12px;"><%= settings.storePhone %></div><% } %>
  <div class="doc-title">كشف الأرصدة الإجمالي العام</div>
  <div class="doc-date">تاريخ الإصدار: <%= new Date().toLocaleDateString('ar-EG', {year:'numeric', month:'long', day:'numeric'}) %></div>
</div>

<div class="gb-page">

  <!-- قسم الزبائن -->
  <div class="gb-section">
    <div class="gb-section-title customers">
      <i class="fa-solid fa-users no-print"></i>
      أرصدة الزبائن
      <span style="font-size:12px; font-weight:400; color:#64748b; margin-right:auto;" class="no-print">
        <%= customerRows.length %> زبون
      </span>
    </div>
    <table class="gb-table">
      <thead>
        <tr>
          <th style="width:5%">#</th>
          <th style="width:30%; text-align:right; padding-right:20px;">اسم الزبون</th>
          <th style="width:15%">الهاتف</th>
          <th style="width:16%">إجمالي المدين ₪</th>
          <th style="width:16%">إجمالي الدائن ₪</th>
          <th style="width:18%">الرصيد المتبقي ₪</th>
        </tr>
      </thead>
      <tbody>
        <% if(customerRows.length === 0) { %>
          <tr><td colspan="6" class="empty-notice">لا يوجد زبائن مسجلون</td></tr>
        <% } else { %>
          <% customerRows.forEach((r, i) => { %>
          <tr>
            <td style="color:#94a3b8;"><%= i+1 %></td>
            <td class="name-cell">
              <a href="/admin/statement/customer/<%= r.id %>" style="color:inherit; text-decoration:none;" class="no-print"><%= r.name %></a>
              <span class="print-only" style="display:none;"><%= r.name %></span>
            </td>
            <td class="phone-cell"><%= r.phone || '-' %></td>
            <td class="debit-col"><%= r.totalDebit.toLocaleString('ar-EG') %></td>
            <td class="credit-col"><%= r.totalCredit.toLocaleString('ar-EG') %></td>
            <td class="<%= r.balance > 0 ? 'bal-pos' : (r.balance < 0 ? 'bal-neg' : 'bal-zero') %>">
              <%= r.balance.toLocaleString('ar-EG') %>
              <% if(r.balance > 0){ %><span style="font-size:10px; font-weight:400; display:block;">مستحق عليه</span><% } else if(r.balance < 0){ %><span style="font-size:10px; font-weight:400; display:block;">رصيد لصالحه</span><% } else { %><span style="font-size:10px; font-weight:400; display:block;">مسوّى</span><% } %>
            </td>
          </tr>
          <% }) %>
        <% } %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3" style="text-align:right; padding-right:20px;">المجموع الكلي للزبائن</td>
          <td class="debit-col"><%= customerTotals.totalDebit.toLocaleString('ar-EG') %></td>
          <td class="credit-col"><%= customerTotals.totalCredit.toLocaleString('ar-EG') %></td>
          <td class="<%= customerTotals.balance > 0 ? 'bal-pos' : (customerTotals.balance < 0 ? 'bal-neg' : 'bal-zero') %>">
            <%= customerTotals.balance.toLocaleString('ar-EG') %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>

  <!-- قسم التجار -->
  <div class="gb-section">
    <div class="gb-section-title dealers">
      <i class="fa-solid fa-handshake no-print"></i>
      أرصدة التجار
      <span style="font-size:12px; font-weight:400; color:#64748b; margin-right:auto;" class="no-print">
        <%= dealerRows.length %> تاجر
      </span>
    </div>
    <table class="gb-table">
      <thead>
        <tr>
          <th style="width:5%">#</th>
          <th style="width:30%; text-align:right; padding-right:20px;">اسم التاجر</th>
          <th style="width:15%">الهاتف</th>
          <th style="width:16%">إجمالي المدين ₪</th>
          <th style="width:16%">إجمالي الدائن ₪</th>
          <th style="width:18%">الرصيد المتبقي ₪</th>
        </tr>
      </thead>
      <tbody>
        <% if(dealerRows.length === 0) { %>
          <tr><td colspan="6" class="empty-notice">لا يوجد تجار مسجلون</td></tr>
        <% } else { %>
          <% dealerRows.forEach((r, i) => { %>
          <tr>
            <td style="color:#94a3b8;"><%= i+1 %></td>
            <td class="name-cell">
              <a href="/admin/statement/dealer/<%= r.id %>" style="color:inherit; text-decoration:none;" class="no-print"><%= r.name %></a>
              <span class="print-only" style="display:none;"><%= r.name %></span>
            </td>
            <td class="phone-cell"><%= r.phone || '-' %></td>
            <td class="debit-col"><%= r.totalDebit.toLocaleString('ar-EG') %></td>
            <td class="credit-col"><%= r.totalCredit.toLocaleString('ar-EG') %></td>
            <td class="<%= r.balance > 0 ? 'bal-pos' : (r.balance < 0 ? 'bal-neg' : 'bal-zero') %>">
              <%= r.balance.toLocaleString('ar-EG') %>
              <% if(r.balance > 0){ %><span style="font-size:10px; font-weight:400; display:block;">مستحق عليه</span><% } else if(r.balance < 0){ %><span style="font-size:10px; font-weight:400; display:block;">رصيد لصالحه</span><% } else { %><span style="font-size:10px; font-weight:400; display:block;">مسوّى</span><% } %>
            </td>
          </tr>
          <% }) %>
        <% } %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3" style="text-align:right; padding-right:20px;">المجموع الكلي للتجار</td>
          <td class="debit-col"><%= dealerTotals.totalDebit.toLocaleString('ar-EG') %></td>
          <td class="credit-col"><%= dealerTotals.totalCredit.toLocaleString('ar-EG') %></td>
          <td class="<%= dealerTotals.balance > 0 ? 'bal-pos' : (dealerTotals.balance < 0 ? 'bal-neg' : 'bal-zero') %>">
            <%= dealerTotals.balance.toLocaleString('ar-EG') %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>

  <p class="print-note no-print">لحفظ كـ PDF: اضغط طباعة ثم اختر "حفظ كـ PDF" من قائمة الطابعات</p>
</div>

<style>
  @media print { .print-only { display: inline !important; } .no-print { display: none !important; } }
</style>

<%- include('../partials/admin-footer') %>
