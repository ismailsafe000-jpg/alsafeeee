<%- include('../partials/admin-header') %>

<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
  <h2 class="section-title mb-0"><i class="fa-solid fa-users"></i> إدارة الزبائن</h2>
  <a href="/admin/customers/add" class="btn btn-gold"><i class="fa-solid fa-plus"></i> إضافة زبون جديد</a>
</div>

<% if (customers.length === 0) { %>
  <div class="text-center py-5" style="background: var(--card-bg); border-radius: var(--radius); border: 1px solid var(--border-color);">
    <i class="fa-solid fa-users fa-3x mb-3" style="color: var(--primary-gold);"></i>
    <h5 style="color: var(--text-muted);">لا يوجد زبائن بعد</h5>
    <a href="/admin/customers/add" class="btn btn-gold mt-2"><i class="fa-solid fa-plus"></i> إضافة أول زبون</a>
  </div>
<% } else { %>

<!-- Desktop Table -->
<div class="table-responsive-wrap d-none d-md-block">
  <div class="table-luxury">
    <table class="table table-luxury mb-0">
      <thead>
        <tr>
          <th>الاسم الكامل</th>
          <th>رقم الهاتف</th>
          <th>العنوان</th>
          <th>تاريخ التسجيل</th>
          <th>إجراءات</th>
        </tr>
      </thead>
      <tbody>
        <% customers.forEach(c => { %>
          <tr>
            <td class="fw-bold"><%= c.fullName %></td>
            <td><%= c.phone || '-' %></td>
            <td><%= c.address || '-' %></td>
            <td style="font-size:13px;"><%= new Date(c.createdAt).toLocaleDateString('ar-EG') %></td>
            <td>
              <a href="/admin/customers/<%= c._id %>/visits" class="btn btn-sm btn-warning text-dark me-1">
                <i class="fa-solid fa-calendar-check"></i> زيارات
              </a>
              <a href="/admin/statement/customer/<%= c._id %>" class="btn btn-sm btn-info text-white me-1">
                <i class="fa-solid fa-file-invoice-dollar"></i> كشف
              </a>
              <a href="/admin/customers/edit/<%= c._id %>" class="btn btn-sm btn-outline-gold me-1">
                <i class="fa-solid fa-pen"></i>
              </a>
              <a href="/admin/customers/delete/<%= c._id %>" class="btn btn-sm btn-danger"
                 onclick="return confirm('هل أنت متأكد من حذف <%= c.fullName %>؟')">
                <i class="fa-solid fa-trash"></i>
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Mobile Cards -->
<div class="d-md-none">
  <% customers.forEach(c => { %>
    <div class="invoice-card">
      <div class="fw-bold mb-1" style="font-size:15px;"><%= c.fullName %></div>
      <div class="mb-2" style="font-size:13px; color:var(--text-muted);">
        <% if (c.phone) { %><i class="fa-solid fa-phone me-1"></i><%= c.phone %><% } %>
        <% if (c.address) { %>&nbsp;&nbsp;<i class="fa-solid fa-map-marker-alt me-1"></i><%= c.address %><% } %>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <a href="/admin/customers/<%= c._id %>/visits" class="btn btn-sm btn-warning text-dark">
          <i class="fa-solid fa-calendar-check"></i> زيارات
        </a>
        <a href="/admin/statement/customer/<%= c._id %>" class="btn btn-sm btn-info text-white">
          <i class="fa-solid fa-file-invoice-dollar"></i> كشف حساب
        </a>
        <a href="/admin/customers/edit/<%= c._id %>" class="btn btn-sm btn-outline-gold">
          <i class="fa-solid fa-pen"></i> تعديل
        </a>
        <a href="/admin/customers/delete/<%= c._id %>" class="btn btn-sm btn-danger"
           onclick="return confirm('هل أنت متأكد من حذف <%= c.fullName %>؟')">
          <i class="fa-solid fa-trash"></i>
        </a>
      </div>
    </div>
  <% }) %>
</div>

<% } %>

<%- include('../partials/admin-footer') %>
