<%- include('../partials/admin-header') %>

<style>
.meas-header{background:linear-gradient(135deg,#0f172a,#1e3a5f);border-radius:16px;padding:22px 28px;color:white;margin-bottom:24px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px;}
.meas-header .cust-info{display:flex;flex-direction:column;gap:4px;}
.meas-header .cust-name{font-size:22px;font-weight:800;color:#d4af37;}
.meas-header .cust-meta{font-size:13px;color:#94a3b8;display:flex;gap:18px;flex-wrap:wrap;}
.meas-header .cust-meta span{display:flex;align-items:center;gap:5px;}
.meas-actions{display:flex;gap:10px;flex-wrap:wrap;}
.btn-save-main{background:linear-gradient(135deg,#d4af37,#c5a030);color:white;border:none;padding:11px 24px;border-radius:10px;font-weight:700;font-size:14px;font-family:'Cairo',sans-serif;cursor:pointer;display:flex;align-items:center;gap:7px;transition:.2s;}
.btn-save-main:hover{transform:scale(1.03);}
.btn-print-main{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:white;padding:11px 20px;border-radius:10px;font-weight:600;font-size:14px;font-family:'Cairo',sans-serif;cursor:pointer;display:flex;align-items:center;gap:7px;}
.btn-print-main:hover{background:rgba(255,255,255,.15);}
.back-btn{color:#94a3b8;text-decoration:none;font-size:13px;display:flex;align-items:center;gap:5px;margin-bottom:4px;}
.back-btn:hover{color:#d4af37;}

/* Tabs */
.meas-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:20px;background:var(--card-bg);border-radius:12px;padding:8px;border:1px solid var(--border-color);}
.meas-tab{padding:9px 16px;border-radius:8px;border:none;background:transparent;color:var(--text-muted);font-family:'Cairo',sans-serif;font-weight:600;font-size:13px;cursor:pointer;transition:.2s;display:flex;align-items:center;gap:6px;white-space:nowrap;}
.meas-tab.active{background:linear-gradient(135deg,#d4af37,#c5a030);color:white;}
.meas-tab:hover:not(.active){background:rgba(212,175,55,.1);color:#d4af37;}
.tab-panel{display:none;animation:fadeIn .2s;}
.tab-panel.active{display:block;}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}

/* Section cards */
.sec-card{background:var(--card-bg);border-radius:14px;border:1px solid var(--border-color);padding:24px;margin-bottom:16px;}
.sec-title{font-size:16px;font-weight:800;color:var(--text-main);margin-bottom:18px;display:flex;align-items:center;gap:8px;padding-bottom:12px;border-bottom:2px solid rgba(212,175,55,.3);}
.sec-title i{color:#d4af37;}
.form-label{font-weight:700;font-size:13px;color:var(--text-main);margin-bottom:5px;}
.form-control,.form-select{border-radius:8px;border:1px solid var(--border-color);padding:9px 12px;background:var(--card-bg);color:var(--text-main);font-family:'Cairo',sans-serif;font-size:13px;width:100%;}
.form-control:focus,.form-select:focus{border-color:#d4af37;outline:none;box-shadow:0 0 0 3px rgba(212,175,55,.15);}
[data-theme="dark"] .form-control,[data-theme="dark"] .form-select{background:#1c2128;border-color:#30363d;color:#e6edf3;}

/* Style image */
.style-img-wrap{border:2px dashed var(--border-color);border-radius:10px;padding:12px;text-align:center;cursor:pointer;position:relative;transition:.2s;}
.style-img-wrap:hover{border-color:#d4af37;}
.style-img-preview{max-height:130px;border-radius:8px;display:none;}
.style-img-label{font-size:12px;color:var(--text-muted);}

/* Rooms / Windows */
.item-row{background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px;padding:16px;margin-bottom:12px;position:relative;}
.item-row .remove-btn{position:absolute;top:10px;left:10px;background:#fee2e2;border:none;color:#dc2626;width:28px;height:28px;border-radius:6px;cursor:pointer;font-size:13px;display:flex;align-items:center;justify-content:center;}
.item-row .remove-btn:hover{background:#dc2626;color:white;}
.add-item-btn{width:100%;padding:10px;border:2px dashed rgba(212,175,55,.4);border-radius:10px;background:rgba(212,175,55,.05);color:#d4af37;font-family:'Cairo',sans-serif;font-weight:700;font-size:14px;cursor:pointer;transition:.2s;}
.add-item-btn:hover{background:rgba(212,175,55,.1);border-color:#d4af37;}

/* Canvas */
#drawingCanvas{border:1px solid var(--border-color);border-radius:12px;cursor:crosshair;display:block;max-width:100%;touch-action:none;}
.canvas-wrap{background:white;border-radius:12px;overflow:hidden;position:relative;}
.canvas-tools{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;align-items:center;}
.tool-btn{padding:8px 14px;border:1px solid var(--border-color);border-radius:8px;background:var(--card-bg);color:var(--text-main);font-family:'Cairo',sans-serif;font-size:13px;cursor:pointer;transition:.2s;display:flex;align-items:center;gap:5px;}
.tool-btn.active,.tool-btn:hover{background:rgba(212,175,55,.15);border-color:#d4af37;color:#d4af37;}
.tool-sep{width:1px;height:30px;background:var(--border-color);}
input[type="color"]{width:36px;height:36px;border:1px solid var(--border-color);border-radius:8px;cursor:pointer;padding:2px;}
input[type="range"]{width:100px;}
.canvas-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;}

/* Photos */
.photos-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:12px;margin-top:14px;}
.photo-item{position:relative;border-radius:10px;overflow:hidden;border:1px solid var(--border-color);}
.photo-item img{width:100%;height:110px;object-fit:cover;display:block;}
.photo-del{position:absolute;top:4px;left:4px;background:rgba(220,38,38,.85);color:white;border:none;border-radius:6px;width:26px;height:26px;cursor:pointer;font-size:12px;display:flex;align-items:center;justify-content:center;}
.photo-upload-zone{border:2px dashed var(--border-color);border-radius:10px;padding:20px;text-align:center;cursor:pointer;transition:.2s;}
.photo-upload-zone:hover{border-color:#d4af37;background:rgba(212,175,55,.04);}

/* Toast */
.meas-toast{position:fixed;top:80px;left:50%;transform:translateX(-50%);padding:12px 24px;border-radius:10px;font-weight:700;font-size:14px;z-index:9999;display:none;font-family:'Cairo',sans-serif;}
.meas-toast.ok{background:#dcfce7;color:#166534;border:1px solid #bbf7d0;}
.meas-toast.err{background:#fee2e2;color:#dc2626;border:1px solid #fecaca;}

/* Print */
@media print{
  .meas-header .meas-actions,.meas-tabs,.add-item-btn,.remove-btn,.canvas-tools,.canvas-actions,.no-print,nav,.photo-upload-zone{display:none!important;}
  .tab-panel{display:block!important;}
  body{background:white!important;}
  .sec-card{break-inside:avoid;box-shadow:none!important;border:1px solid #ccc!important;}
  .print-sig{display:flex!important;}
  @page{size:A4;margin:12mm;}
}
.print-sig{display:none;justify-content:space-between;margin-top:30px;}
.print-sig .sig-box{border-top:1px solid #000;width:160px;text-align:center;padding-top:6px;font-size:12px;}
</style>

<!-- Toast -->
<div class="meas-toast" id="mToast"></div>

<!-- Header -->
<a href="/admin/customers" class="back-btn no-print"><i class="fa-solid fa-arrow-right"></i> العودة للزبائن</a>

<div class="meas-header">
  <div class="cust-info">
    <div class="cust-name"><i class="fa-solid fa-user me-1"></i> <%= customer.fullName %></div>
    <div class="cust-meta">
      <% if(customer.phone){%><span><i class="fa-solid fa-phone"></i> <%= customer.phone %></span><%}%>
      <% if(customer.address){%><span><i class="fa-solid fa-map-marker-alt"></i> <%= customer.address %></span><%}%>
      <span><i class="fa-solid fa-calendar"></i>
        <input type="date" id="measDate" value="<%= measurement.measurementDate ? new Date(measurement.measurementDate).toISOString().slice(0,10) : new Date().toISOString().slice(0,10) %>"
          style="background:transparent;border:none;color:#94a3b8;font-family:'Cairo',sans-serif;font-size:13px;cursor:pointer;">
      </span>
    </div>
  </div>
  <div class="meas-actions">
    <button class="btn-print-main no-print" onclick="window.print()"><i class="fa-solid fa-print"></i> طباعة</button>
    <button class="btn-save-main no-print" onclick="saveAll()"><i class="fa-solid fa-floppy-disk"></i> حفظ المقاسات</button>
  </div>
</div>

<!-- Tabs -->
<div class="meas-tabs no-print" id="tabsNav">
  <button class="meas-tab active" onclick="switchTab('sofa',this)"><i class="fa-solid fa-couch"></i> الكنب</button>
  <button class="meas-tab" onclick="switchTab('qaada',this)"><i class="fa-solid fa-chair"></i> القعدة</button>
  <button class="meas-tab" onclick="switchTab('carpet',this)"><i class="fa-solid fa-border-all"></i> الموكيت</button>
  <button class="meas-tab" onclick="switchTab('windows',this)"><i class="fa-solid fa-window-maximize"></i> البرادي</button>
  <button class="meas-tab" onclick="switchTab('canvas',this)"><i class="fa-solid fa-pen-nib"></i> لوحة الرسم</button>
  <button class="meas-tab" onclick="switchTab('photos',this)"><i class="fa-solid fa-images"></i> الصور</button>
  <button class="meas-tab" onclick="switchTab('notes',this)"><i class="fa-solid fa-note-sticky"></i> ملاحظات</button>
</div>

<!-- ===== TAB: الكنب ===== -->
<div class="tab-panel active" id="panel-sofa">
  <div class="sec-card">
    <div class="sec-title"><i class="fa-solid fa-couch"></i> بيانات الكنب</div>
    <div class="row g-3">
      <div class="col-md-4"><label class="form-label">نوع الكنب</label><input class="form-control" id="sofa_sofaType" value="<%= measurement.sofa && measurement.sofa.sofaType || '' %>"></div>
      <div class="col-md-2"><label class="form-label">عدد المقاعد</label><input type="number" class="form-control" id="sofa_seats" value="<%= measurement.sofa && measurement.sofa.seats || '' %>"></div>
      <div class="col-md-3"><label class="form-label">نوع الإسفنج</label><input class="form-control" id="sofa_foamType" value="<%= measurement.sofa && measurement.sofa.foamType || '' %>"></div>
      <div class="col-md-3"><label class="form-label">نوع القماش</label><input class="form-control" id="sofa_fabricType" value="<%= measurement.sofa && measurement.sofa.fabricType || '' %>"></div>
      <div class="col-md-3"><label class="form-label">اللون</label><input class="form-control" id="sofa_color" value="<%= measurement.sofa && measurement.sofa.color || '' %>"></div>
      <div class="col-md-3"><label class="form-label">نوع الأرجل</label><input class="form-control" id="sofa_legType" value="<%= measurement.sofa && measurement.sofa.legType || '' %>"></div>
      <div class="col-md-2"><label class="form-label">عدد المخدات</label><input type="number" class="form-control" id="sofa_cushionCount" value="<%= measurement.sofa && measurement.sofa.cushionCount || '' %>"></div>
      <div class="col-md-4">
        <label class="form-label">نوع الطقم (صورة الستايل)</label>
        <div class="style-img-wrap" onclick="document.getElementById('sofa_styleFile').click()">
          <img id="sofa_stylePreview" class="style-img-preview" src="<%= measurement.sofa && measurement.sofa.styleImage || '' %>"
            <% if(measurement.sofa && measurement.sofa.styleImage){ %>style="display:block;"<% } %>>
          <div class="style-img-label"><i class="fa-solid fa-image me-1"></i> اضغط لرفع صورة الستايل</div>
          <input type="file" id="sofa_styleFile" accept="image/*" style="display:none" onchange="uploadStyle(this,'sofa','sofa_stylePreview','sofa_styleImage')">
          <input type="hidden" id="sofa_styleImage" value="<%= measurement.sofa && measurement.sofa.styleImage || '' %>">
        </div>
      </div>
      <div class="col-12"><label class="form-label">ملاحظات</label><textarea class="form-control" id="sofa_notes" rows="2"><%= measurement.sofa && measurement.sofa.notes || '' %></textarea></div>
    </div>
  </div>
</div>

<!-- ===== TAB: القعدة ===== -->
