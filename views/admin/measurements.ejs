  <div class="sec-card">
    <div class="sec-title"><i class="fa-solid fa-chair"></i> بيانات القعدة</div>
    <div class="row g-3">
      <div class="col-md-4"><label class="form-label">نوع القعدة</label><input class="form-control" id="qaada_sofaType" value="<%= measurement.qaada && measurement.qaada.sofaType || '' %>"></div>
