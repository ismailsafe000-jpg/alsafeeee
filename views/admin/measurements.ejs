      <div class="col-md-3"><label class="form-label">نوع الإسفنج</label><input class="form-control" id="qaada_foamType" value="<%= measurement.qaada && measurement.qaada.foamType || '' %>"></div>
      <div class="col-md-3"><label class="form-label">نوع القماش</label><input class="form-control" id="qaada_fabricType" value="<%= measurement.qaada && measurement.qaada.fabricType || '' %>"></div>
      <div class="col-md-3"><label class="form-label">اللون</label><input class="form-control" id="qaada_color" value="<%= measurement.qaada && measurement.qaada.color || '' %>"></div>
      <div class="col-md-3"><label class="form-label">نوع الأرجل</label><input class="form-control" id="qaada_legType" value="<%= measurement.qaada && measurement.qaada.legType || '' %>"></div>
      <div class="col-md-2"><label class="form-label">عدد المخدات</label><input type="number" class="form-control" id="qaada_cushionCount" value="<%= measurement.qaada && measurement.qaada.cushionCount || '' %>"></div>
      <div class="col-md-4">
        <label class="form-label">نوع الطقم (صورة الستايل)</label>
        <div class="style-img-wrap" onclick="document.getElementById('qaada_styleFile').click()">
          <img id="qaada_stylePreview" class="style-img-preview" src="<%= measurement.qaada && measurement.qaada.styleImage || '' %>"
            <% if(measurement.qaada && measurement.qaada.styleImage){ %>style="display:block;"<% } %>>
          <div class="style-img-label"><i class="fa-solid fa-image me-1"></i> اضغط لرفع صورة الستايل</div>
          <input type="file" id="qaada_styleFile" accept="image/*" style="display:none" onchange="uploadStyle(this,'qaada','qaada_stylePreview','qaada_styleImage')">
