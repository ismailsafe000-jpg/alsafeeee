        </div>
      </div>
      <div class="col-12"><label class="form-label">ملاحظات</label><textarea class="form-control" id="qaada_notes" rows="2"><%= measurement.qaada && measurement.qaada.notes || '' %></textarea></div>
    </div>
  </div>
</div>

<!-- ===== TAB: الموكيت ===== -->
<div class="tab-panel" id="panel-carpet">
  <div class="sec-card">
    <div class="sec-title"><i class="fa-solid fa-border-all"></i> الغرف والموكيت</div>
    <div id="roomsList"></div>
    <button class="add-item-btn no-print" onclick="addRoom()"><i class="fa-solid fa-plus me-1"></i> إضافة غرفة</button>
  </div>
</div>

<!-- ===== TAB: البرادي ===== -->
<div class="tab-panel" id="panel-windows">
  <div class="sec-card">
    <div class="sec-title"><i class="fa-solid fa-window-maximize"></i> الشبابيك والبرادي</div>
    <div id="windowsList"></div>
    <button class="add-item-btn no-print" onclick="addWindow()"><i class="fa-solid fa-plus me-1"></i> إضافة شباك</button>
  </div>
</div>

<!-- ===== TAB: لوحة الرسم ===== -->
<div class="tab-panel" id="panel-canvas">
  <div class="sec-card">
    <div class="sec-title"><i class="fa-solid fa-pen-nib"></i> لوحة الرسم</div>
    <div class="canvas-tools no-print">
      <button class="tool-btn active" id="tool-pencil" onclick="setTool('pencil',this)"><i class="fa-solid fa-pencil"></i> قلم</button>
      <button class="tool-btn" id="tool-line" onclick="setTool('line',this)"><i class="fa-solid fa-minus"></i> خط</button>
      <button class="tool-btn" id="tool-rect" onclick="setTool('rect',this)"><i class="fa-regular fa-square"></i> مربع</button>
      <button class="tool-btn" id="tool-circle" onclick="setTool('circle',this)"><i class="fa-regular fa-circle"></i> دائرة</button>
      <button class="tool-btn" id="tool-eraser" onclick="setTool('eraser',this)"><i class="fa-solid fa-eraser"></i> ممحاة</button>
      <div class="tool-sep"></div>
      <label style="font-size:12px;font-weight:600;">اللون</label>
      <input type="color" id="penColor" value="#1e293b" onchange="updateColor()">
      <label style="font-size:12px;font-weight:600;">السماكة</label>
      <input type="range" id="penSize" min="1" max="20" value="3" oninput="updateSize()">
      <span id="penSizeVal" style="font-size:12px;font-weight:700;min-width:22px;">3</span>
      <div class="tool-sep"></div>
      <button class="tool-btn" onclick="undoDraw()"><i class="fa-solid fa-rotate-left"></i> تراجع</button>
      <button class="tool-btn" onclick="clearCanvas()"><i class="fa-solid fa-trash"></i> مسح الكل</button>
    </div>
    <div class="canvas-wrap">
      <canvas id="drawingCanvas" width="900" height="600"></canvas>
    </div>
    <div style="font-size:12px;color:var(--text-muted);margin-top:8px;"><i class="fa-solid fa-info-circle me-1"></i> يتم حفظ الرسم تلقائياً عند الضغط على "حفظ المقاسات"</div>
  </div>
</div>

<!-- ===== TAB: الصور ===== -->
<div class="tab-panel" id="panel-photos">
  <div class="sec-card">
    <div class="sec-title"><i class="fa-solid fa-images"></i> الصور</div>
    <div class="photo-upload-zone no-print" onclick="document.getElementById('photoFileInput').click()">
      <i class="fa-solid fa-cloud-arrow-up fa-2x mb-2" style="color:#d4af37;"></i>
      <div style="font-weight:700;font-size:14px;">اضغط لرفع صور</div>
      <div style="font-size:12px;color:var(--text-muted);">يمكن رفع أكثر من صورة (كنب، موكيت، شبابيك...)</div>
      <input type="file" id="photoFileInput" accept="image/*" multiple style="display:none" onchange="uploadPhotos(this)">
    </div>
    <div class="photos-grid" id="photosGrid"></div>
  </div>
</div>

<!-- ===== TAB: الملاحظات ===== -->
<div class="tab-panel" id="panel-notes">
  <div class="sec-card">
    <div class="sec-title"><i class="fa-solid fa-note-sticky"></i> ملاحظات عامة</div>
    <textarea class="form-control" id="generalNotes" rows="8" placeholder="اكتب أي ملاحظات تخص الزبون أو التركيب..."><%= measurement.generalNotes || '' %></textarea>
  </div>
</div>

<!-- Print signature -->
<div class="print-sig">
  <div class="sig-box">توقيع الفني</div>
  <div class="sig-box">توقيع الزبون</div>
</div>

<script>
const CUST_ID = '<%= customer._id %>';

// ===== TABS =====
function switchTab(name, btn) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.meas-tab').forEach(b => b.classList.remove('active'));
  document.getElementById('panel-' + name).classList.add('active');
  btn.classList.add('active');
}

// ===== TOAST =====
function showToast(msg, type='ok') {
  const t = document.getElementById('mToast');
  t.textContent = msg; t.className = 'meas-toast ' + type; t.style.display = 'block';
  setTimeout(() => t.style.display = 'none', 3000);
}

// ===== ROOMS =====
let rooms = <%- JSON.stringify(measurement.rooms || []) %>;

function renderRooms() {
  const el = document.getElementById('roomsList');
  el.innerHTML = '';
  rooms.forEach((r, i) => {
    el.innerHTML += `
    <div class="item-row">
      <button class="remove-btn no-print" onclick="removeRoom(${i})"><i class="fa-solid fa-xmark"></i></button>
      <div style="font-weight:800;color:#d4af37;margin-bottom:12px;"><i class="fa-solid fa-border-all me-1"></i> غرفة ${i+1}</div>
      <div class="row g-2">
        <div class="col-md-3"><label class="form-label">اسم الغرفة</label>
          <input class="form-control" value="${escHtml(r.name||'')}" oninput="rooms[${i}].name=this.value"></div>
        <div class="col-md-2"><label class="form-label">الطول (م)</label>
          <input type="number" step="0.01" class="form-control" value="${r.length||''}" oninput="rooms[${i}].length=+this.value;calcArea(${i})"></div>
        <div class="col-md-2"><label class="form-label">العرض (م)</label>
          <input type="number" step="0.01" class="form-control" value="${r.width||''}" oninput="rooms[${i}].width=+this.value;calcArea(${i})"></div>
        <div class="col-md-2"><label class="form-label">المساحة (م²)</label>
          <input type="number" step="0.01" class="form-control" id="area_${i}" value="${r.area||''}" readonly style="background:rgba(212,175,55,.07);font-weight:700;"></div>
        <div class="col-md-3"><label class="form-label">نوع الموكيت</label>
          <input class="form-control" value="${escHtml(r.carpetType||'')}" oninput="rooms[${i}].carpetType=this.value"></div>
        <div class="col-md-3"><label class="form-label">اللون</label>
          <input class="form-control" value="${escHtml(r.color||'')}" oninput="rooms[${i}].color=this.value"></div>
      </div>
    </div>`;
  });
}
function addRoom() { rooms.push({name:'',length:0,width:0,area:0,carpetType:'',color:''}); renderRooms(); }
function removeRoom(i) { if(confirm('حذف هذه الغرفة؟')) { rooms.splice(i,1); renderRooms(); } }
function calcArea(i) { const a = (rooms[i].length||0)*(rooms[i].width||0); rooms[i].area=a; const el=document.getElementById('area_'+i); if(el) el.value=a.toFixed(2); }

// ===== WINDOWS =====
let windows = <%- JSON.stringify(measurement.windows || []) %>;

function renderWindows() {
  const el = document.getElementById('windowsList');
  el.innerHTML = '';
  windows.forEach((w, i) => {
    el.innerHTML += `
    <div class="item-row">
      <button class="remove-btn no-print" onclick="removeWindow(${i})"><i class="fa-solid fa-xmark"></i></button>
      <div style="font-weight:800;color:#d4af37;margin-bottom:12px;"><i class="fa-solid fa-window-maximize me-1"></i> شباك ${i+1}</div>
      <div class="row g-2">
        <div class="col-md-3"><label class="form-label">اسم المكان</label>
          <input class="form-control" value="${escHtml(w.location||'')}" oninput="windows[${i}].location=this.value" placeholder="غرفة ضيوف، مطبخ..."></div>
        <div class="col-md-2"><label class="form-label">العرض (سم)</label>
          <input type="number" class="form-control" value="${w.width||''}" oninput="windows[${i}].width=+this.value"></div>
        <div class="col-md-2"><label class="form-label">الارتفاع (سم)</label>
          <input type="number" class="form-control" value="${w.height||''}" oninput="windows[${i}].height=+this.value"></div>
        <div class="col-md-2"><label class="form-label">عدد الفتحات</label>
          <input type="number" class="form-control" value="${w.openings||1}" oninput="windows[${i}].openings=+this.value"></div>
        <div class="col-md-3"><label class="form-label">نوع القماش</label>
          <input class="form-control" value="${escHtml(w.fabricType||'')}" oninput="windows[${i}].fabricType=this.value"></div>
        <div class="col-md-3"><label class="form-label">اللون</label>
          <input class="form-control" value="${escHtml(w.color||'')}" oninput="windows[${i}].color=this.value"></div>
        <div class="col-md-4">
          <label class="form-label">نوع البرادي (اسم)</label>
          <input class="form-control" value="${escHtml(w.curtainTypeName||'')}" oninput="windows[${i}].curtainTypeName=this.value"></div>
        <div class="col-md-5">
          <label class="form-label">نوع البرادي (صورة) <span style="font-size:11px;color:#94a3b8;">اختياري</span></label>
          <div style="display:flex;gap:8px;align-items:center;">
            ${w.curtainTypeImage ? `<img src="${escHtml(w.curtainTypeImage)}" id="cimg_${i}" style="height:40px;border-radius:6px;border:1px solid #e2e8f0;">` : `<span id="cimg_${i}" style="font-size:12px;color:#94a3b8;">لا توجد صورة</span>`}
            <label style="cursor:pointer;padding:6px 12px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.3);border-radius:8px;font-size:12px;font-weight:700;color:#d4af37;white-space:nowrap;">
              <i class="fa-solid fa-upload"></i> رفع
              <input type="file" accept="image/*" style="display:none" onchange="uploadCurtainImg(this,${i})">
            </label>
          </div>
        </div>
        <div class="col-12"><label class="form-label">ملاحظات</label>
          <textarea class="form-control" rows="2" oninput="windows[${i}].notes=this.value">${escHtml(w.notes||'')}</textarea></div>
      </div>
    </div>`;
  });
}
function addWindow() { windows.push({location:'',width:0,height:0,curtainTypeName:'',curtainTypeImage:'',fabricType:'',color:'',openings:1,notes:''}); renderWindows(); }
function removeWindow(i) { if(confirm('حذف هذا الشباك؟')) { windows.splice(i,1); renderWindows(); } }

function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// ===== STYLE IMAGE UPLOAD =====
async function uploadStyle(input, section, previewId, hiddenId) {
  if (!input.files[0]) return;
  const fd = new FormData(); fd.append('image', input.files[0]);
  const res = await fetch(`/admin/measurements/upload-style/${CUST_ID}/${section}`, { method:'POST', body:fd });
  const data = await res.json();
  if (data.ok) {
    const img = document.getElementById(previewId);
    img.src = data.url; img.style.display = 'block';
    document.getElementById(hiddenId).value = data.url;
  } else showToast('فشل رفع الصورة', 'err');
}

async function uploadCurtainImg(input, winIndex) {
  if (!input.files[0]) return;
  const fd = new FormData(); fd.append('image', input.files[0]);
  const res = await fetch(`/admin/measurements/upload-curtain/${CUST_ID}`, { method:'POST', body:fd });
  const data = await res.json();
  if (data.ok) {
    windows[winIndex].curtainTypeImage = data.url;
    const el = document.getElementById('cimg_' + winIndex);
    if (el) { el.tagName === 'IMG' ? el.src = data.url : el.outerHTML = `<img src="${data.url}" id="cimg_${winIndex}" style="height:40px;border-radius:6px;border:1px solid #e2e8f0;">`; }
    showToast('تم رفع صورة البرادي ✓');
  } else showToast('فشل رفع الصورة','err');
}

// ===== PHOTOS =====
let photos = <%- JSON.stringify(measurement.photos || []) %>;

function renderPhotos() {
  const grid = document.getElementById('photosGrid');
  grid.innerHTML = '';
  photos.forEach((p, i) => {
    const div = document.createElement('div');
    div.className = 'photo-item';
    div.innerHTML = `<img src="${escHtml(p.url)}" alt="صورة ${i+1}">
      <button class="photo-del no-print" onclick="deletePhoto(${i})" title="حذف"><i class="fa-solid fa-trash"></i></button>`;
    grid.appendChild(div);
  });
}

async function uploadPhotos(input) {
  const files = [...input.files];
  for (const file of files) {
    const fd = new FormData(); fd.append('photo', file);
    const res = await fetch(`/admin/measurements/upload-photo/${CUST_ID}`, { method:'POST', body:fd });
    const data = await res.json();
    if (data.ok) { photos.push({ url: data.url, caption: '' }); renderPhotos(); showToast('تم رفع الصورة ✓'); }
    else showToast('فشل رفع الصورة','err');
  }
  input.value = '';
}

async function deletePhoto(index) {
  if (!confirm('حذف هذه الصورة؟')) return;
  const res = await fetch(`/admin/measurements/delete-photo/${CUST_ID}`, {
    method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({index})
  });
  const data = await res.json();
  if (data.ok) { photos.splice(index,1); renderPhotos(); showToast('تم حذف الصورة ✓'); }
}

// ===== CANVAS DRAWING =====
const canvas = document.getElementById('drawingCanvas');
const ctx = canvas.getContext('2d');
let tool = 'pencil', isDrawing = false, startX=0, startY=0;
let penColor = '#1e293b', penSize = 3;
let undoStack = [], snapshot = null;

// Resize canvas to fill container
function resizeCanvas() {
  const wrap = canvas.parentElement;
  const w = Math.min(wrap.offsetWidth - 2, 900);
  canvas.style.width = w + 'px';
}
resizeCanvas();
window.addEventListener('resize', resizeCanvas);

// Load saved canvas
const savedCanvas = `<%- (measurement.canvasData || '').replace(/`/g,'\\`') %>`;
if (savedCanvas) {
  const img = new Image();
  img.onload = () => { ctx.drawImage(img, 0, 0); saveState(); };
  img.src = savedCanvas;
} else {
  ctx.fillStyle = 'white'; ctx.fillRect(0,0,canvas.width,canvas.height); saveState();
}

function saveState() { undoStack.push(ctx.getImageData(0,0,canvas.width,canvas.height)); if(undoStack.length>25)undoStack.shift(); }
function undoDraw() { if(undoStack.length>1){undoStack.pop();ctx.putImageData(undoStack[undoStack.length-1],0,0);} }
function clearCanvas() { if(confirm('مسح الرسم كاملاً؟')){undoStack=[];ctx.fillStyle='white';ctx.fillRect(0,0,canvas.width,canvas.height);saveState();} }

function setTool(t, btn) { tool=t; document.querySelectorAll('.tool-btn').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); }
function updateColor() { penColor = document.getElementById('penColor').value; ctx.strokeStyle=penColor; }
function updateSize() { penSize=+document.getElementById('penSize').value; document.getElementById('penSizeVal').textContent=penSize; }

function getPos(e) {
  const r = canvas.getBoundingClientRect();
  const scaleX = canvas.width / r.width, scaleY = canvas.height / r.height;
  const clientX = e.touches ? e.touches[0].clientX : e.clientX;
  const clientY = e.touches ? e.touches[0].clientY : e.clientY;
  return { x:(clientX-r.left)*scaleX, y:(clientY-r.top)*scaleY };
}

canvas.addEventListener('mousedown', startDraw);
canvas.addEventListener('mousemove', draw);
canvas.addEventListener('mouseup', endDraw);
canvas.addEventListener('mouseleave', endDraw);
canvas.addEventListener('touchstart', e=>{e.preventDefault();startDraw(e);},{passive:false});
canvas.addEventListener('touchmove', e=>{e.preventDefault();draw(e);},{passive:false});
canvas.addEventListener('touchend', endDraw);

function startDraw(e) {
  isDrawing=true;
  const p=getPos(e); startX=p.x; startY=p.y;
  if(tool==='pencil'||tool==='eraser'){
    ctx.beginPath(); ctx.moveTo(startX,startY);
    ctx.strokeStyle = tool==='eraser'?'white':penColor;
    ctx.lineWidth = tool==='eraser'?penSize*4:penSize;
    ctx.lineCap='round'; ctx.lineJoin='round';
  }
  snapshot = ctx.getImageData(0,0,canvas.width,canvas.height);
}

function draw(e) {
  if(!isDrawing) return;
  const p=getPos(e);
  if(tool==='pencil'||tool==='eraser'){
    ctx.lineTo(p.x,p.y); ctx.stroke();
  } else {
    ctx.putImageData(snapshot,0,0);
    ctx.beginPath(); ctx.strokeStyle=penColor; ctx.lineWidth=penSize; ctx.lineCap='round';
    if(tool==='line'){ctx.moveTo(startX,startY);ctx.lineTo(p.x,p.y);ctx.stroke();}
    else if(tool==='rect'){ctx.strokeRect(startX,startY,p.x-startX,p.y-startY);}
    else if(tool==='circle'){
      const rx=(p.x-startX)/2, ry=(p.y-startY)/2;
      ctx.ellipse(startX+rx,startY+ry,Math.abs(rx),Math.abs(ry),0,0,2*Math.PI); ctx.stroke();
    }
  }
}

function endDraw() { if(isDrawing){isDrawing=false;saveState();} }

// ===== SAVE ALL =====
async function saveAll() {
  const sofa = {
    sofaType: document.getElementById('sofa_sofaType').value,
    seats: +document.getElementById('sofa_seats').value||0,
    foamType: document.getElementById('sofa_foamType').value,
    fabricType: document.getElementById('sofa_fabricType').value,
    color: document.getElementById('sofa_color').value,
    legType: document.getElementById('sofa_legType').value,
    cushionCount: +document.getElementById('sofa_cushionCount').value||0,
    styleImage: document.getElementById('sofa_styleImage').value,
    notes: document.getElementById('sofa_notes').value
  };
  const qaada = {
    sofaType: document.getElementById('qaada_sofaType').value,
    seats: +document.getElementById('qaada_seats').value||0,
    foamType: document.getElementById('qaada_foamType').value,
    fabricType: document.getElementById('qaada_fabricType').value,
    color: document.getElementById('qaada_color').value,
    legType: document.getElementById('qaada_legType').value,
    cushionCount: +document.getElementById('qaada_cushionCount').value||0,
    styleImage: document.getElementById('qaada_styleImage').value,
    notes: document.getElementById('qaada_notes').value
  };
  const canvasData = canvas.toDataURL('image/png');
  const payload = {
    sofa, qaada, rooms, windows, canvasData,
    generalNotes: document.getElementById('generalNotes').value,
    measurementDate: document.getElementById('measDate').value
  };
  try {
    const res = await fetch(`/admin/measurements/save/${CUST_ID}`, {
      method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)
    });
    const data = await res.json();
    if(data.ok) showToast('✓ تم حفظ المقاسات بنجاح');
    else showToast('خطأ في الحفظ: ' + data.error, 'err');
  } catch(e){ showToast('خطأ في الاتصال','err'); }
}

// Init
renderRooms();
renderWindows();
renderPhotos();
</script>

