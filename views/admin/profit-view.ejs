<%- include('../partials/admin-header') %>

<style>
  .profit-print-container { max-width: 100%; margin: 0 auto; background: #fff; border-radius: 12px; border: 1px solid var(--border-color, #e2e8f0); padding: 20px; }
  .pv-head { display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px; padding-bottom:12px; border-bottom:2px solid #0f172a; margin-bottom:14px; }
  .pv-title { font-size:18px; font-weight:900; color:#0f172a; }
  .pv-info { font-size:12px; color:#334155; line-height:1.8; }
  .pv-info strong { color:#0f172a; }
  table.pv-table { width:100%; border-collapse:collapse; font-size:13px; margin-bottom:14px; }
  table.pv-table thead th { background:#0f172a; color:#fff; padding:8px; text-align:center; }
  table.pv-table thead th.desc-col { text-align:right; }
  table.pv-table tbody td { padding:8px; border-bottom:1px solid #e2e8f0; text-align:center; }
  table.pv-table tbody td.desc-col { text-align:right; font-weight:700; }
  table.pv-table tbody tr:nth-child(even) { background:#f8fafc; }
  .pv-totals { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-top:12px; }
  .pv-tot-box { background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:14px; text-align:center; }
  .pv-tot-box .lbl { font-size:11px; color:#64748b; }
  .pv-tot-box .val { font-size:20px; font-weight:900; color:#0f172a; }
</style>

<div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
  <h2 class="section-title mb-0" style="font-size:18px;">
    <i class="fa-solid fa-sack-dollar"></i>
    أرباح فاتورة: <span style="color:#b8860b;"><%= profit.invoiceNumber %></span>
  </h2>
  <div class="d-flex gap-2 flex-wrap">
    <a href="/admin/profits/print/<%= profit._id %>" target="_blank" class="btn btn-primary btn-sm">
      <i class="fa-solid fa-print"></i> طباعة التقرير
    </a>
    <a href="/admin/profits/edit/<%= profit._id %>" class="btn btn-warning btn-sm">
      <i class="fa-solid fa-pen"></i> تعديل
    </a>
    <form action="/admin/profits/delete/<%= profit._id %>" method="POST" style="display:inline;"
          onsubmit="return confirm('هل أنت متأكد من حذف سجل الأرباح؟\nلن تتأثر الفاتورة الأصلية.')">
      <button type="submit" class="btn btn-danger btn-sm">
        <i class="fa-solid fa-trash"></i> حذف
      </button>
    </form>
    <a href="/admin/profits" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-arrow-right"></i> رجوع
    </a>
  </div>
</div>

<div class="profit-print-container">
  <div class="pv-head">
    <div>
      <div class="pv-title">تقرير أرباح داخلي</div>
      <div class="pv-info">خاص بالمدير فقط — <%= settings.storeName %></div>
    </div>
    <div class="pv-info" style="text-align:left;">
      <strong>رقم الفاتورة:</strong> <%= profit.invoiceNumber %><br>
      <strong>العميل:</strong> <%= profit.partyName %><br>
      <strong>التاريخ:</strong> <%= new Date(profit.invoiceDate).toLocaleDateString('ar-EG') %>
    </div>
  </div>

  <table class="pv-table">
    <thead>
      <tr>
        <th class="desc-col">الصنف</th>
        <th>الكمية</th>
        <th>سعر البيع</th>
        <th>إجمالي البيع</th>
        <th>تكلفة الوحدة</th>
        <th>إجمالي التكلفة</th>
        <th>الربح</th>
      </tr>
    </thead>
    <tbody>
      <% profit.items.forEach(it => { %>
        <tr>
          <td class="desc-col"><%= it.description %></td>
          <td>
            <% if(it.quantityType === 'sqmeter') { %>
              <%= it.length %>×<%= it.width %> = <%= it.quantity.toFixed(2) %> م²
            <% } else if(it.quantityType === 'meter') { %>
              <%= it.quantity.toFixed(2) %> م
            <% } else { %>
              <%= it.quantity %>
            <% } %>
          </td>
          <td><%= it.unitPrice.toLocaleString('ar-EG') %> ₪</td>
          <td class="fw-bold text-danger"><%= it.total.toLocaleString('ar-EG') %> ₪</td>
          <td><%= it.unitCost.toLocaleString('ar-EG') %> ₪</td>
          <td style="color:#d97706;font-weight:700;"><%= it.totalCost.toLocaleString('ar-EG') %> ₪</td>
          <td style="color:<%= it.itemProfit >= 0 ? '#16a34a' : '#dc2626' %>;font-weight:800;"><%= it.itemProfit.toLocaleString('ar-EG') %> ₪</td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="pv-totals">
    <div class="pv-tot-box"><div class="lbl">إجمالي البيع</div><div class="val" style="color:#dc2626;"><%= profit.totalSale.toLocaleString('ar-EG') %> ₪</div></div>
    <div class="pv-tot-box"><div class="lbl">إجمالي التكلفة</div><div class="val" style="color:#d97706;"><%= profit.totalCost.toLocaleString('ar-EG') %> ₪</div></div>
    <div class="pv-tot-box"><div class="lbl">صافي الربح</div><div class="val" style="color:<%= profit.netProfit >= 0 ? '#16a34a' : '#dc2626' %>;"><%= profit.netProfit.toLocaleString('ar-EG') %> ₪</div></div>
    <div class="pv-tot-box"><div class="lbl">نسبة الربح</div><div class="val" style="color:#3b82f6;"><%= profit.profitMargin.toFixed(1) %>%</div></div>
  </div>

  <% if (profit.notes) { %>
    <div class="mt-3" style="font-size:13px; color:#334155;">
      <strong>ملاحظات:</strong> <%= profit.notes %>
    </div>
  <% } %>
</div>

<%- include('../partials/admin-footer') %>
